            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # $HOME must expand inside the sandboxed shell.
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'cat "$HOME/.pi/providers/catalog.txt" "$HOME/.pi/models/catalog.txt" >/dev/null || exit 1; if printf bad > "$HOME/.pi/providers/catalog.txt" 2>/dev/null; then printf PROVIDER_WRITE_ALLOWED; else printf PROVIDER_CONFIG_RO; fi; if printf bad > "$HOME/.pi/models/catalog.txt" 2>/dev/null; then printf MODEL_WRITE_ALLOWED; else printf MODEL_CONFIG_RO; fi' 2>&1 || true)"
        if [[ "${output}" == *PROVIDER_CONFIG_RO* ]] && [[ "${output}" == *MODEL_CONFIG_RO* ]] &&
            [[ "${output}" != *PROVIDER_WRITE_ALLOWED* ]] && [[ "${output}" != *MODEL_WRITE_ALLOWED* ]] &&
