        # shellcheck disable=SC2016 # $HOME must expand inside the sandboxed shell.
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'cat "$HOME/.pi/agent/settings.json" "$HOME/.pi/agent/trust.json" >/dev/null || exit 1; mkdir "$HOME/.pi/agent/settings.json.lock" "$HOME/.pi/agent/trust.json.lock" || exit 1; printf "{\"theme\":\"updated\"}\n" > "$HOME/.pi/agent/settings.json" || exit 1; printf "{\"trusted\":true}\n" > "$HOME/.pi/agent/trust.json" || exit 1; rmdir "$HOME/.pi/agent/settings.json.lock" "$HOME/.pi/agent/trust.json.lock" || exit 1; printf PI_AGENT_ROOT_LOCK_OK' 2>&1 || true)"
        if [[ "${output}" == 'PI_AGENT_ROOT_LOCK_OK' ]] &&
            [[ "$(<"${test_home}/.pi/agent/settings.json")" == '{"theme":"updated"}' ]] &&
            [[ "$(<"${test_home}/.pi/agent/trust.json")" == '{"trusted":true}' ]]; then
            validation_pass 'Test E.9 PASS: Pi root-agent lock dirs and startup JSON are writable'
