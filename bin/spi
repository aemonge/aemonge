trap cleanup_file_mode_tmp_dir EXIT

# Pi writable runtime/state is intentionally narrow. Existing ~/.pi is mounted
# read-only first, then ~/.pi/agent is replaced by disposable tmpfs so Pi can
# mkdir direct startup lock dirs such as settings.json.lock/trust.json.lock.
# Known child state trees are precreated and persist through explicit writable
# binds. Agent resources and root configuration JSON are restored read-only so
# they can be changed only when ~/.pi itself is the selected writable target.
PI_AGENT_STATE_SUBDIRS=(
    tasks
    status
    todos
    plans
    jobs
    runs
    ui
    statusline
    sessions
    auth
    trust
    models
    metadata
    cache
    git
    npm
    projects
    workspaces
    providers
    state
)
# TODO(spi-plugin-integrity): validate Pi extensions/packages before startup,
# including symlink containment, manifests, entry points, and a private fingerprint cache.
PI_AGENT_RO_PATHS=(
    extensions
    packages
    prompts
    skills
    themes
    keybindings.json
)
PI_AGENT_ROOT_CONFIG_FILES=(
    settings.json
    trust.json
    auth.json
    models-store.json
)

while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--" && "${SPI_PARSE_MODE}" -eq 0 ]]; then
        SPI_PARSE_MODE=1
        shift
        continue
    fi
    if [[ "${SPI_PARSE_MODE}" -eq 0 ]]; then
        PI_ARGS+=("$1")
    else
        SPI_ARGS+=("$1")
    fi
    shift
done

set -- "${SPI_ARGS[@]}"
while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    -V | --version)
        version
        exit 0
        ;;
    -a | --add)
        if [[ $# -lt 2 ]]; then error "missing argument for $1"; exit 1; fi
        ADD_RO_PATHS+=("$2")
        shift 2
        ;;
    -A | --add-rw)
        if [[ $# -lt 2 ]]; then error "missing argument for $1"; exit 1; fi
        ADD_RW_PATHS+=("$2")
        shift 2
        ;;
    -b | --bin)
        if [[ $# -lt 2 ]]; then error "missing argument for $1"; exit 1; fi
        PI_BIN="$2"
        shift 2
        ;;
    -q | --quiet)
        QUIET=1
        shift
        ;;
    -v | --verbose)
        VERBOSE=1
        shift
        ;;
    --backend)
        if [[ $# -lt 2 ]]; then error "missing argument for --backend"; exit 1; fi
        if [[ "$2" != "bwrap" ]]; then error "spi supports only the bwrap backend"; exit 1; fi
        shift 2
        ;;
    --backend=bwrap)
        shift
        ;;
    --backend=*)
        error "spi supports only the bwrap backend"
        exit 1
        ;;
    --doctor | --docotr)
        DOCTOR_MODE=1
        shift
        ;;
    --validate)
        VALIDATE_MODE=1
        shift
        ;;
    --ro)
        RO_SET=1
        FS_MODE="ro"
        shift
        ;;
    --rw)
        RW_SET=1
        FS_MODE="rw"
        shift
        ;;
    --allow-git)
        ALLOW_GIT=1
        shift
        ;;
    --allow-infra)
        ALLOW_INFRA=1
        shift
        ;;
    --allow-pi-config)
        ALLOW_PI_CONFIG=1
        shift
        ;;
    --allow-host-tools)
        ALLOW_HOST_TOOLS=1
        ALLOW_HOST_TOOLS_SET=1
        shift
        ;;
    --no-host-tools)
        ALLOW_HOST_TOOLS=0
        ALLOW_HOST_TOOLS_DISABLE_SET=1
        shift
        ;;
    --no-nvim-remote)
        ALLOW_NVIM_REMOTE=0
        shift
        ;;
    -g | --allow-gui)
        ALLOW_GUI=1
        shift
        ;;
    -s | --no-ssh-agent)
        FORWARD_SSH_AGENT=0
        shift
        ;;
    -w | --web-developer)
        WEB_DEVELOPER_MODE=1
        ALLOW_GUI=1
        shift
        ;;
    --full-dev)
        RESTRICT_DEV=0
        shift
        ;;
    -x | --exec)
        shift
        if [[ $# -eq 0 ]]; then error "missing command for -x/--exec"; exit 1; fi
        RAW_COMMAND=("$@")
        break
        ;;
    -*)
        error "unknown option: $1"
        echo "Try '${PROGRAM_NAME} --help' for more information." >&2
        exit 1
        ;;
    *)
        if [[ -z "${PROJECT_TARGET}" ]]; then
            PROJECT_TARGET="$1"
        else
            error "unexpected spi argument after target: $1"
            exit 1
        fi
        shift
        ;;
    esac
done

if [[ "${VALIDATE_MODE}" -eq 1 ]]; then
    run_validation
    exit $?
fi
if [[ "${DOCTOR_MODE}" -eq 1 ]]; then
    run_doctor
    exit $?
fi

if [[ "${RO_SET}" -eq 1 && "${RW_SET}" -eq 1 ]]; then
    error "--ro and --rw are mutually exclusive"
    exit 1
fi
if [[ "${ALLOW_HOST_TOOLS_SET}" -eq 1 && "${ALLOW_HOST_TOOLS_DISABLE_SET}" -eq 1 ]]; then
    error "--allow-host-tools and --no-host-tools are mutually exclusive"
    exit 1
fi
if [[ "${FS_MODE}" != "ro" && "${FS_MODE}" != "rw" ]]; then
    error "invalid FS mode '${FS_MODE}' (expected 'ro' or 'rw')"
    exit 1
fi
if [[ -z "${PROJECT_TARGET}" ]]; then
    PROJECT_TARGET="${PWD}"
fi

if [[ "$(uname -s 2>/dev/null || printf unknown)" != "Linux" ]]; then
    error "Bubblewrap requires Linux"
    exit 1
fi
if ! command -v bwrap >/dev/null 2>&1; then
    error "bubblewrap (bwrap) not found in PATH"
    error "install bubblewrap before running spi"
    exit 1
fi

SPI_CACHE_BWRAP_PATH="$(command -v bwrap)"
SPI_CACHE_BWRAP_VERSION="$(bwrap --version 2>/dev/null || printf unknown)"
if ! is_discovery_cache_current "${SPI_CACHE_BWRAP_PATH}" "${SPI_CACHE_BWRAP_VERSION}"; then
    SPI_CACHE_BWRAP_DISABLE_USERNS_SUPPORTED=""
    SPI_CACHE_BWRAP_NAMESPACE_SUPPORT=""
    SPI_CACHE_REAL_GIT_HOST=""
    SPI_CACHE_REAL_GIT_REALPATH=""
    SPI_CACHE_SCODER_GIT_HOST=""
    SPI_CACHE_SCODER_GIT_REALPATH=""
fi
if is_discovery_cache_current "${SPI_CACHE_BWRAP_PATH}" "${SPI_CACHE_BWRAP_VERSION}" &&
    [[ -n "${SPI_CACHE_BWRAP_DISABLE_USERNS_SUPPORTED:-}" ]]; then
    BWRAP_DISABLE_USERNS_SUPPORTED="${SPI_CACHE_BWRAP_DISABLE_USERNS_SUPPORTED}"
    trace_startup "bwrap capability cache hit"
else
    BWRAP_DISABLE_USERNS_SUPPORTED=0
    if bwrap --help 2>/dev/null | grep -q -- "--disable-userns"; then
        BWRAP_DISABLE_USERNS_SUPPORTED=1
    fi
    SPI_CACHE_BWRAP_DISABLE_USERNS_SUPPORTED="${BWRAP_DISABLE_USERNS_SUPPORTED}"
    write_discovery_cache
    trace_startup "bwrap capabilities discovered"
fi

if is_discovery_cache_current "${SPI_CACHE_BWRAP_PATH}" "${SPI_CACHE_BWRAP_VERSION}" &&
    [[ "${SPI_CACHE_BWRAP_NAMESPACE_SUPPORT:-}" == "ok" ]]; then
    trace_startup "bwrap namespace probe cache hit"
else
    check_bwrap_namespace_support || exit 1
    if [[ "${SPI_FORCE_PROBE:-0}" != "1" ]]; then
        SPI_CACHE_BWRAP_NAMESPACE_SUPPORT=ok
        write_discovery_cache
    fi
    trace_startup "bwrap namespace probe completed"
fi

discover_pi_binary
discover_git_wrapper
trace_startup "tool discovery completed"

if [[ "${WEB_DEVELOPER_MODE}" -eq 1 ]]; then
    ensure_chromium_devtools || exit 1
fi
if [[ "${FORWARD_SSH_AGENT}" -eq 1 && -n "${SSH_AUTH_SOCK:-}" && ! -S "${SSH_AUTH_SOCK}" ]]; then
    error "SSH_AUTH_SOCK is not a socket: ${SSH_AUTH_SOCK}"
    exit 1
fi

resolve_target_mode "${PROJECT_TARGET}"
if [[ "${TARGET_KIND}" == "dir" && "${TARGET_SOURCE_PATH}" == "/" && "${FS_MODE}" != "ro" ]]; then
    error "refusing to mount the host root writable; use --ro or select a narrower target"
    exit 1
fi
INVOCATION_CWD="$(realpath "${PWD}")"
if [[ "${TARGET_KIND}" == "dir" ]]; then
    if [[ "${TARGET_PATH}" != "${TARGET_SOURCE_PATH}" ]]; then
        PROJECT_DIR="${TARGET_SOURCE_PATH}"
        PROJECT_ALIAS_DIR="${TARGET_PATH}"
    else
        PROJECT_DIR="${TARGET_PATH}"
    fi
    PROJECT_SOURCE_DIR="${TARGET_SOURCE_PATH}"
    SANDBOX_PROJECT_ROOT="${PROJECT_DIR}"
    SANDBOX_WORKDIR="${PROJECT_DIR}"
else
    PROJECT_DIR="${TARGET_PARENT_DIR}"
    PROJECT_SOURCE_DIR="${TARGET_SOURCE_PARENT_DIR}"
    SANDBOX_PROJECT_ROOT="${PROJECT_DIR}"
    SANDBOX_WORKDIR="${INVOCATION_CWD}"
fi

SANDBOX_HOME="${HOST_HOME}"
SANDBOX_LOCAL_DIR="${SANDBOX_HOME}/.local"
SANDBOX_LOCAL_SHARE_DIR="${SANDBOX_LOCAL_DIR}/share"
SANDBOX_LOCAL_STATE_DIR="${SANDBOX_LOCAL_DIR}/state"
SANDBOX_CONFIG_DIR="${SANDBOX_HOME}/.config"
SANDBOX_CACHE_DIR="${SANDBOX_HOME}/.cache"
SANDBOX_BUN_HOME="${SANDBOX_HOME}/.bun"
SANDBOX_PNPM_HOME="${SANDBOX_LOCAL_SHARE_DIR}/pnpm"
SANDBOX_PLAYWRIGHT_BROWSERS_CACHE="${SANDBOX_CACHE_DIR}/ms-playwright"
SANDBOX_EDITOR="v_quickedit_hover"
NVIM_EDITOR_SCRIPT="${HOST_HOME}/.config/nvim/scripts/opencode-editor"
SANDBOX_NVIM_EDITOR="${SANDBOX_HOME}/.config/nvim/scripts/opencode-editor"
SPI_TMPDIR="/tmp/spi-$$"

map_host_path_to_sandbox "${PI_AGENT_DIR}"
SANDBOX_PI_AGENT_DIR="${REPLY}"

if [[ "${TARGET_KIND}" == "file" || "${FS_MODE}" == "ro" ]]; then
    PROJECT_BIND_FLAG="--ro-bind"
    PROJECT_TOOL_BIND_FLAG="--ro-bind"
else
    PROJECT_BIND_FLAG="--bind"
    PROJECT_TOOL_BIND_FLAG="--bind"
fi

SANDBOX_PATH="/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/bin/site_perl"
SANDBOX_PATH="${SANDBOX_BUN_HOME}/bin:${SANDBOX_PNPM_HOME}:${SANDBOX_PNPM_HOME}/bin:${SANDBOX_PATH}"

if [[ "${ALLOW_HOST_TOOLS}" -eq 1 ]]; then
    info "Binding host development tools"
    if [[ -d "${HOST_HOME}/.local/bin" ]]; then
        resolve_bind_source_path "${HOST_HOME}/.local/bin"
        EXTRA_BINDS+=(--ro-bind "${REPLY}" "${SANDBOX_HOME}/.local/bin")
        SANDBOX_PATH="${SANDBOX_HOME}/.local/bin:${SANDBOX_PATH}"
    fi

    HOST_RUNTIME_BIND_SUBPATHS=(
        ".local/share/uv" ".cache/uv" ".npm" ".cache/npm" ".cache/node"
        ".local/share/pnpm" ".cache/pnpm" ".krimto" ".cache/yarn"
        ".cache/pip" ".cache/pipx" ".local/pipx" ".cache/sccache"
        ".cache/go-build" ".hex" ".mix" ".cache/rebar3" ".cache/gleam"
        ".local/share/gleam" ".deno" ".gradle" ".m2/repository"
        ".nuget/packages" ".gem" ".bundle" ".cache/bundle"
        ".composer" ".cache/composer" ".bun" ".cache/bun" ".cache/ms-playwright"
    )
    for runtime_subpath in "${HOST_RUNTIME_BIND_SUBPATHS[@]}"; do
        bind_runtime_dir "${HOST_HOME}/${runtime_subpath}" "${SANDBOX_HOME}/${runtime_subpath}"
    done

    if [[ -d "${HOST_HOME}/.pyenv" ]]; then
        opt_ro_bind_dir "${HOST_HOME}/.pyenv" "${SANDBOX_HOME}/.pyenv"
        SANDBOX_PATH="${SANDBOX_HOME}/.pyenv/shims:${SANDBOX_HOME}/.pyenv/bin:${SANDBOX_PATH}"
        PYENV_ROOT_SANDBOX="${SANDBOX_HOME}/.pyenv"
    fi

    select_host_tool_home "${RUSTUP_HOME:-}" "${HOST_HOME}/.local/share/rustup" "${HOST_HOME}/.rustup"
    HOST_RUSTUP_HOME="${REPLY}"
    if [[ -d "${HOST_RUSTUP_HOME}" ]]; then
        map_host_path_to_sandbox "${HOST_RUSTUP_HOME}"
        RUSTUP_HOME_SANDBOX="${REPLY}"
        opt_ro_bind_dir "${HOST_RUSTUP_HOME}" "${RUSTUP_HOME_SANDBOX}"
    fi

    select_host_tool_home "${CARGO_HOME:-}" "${HOST_HOME}/.local/share/cargo" "${HOST_HOME}/.cargo"
    HOST_CARGO_HOME="${REPLY}"
    map_host_path_to_sandbox "${HOST_CARGO_HOME}"
    CARGO_HOME_SANDBOX="${REPLY}"
    bind_runtime_dir "${HOST_CARGO_HOME}" "${CARGO_HOME_SANDBOX}"
    SANDBOX_PATH="${CARGO_HOME_SANDBOX}/bin:${SANDBOX_PATH}"

    select_host_tool_home "${GOPATH:-}" "${HOST_HOME}/.local/share/go" "${HOST_HOME}/go"
    HOST_GOPATH="${REPLY}"
    map_host_path_to_sandbox "${HOST_GOPATH}"
    GOPATH_SANDBOX="${REPLY}"
    bind_runtime_dir "${HOST_GOPATH}" "${GOPATH_SANDBOX}"
    SANDBOX_PATH="${GOPATH_SANDBOX}/bin:${SANDBOX_PATH}"
    if [[ -n "${GOBIN:-}" ]]; then
        map_host_path_to_sandbox "${GOBIN}"
        GOBIN_SANDBOX="${REPLY}"
        SANDBOX_PATH="${GOBIN_SANDBOX}:${SANDBOX_PATH}"
    fi
fi
trace_startup "host development tool binds prepared"

if [[ "${ALLOW_PI_CONFIG}" -eq 1 ]]; then
    bind_runtime_dir "${HOST_HOME}/.pi" "${SANDBOX_HOME}/.pi"
else
    opt_ro_bind_dir "${HOST_HOME}/.pi" "${SANDBOX_HOME}/.pi"
    bind_pi_agent_tmpfs_root
    for state_subdir in "${PI_AGENT_STATE_SUBDIRS[@]}"; do
        bind_prepared_runtime_dir "${PI_AGENT_DIR}/${state_subdir}" "${SANDBOX_PI_AGENT_DIR}/${state_subdir}"
    done
    bind_pi_agent_resource_paths
fi
bind_pi_xdg_resources
bind_nearest_project_openspec
bind_footer_xdg_resources
opt_ro_bind_global_skills

opt_ro_bind_path "${HOST_HOME}/.gitconfig" "${SANDBOX_HOME}/.gitconfig"
opt_ro_bind_path "${HOST_HOME}/.config/git/config" "${SANDBOX_HOME}/.config/git/config"
if [[ "${ALLOW_NVIM_REMOTE}" -eq 1 && -f "${NVIM_EDITOR_SCRIPT}" ]]; then
    opt_ro_bind_path "${NVIM_EDITOR_SCRIPT}" "${SANDBOX_NVIM_EDITOR}"
    SANDBOX_EDITOR="${SANDBOX_NVIM_EDITOR}"
    info "Neovim integration: using ${SANDBOX_NVIM_EDITOR} for EDITOR/VISUAL"
fi
RESOLV_CONF_TARGET="$(readlink -f /etc/resolv.conf 2>/dev/null || true)"
if [[ -n "${RESOLV_CONF_TARGET}" && "${RESOLV_CONF_TARGET}" != "/etc/resolv.conf" && -f "${RESOLV_CONF_TARGET}" ]]; then
    opt_ro_bind_path "${RESOLV_CONF_TARGET}" "${RESOLV_CONF_TARGET}"
fi
opt_ro_bind_path /run/systemd/resolve /run/systemd/resolve
opt_ro_bind_path /run/dbus /run/dbus
opt_ro_bind_path /run/NetworkManager /run/NetworkManager
opt_ro_bind_path /var/run/nscd /var/run/nscd
bind_terminal_integration
bind_pi_socket_envs

if [[ "${ALLOW_GUI}" -eq 1 ]]; then
    info "Allowing GUI/session access"
    [[ -d /tmp/.X11-unix ]] && opt_ro_bind_dir /tmp/.X11-unix /tmp/.X11-unix
    if [[ -n "${XAUTHORITY:-}" && -e "${XAUTHORITY}" ]]; then
        opt_ro_bind_path "${XAUTHORITY}" "${XAUTHORITY}"
    elif [[ -f "${HOST_HOME}/.Xauthority" ]]; then
        opt_ro_bind_path "${HOST_HOME}/.Xauthority" "${SANDBOX_HOME}/.Xauthority"
    fi
    if [[ -n "${XDG_RUNTIME_DIR:-}" && -d "${XDG_RUNTIME_DIR}" ]]; then
        bind_runtime_dir "${XDG_RUNTIME_DIR}" "${XDG_RUNTIME_DIR}"
    fi
fi

if [[ "${FORWARD_SSH_AGENT}" -eq 1 && -n "${SSH_AUTH_SOCK:-}" ]]; then
    bind_runtime_path_precreated "${SSH_AUTH_SOCK}" "${SSH_AUTH_SOCK}"
    add_sandbox_env_once SSH_AUTH_SOCK "${SSH_AUTH_SOCK}"
    info "Forwarding SSH agent socket: ${SSH_AUTH_SOCK}"
fi

if [[ -d "${PROJECT_SOURCE_DIR}/.cargo/bin" ]]; then
    EXTRA_BINDS+=("${PROJECT_TOOL_BIND_FLAG}" "${PROJECT_SOURCE_DIR}/.cargo/bin" "${SANDBOX_HOME}/.cargo/bin")
    SANDBOX_PATH="${SANDBOX_HOME}/.cargo/bin:${SANDBOX_PATH}"
fi
if [[ -d "${PROJECT_SOURCE_DIR}/.venv/bin" ]]; then
    EXTRA_BINDS+=("${PROJECT_TOOL_BIND_FLAG}" "${PROJECT_SOURCE_DIR}/.venv/bin" "${SANDBOX_PROJECT_ROOT}/.venv/bin")
    SANDBOX_PATH="${SANDBOX_PROJECT_ROOT}/.venv/bin:${SANDBOX_PATH}"
fi
if [[ -d "${PROJECT_SOURCE_DIR}/node_modules/.bin" ]]; then
    EXTRA_BINDS+=("${PROJECT_TOOL_BIND_FLAG}" "${PROJECT_SOURCE_DIR}/node_modules/.bin" "${SANDBOX_PROJECT_ROOT}/node_modules/.bin")
    SANDBOX_PATH="${SANDBOX_PROJECT_ROOT}/node_modules/.bin:${SANDBOX_PATH}"
fi
if [[ -d "${PROJECT_SOURCE_DIR}/bin" && -f "${PROJECT_SOURCE_DIR}/go.mod" ]]; then
    EXTRA_BINDS+=("${PROJECT_TOOL_BIND_FLAG}" "${PROJECT_SOURCE_DIR}/bin" "${SANDBOX_PROJECT_ROOT}/bin")
    SANDBOX_PATH="${SANDBOX_PROJECT_ROOT}/bin:${SANDBOX_PATH}"
fi
trace_startup "runtime, GUI, SSH, and project tool binds prepared"

if [[ "${TARGET_KIND}" == "file" ]] && ! is_path_within "${PROJECT_SOURCE_DIR}" "${INVOCATION_CWD}"; then
    EXTRA_BINDS+=(--ro-bind "${INVOCATION_CWD}" "${INVOCATION_CWD}")
fi
if [[ -n "${PROJECT_ALIAS_DIR}" ]]; then
    add_prepared_bind_once "${PROJECT_BIND_FLAG}" "${PROJECT_SOURCE_DIR}" "${PROJECT_ALIAS_DIR}"
fi

# Match scoder's effective target-root policy: Git metadata stays writable by
# default, while critical build/repository infrastructure is protected unless
# --allow-infra is explicit.
PROTECTED_INFRA_DIRS=(
    ".git"
    ".github"
    ".turbo"
    ".cargo"
)
PROTECTED_INFRA_FILES=(
    ".gitignore"
    "package-lock.json"
    "poetry.lock"
    "Cargo.lock"
    "pnpm-lock.yaml"
    "yarn.lock"
)

if [[ "${ALLOW_INFRA}" -eq 0 ]]; then
    for infra_dir in "${PROTECTED_INFRA_DIRS[@]}"; do
        if [[ "${infra_dir}" == ".git" && "${ALLOW_GIT}" -eq 1 ]]; then
            continue
        fi
        if [[ -d "${PROJECT_SOURCE_DIR}/${infra_dir}" ]]; then
            SAFE_BINDS+=(--ro-bind "${PROJECT_SOURCE_DIR}/${infra_dir}" "${SANDBOX_PROJECT_ROOT}/${infra_dir}")
            if [[ -n "${PROJECT_ALIAS_DIR}" ]]; then
                SAFE_BINDS+=(--ro-bind "${PROJECT_SOURCE_DIR}/${infra_dir}" "${PROJECT_ALIAS_DIR}/${infra_dir}")
            fi
            info "Protecting ${infra_dir}/ (read-only)"
        fi
    done
    for infra_file in "${PROTECTED_INFRA_FILES[@]}"; do
        if [[ -f "${PROJECT_SOURCE_DIR}/${infra_file}" ]]; then
            SAFE_BINDS+=(--ro-bind "${PROJECT_SOURCE_DIR}/${infra_file}" "${SANDBOX_PROJECT_ROOT}/${infra_file}")
            if [[ -n "${PROJECT_ALIAS_DIR}" ]]; then
                SAFE_BINDS+=(--ro-bind "${PROJECT_SOURCE_DIR}/${infra_file}" "${PROJECT_ALIAS_DIR}/${infra_file}")
            fi
            info "Protecting ${infra_file} (read-only)"
        fi
    done
fi

for added_path in "${ADD_RO_PATHS[@]}"; do
    add_custom_bind --ro-bind "${added_path}"
done
for added_path in "${ADD_RW_PATHS[@]}"; do
    add_custom_bind --bind "${added_path}"
done

BWRAP_CMD=(
    bwrap
    --ro-bind /usr /usr
    --ro-bind /bin /bin
    --ro-bind /lib /lib
)

if [[ "${BWRAP_DISABLE_USERNS_SUPPORTED}" -eq 1 ]]; then
    BWRAP_CMD=(bwrap --unshare-user "${BWRAP_CMD[@]:1}")
    BWRAP_CMD+=(--disable-userns)
else
    BWRAP_CMD=(bwrap --unshare-user-try "${BWRAP_CMD[@]:1}")
fi

[[ -d /lib64 ]] && BWRAP_CMD+=(--ro-bind /lib64 /lib64)
[[ -d /sys ]] && BWRAP_CMD+=(--ro-bind /sys /sys)
BWRAP_CMD+=(--ro-bind /etc /etc)
BWRAP_CMD+=(
    --ro-bind "${REAL_GIT_HOST}" /spi/real-git
    --ro-bind "${SCODER_GIT_HOST}" /usr/bin/git
)

if [[ "${RESTRICT_DEV}" -eq 1 ]]; then
    BWRAP_CMD+=(
        --dev-bind /dev/null /dev/null
        --dev-bind /dev/zero /dev/zero
        --dev-bind /dev/random /dev/random
        --dev-bind /dev/urandom /dev/urandom
        --dev-bind /dev/tty /dev/tty
        --tmpfs /dev/shm
    )
else
    BWRAP_CMD+=(--dev /dev)
fi

BWRAP_CMD+=(
    --proc /proc
    --tmpfs /tmp
    --dir "${SPI_TMPDIR}"
    --chmod 0700 "${SPI_TMPDIR}"
    --tmpfs /home
    --dir "${SANDBOX_HOME}"
    --dir "${SANDBOX_LOCAL_DIR}"
    --dir "${SANDBOX_LOCAL_SHARE_DIR}"
    --dir "${SANDBOX_LOCAL_STATE_DIR}"
    --dir "${SANDBOX_CONFIG_DIR}"
    --dir "${SANDBOX_CACHE_DIR}"
)
BWRAP_CMD+=("${EXTRA_DIRS[@]}")
if [[ "${SANDBOX_PROJECT_ROOT}" != "/" ]]; then
    BWRAP_CMD+=(--dir "$(dirname "${SANDBOX_PROJECT_ROOT}")")
    BWRAP_CMD+=(--dir "${SANDBOX_PROJECT_ROOT}")
fi
BWRAP_CMD+=("${EXTRA_BINDS[@]}")
BWRAP_CMD+=("${PROJECT_BIND_FLAG}" "${PROJECT_SOURCE_DIR}" "${SANDBOX_PROJECT_ROOT}")
if [[ "${TARGET_KIND}" == "file" && "${FS_MODE}" != "ro" ]]; then
    prepare_single_file_overlay
    BWRAP_CMD+=("${FILE_MODE_BINDS[@]}")
fi
BWRAP_CMD+=("${SAFE_BINDS[@]}")

BWRAP_CMD+=(
    --chdir "${SANDBOX_WORKDIR}"
    --die-with-parent
    --clearenv
)
inherit_safe_environment
preserve_pi_session_environment
BWRAP_CMD+=("${SANDBOX_ENVS[@]}")
BWRAP_CMD+=(
    --setenv PATH "${SANDBOX_PATH}"
    --setenv HOME "${SANDBOX_HOME}"
    --setenv USER "${HOST_USER}"
    --setenv LOGNAME "${HOST_LOGNAME}"
    --setenv TERM "${TERM:-xterm-256color}"
    --setenv COLORTERM "${COLORTERM:-truecolor}"
    --setenv LANG "${LANG:-C.UTF-8}"
    --setenv LC_ALL "${LC_ALL:-C.UTF-8}"
    --setenv EDITOR "${SANDBOX_EDITOR}"
    --setenv VISUAL "${SANDBOX_EDITOR}"
    --setenv SHELL "${SHELL:-/bin/bash}"
    --setenv GIT_OPTIONAL_LOCKS 0
    --setenv SCODER_REAL_GIT /spi/real-git
    --setenv TMPDIR "${SPI_TMPDIR}"
    --setenv PNPM_HOME "${SANDBOX_PNPM_HOME}"
    --setenv PLAYWRIGHT_BROWSERS_PATH "${SANDBOX_PLAYWRIGHT_BROWSERS_CACHE}"
    --setenv MISE_SKIP_ACTIVATE 1
    --setenv UV_LINK_MODE copy
    --setenv OPENSPEC_TELEMETRY 0
)

[[ -n "${PYENV_ROOT_SANDBOX:-}" ]] && BWRAP_CMD+=(--setenv PYENV_ROOT "${PYENV_ROOT_SANDBOX}")
[[ -n "${RUSTUP_HOME_SANDBOX:-}" ]] && BWRAP_CMD+=(--setenv RUSTUP_HOME "${RUSTUP_HOME_SANDBOX}")
[[ -n "${CARGO_HOME_SANDBOX:-}" ]] && BWRAP_CMD+=(--setenv CARGO_HOME "${CARGO_HOME_SANDBOX}")
[[ -n "${GOPATH_SANDBOX:-}" ]] && BWRAP_CMD+=(--setenv GOPATH "${GOPATH_SANDBOX}")
[[ -n "${GOBIN_SANDBOX:-}" ]] && BWRAP_CMD+=(--setenv GOBIN "${GOBIN_SANDBOX}")
if [[ -n "${PYO3_PYTHON:-}" ]]; then
    BWRAP_CMD+=(--setenv PYO3_PYTHON "${SANDBOX_WORKDIR}/.venv/bin/python")
fi

# Always pin Pi to the config tree that spi mounted. Relying on Pi's homedir()
# fallback inside a user namespace can resolve a different home than $HOME,
# causing settings, packages, extensions, and themes to disappear silently.
BWRAP_CMD+=(--setenv PI_CODING_AGENT_DIR "${SANDBOX_PI_AGENT_DIR}")

if [[ ${#RAW_COMMAND[@]} -gt 0 ]]; then
    BWRAP_CMD+=("${RAW_COMMAND[@]}")
else
    BWRAP_CMD+=("${PI_BIN_SANDBOX}" "${PI_ARGS[@]}")
fi

trace_startup "bwrap command built"
info "Launching spi Bubblewrap sandbox..."
if [[ "${TARGET_KIND}" == "file" && "${FS_MODE}" != "ro" ]]; then
    set +e
    "${BWRAP_CMD[@]}"
    BWRAP_STATUS=$?
    set -e
    if [[ "${BWRAP_STATUS}" -eq 0 ]]; then
        sync_single_file_target_back || exit 1
    fi
    exit "${BWRAP_STATUS}"
fi
exec "${BWRAP_CMD[@]}"
