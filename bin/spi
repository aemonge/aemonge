        if [[ "${output}" == 'PI_XDG_STATE_OK' ]] && [[ "$(<"${test_home}/.local/state/pi/status")" == 'state-ok' ]] &&
            [[ "$(<"${test_home}/.cache/pi/status")" == 'cache-ok' ]]; then
