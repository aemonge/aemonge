    default: false,
  });
}
SPI_AUTO_EXTENSION
    printf '%s\n' '{"name":"spi-validation-package","pi":{"extensions":["./index.ts"]}}' >"${plugin_package_dir}/package.json"
    cat >"${plugin_package_dir}/index.ts" <<'SPI_PACKAGE_EXTENSION'
