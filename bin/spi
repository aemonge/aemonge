    printf 'symlink-openspec\n' >"${symlink_source_project}/openspec/changes/symlink-validation/tasks.md"
    printf '%s\n' '#!/usr/bin/env bash' 'printf host-tool-ok' >"${test_home}/.local/bin/spi-host-tool"
    chmod +x "${test_home}/.local/bin/spi-host-tool"
    mkdir -p -- "${shared_ro_dir}" "${shared_rw_dir}"
    printf 'shared-ro\n' >"${shared_ro_dir}/note.txt"
    printf 'shared-rw\n' >"${shared_rw_dir}/note.txt"
    if command -v python3 >/dev/null 2>&1; then
        python3 - "${terminal_nvim_socket}" "${terminal_nvim_listen_socket}" "${terminal_tmux_socket}" <<'PY'
import os
import socket
import sys

for path in sys.argv[1:]:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    sock = socket.socket(socket.AF_UNIX)
    sock.bind(path)
    sock.close()
PY
    fi

    printf 'SPI validation\n'

    if command -v bwrap >/dev/null 2>&1; then
        validation_pass "Test 0.1 PASS: bwrap found at $(command -v bwrap)"
        if check_bwrap_namespace_support; then
            validation_pass 'Test 0.2 PASS: bwrap namespace probe succeeded'
            live_bwrap=1
        else
            validation_fail 'Test 0.2 FAIL: bwrap namespace probe failed'
            failed_tests=$((failed_tests + 1))
        fi
    else
        validation_fail 'Test 0.1 FAIL: bwrap not found'
        failed_tests=$((failed_tests + 1))
    fi

    if [[ -x /bin/true ]]; then
        validation_pass 'Test 0.3 PASS: safe fake Pi binary is available at /bin/true'
    else
        validation_fail 'Test 0.3 FAIL: /bin/true is not executable'
        failed_tests=$((failed_tests + 1))
        live_bwrap=0
    fi

    run_validation_spi_with_home() {
        local sandbox_home="$1"
        local sandbox_agent_dir="$2"
        local sandbox_xdg_config_home="${SPI_VALIDATION_XDG_CONFIG_HOME:-${sandbox_home}/.config}"
        local sandbox_xdg_data_home="${SPI_VALIDATION_XDG_DATA_HOME:-${sandbox_home}/.local/share}"
        local sandbox_xdg_state_home="${SPI_VALIDATION_XDG_STATE_HOME:-${sandbox_home}/.local/state}"
        local sandbox_xdg_cache_home="${SPI_VALIDATION_XDG_CACHE_HOME:-${sandbox_home}/.cache}"
        shift 2

        env \
            HOME="${sandbox_home}" \
            PATH="${PATH}" \
            XDG_CONFIG_HOME="${sandbox_xdg_config_home}" \
            XDG_DATA_HOME="${sandbox_xdg_data_home}" \
            XDG_STATE_HOME="${sandbox_xdg_state_home}" \
            XDG_CACHE_HOME="${sandbox_xdg_cache_home}" \
            USER="${USER:-aemonge}" \
            LOGNAME="${LOGNAME:-${USER:-aemonge}}" \
            TERM="${TERM:-xterm-256color}" \
            LANG="${LANG:-C.UTF-8}" \
            RUSTUP_HOME="${sandbox_home}/.local/share/rustup" \
            CARGO_HOME="${sandbox_home}/.local/share/cargo" \
            GOPATH="${sandbox_home}/.local/share/go" \
            GOBIN= \
            SSH_AUTH_SOCK="${SPI_VALIDATION_SSH_AUTH_SOCK:-}" \
            PI_BIN="${SPI_VALIDATION_PI_BIN:-/bin/true}" \
            PI_CODING_AGENT_DIR="${sandbox_agent_dir}" \
            SPI_FORCE_PROBE=1 \
            "${script_path}" "$@"
    }

    run_validation_spi() {
        run_validation_spi_with_home "${test_home}" "${test_home}/.pi/agent" "$@"
    }

    run_spi_terminal_fixture() {
        SPI_VALIDATION_XDG_CONFIG_HOME="${terminal_xdg_config_home}" \
            ZDOTDIR="${terminal_zdotdir}" \
            NVIM="${terminal_nvim_socket}" \
            NVIM_LISTEN_ADDRESS="${terminal_nvim_listen_socket}" \
            TMUX="${terminal_tmux_socket},777,0" \
            TMUX_PANE="%7" \
            run_validation_spi "$@"
    }

    if [[ "${live_bwrap}" -eq 1 ]]; then
        # shellcheck disable=SC2016 # $HOME must expand inside the sandboxed shell.
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf "%s" "$HOME"' 2>&1 || true)"
        if [[ "${output}" == "${test_home}" ]]; then
            validation_pass 'Test A.1 PASS: HOME mirrors host home path on tmpfs'
        else
            validation_fail "Test A.1 FAIL: HOME is ${output} (expected ${test_home})"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # $HOME must expand inside the sandboxed shell.
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf SPI_TEST > "$HOME/.bashrc"' 2>&1 || true)"
        if [[ ! -e "${test_home}/.bashrc" ]]; then
            validation_pass 'Test A.2 PASS: ~/.bashrc writes do not leak to host'
        else
            validation_fail "Test A.2 FAIL: ~/.bashrc write leaked to host (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'touch /usr/bin/spi-validation-system-write 2>&1' 2>&1 || true)"
        if [[ "${output}" =~ Read-only|Permission\ denied|cannot\ touch|Operation\ not\ permitted ]]; then
            validation_pass 'Test A.3 PASS: system files are read-only'
        else
            validation_fail "Test A.3 FAIL: system file write was not blocked (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        if [[ -n "${validation_pi_bin}" && -x "${validation_pi_bin}" ]]; then
            output="$(env -u PI_CODING_AGENT_DIR -u SSH_AUTH_SOCK \
                HOME="${plugin_home}" PATH="${PATH}" \
                USER="${USER:-aemonge}" LOGNAME="${LOGNAME:-${USER:-aemonge}}" \
                TERM="${TERM:-xterm-256color}" LANG="${LANG:-C.UTF-8}" \
                PI_BIN="${validation_pi_bin}" SPI_FORCE_PROBE=1 \
                "${script_path}" --help -- "${test_project}" -q --backend bwrap --no-host-tools --no-ssh-agent 2>&1 || true)"
            if [[ "${output}" == *--spi-auto-extension-loaded* && "${output}" == *--spi-package-extension-loaded* ]]; then
                validation_pass 'Test A.4 PASS: real Pi loads global extensions and settings packages without a host PI_CODING_AGENT_DIR override'
            else
                validation_fail "Test A.4 FAIL: real Pi did not load mounted global extensions/settings packages (${output})"
                failed_tests=$((failed_tests + 1))
            fi
        else
            validation_warn 'Test A.4 SKIP: real Pi binary unavailable for extension loading probe'
        fi

        if output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf spi-rw-ok > validation-write.txt && cat validation-write.txt' 2>&1)" &&
            [[ "${output}" == "spi-rw-ok" ]] && [[ -f "${test_project}/validation-write.txt" ]] &&
            [[ "$(<"${test_project}/validation-write.txt")" == "spi-rw-ok" ]]; then
            validation_pass 'Test B.1 PASS: default rw workspace writes persist to target'
        else
            validation_fail "Test B.1 FAIL: default rw workspace write failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap --ro -x /bin/bash --noprofile --norc -lc 'printf nope > ro-blocked.txt' 2>&1 || true)"
        if [[ ! -e "${test_project}/ro-blocked.txt" ]] && [[ "${output}" =~ Read-only|Permission\ denied|cannot\ create|Operation\ not\ permitted ]]; then
            validation_pass 'Test B.2 PASS: --ro blocks workspace writes'
        else
            validation_fail "Test B.2 FAIL: --ro workspace write was not blocked (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        if output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf nm-ok > node_modules/spi-validation && cat node_modules/spi-validation' 2>&1)" &&
            [[ "${output}" == "nm-ok" ]] && [[ -f "${test_project}/node_modules/spi-validation" ]]; then
            validation_pass 'Test B.3 PASS: node_modules is writable when workspace is rw'
        else
            validation_fail "Test B.3 FAIL: node_modules was not writable (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'test -e .env && cat .env' 2>&1 || true)"
        if [[ "${output}" == 'SPI_VALIDATION=1' ]]; then
            validation_pass 'Test B.4 PASS: project .env is visible'
        else
            validation_fail "Test B.4 FAIL: project .env was not visible (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf RAW_OK' 2>&1 || true)"
        if [[ "${output}" == 'RAW_OK' ]]; then
            validation_pass 'Test B.5 PASS: raw commands execute inside sandbox'
        else
            validation_fail "Test B.5 FAIL: raw command output was ${output}"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # Variables expand inside the sandboxed shell.
        output="$(run_validation_spi -- "${validation_root}/nested-parent/nvim" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'task_path="$(dirname "$PWD")/openspec/changes/nested-validation/tasks.md"; cat "$task_path" >/dev/null || exit 1; if printf bad > "$task_path" 2>/dev/null; then printf OPENSPEC_WRITE_ALLOWED; else printf OPENSPEC_RO; fi' 2>&1 || true)"
        if [[ "${output}" == *OPENSPEC_RO* ]] && [[ "${output}" != *OPENSPEC_WRITE_ALLOWED* ]] && \
            [[ "$(<"${validation_root}/nested-parent/openspec/changes/nested-validation/tasks.md")" == 'nested-openspec' ]]; then
            validation_pass 'Test B.7 PASS: nested target sees nearest project OpenSpec read-only'
        else
            validation_fail "Test B.7 FAIL: nested target OpenSpec visibility/policy failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # Variables expand inside the sandboxed shell.
        output="$(run_validation_spi -- "${symlink_logical_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'task_path="$HOME/.config/openspec/changes/symlink-validation/tasks.md"; cat "$task_path" >/dev/null || exit 1; if printf bad > "$task_path" 2>/dev/null; then printf SYMLINK_OPENSPEC_WRITE_ALLOWED; else printf SYMLINK_OPENSPEC_RO; fi' 2>&1 || true)"
        if [[ "${output}" == *SYMLINK_OPENSPEC_RO* ]] && [[ "${output}" != *SYMLINK_OPENSPEC_WRITE_ALLOWED* ]] && \
            [[ "$(<"${symlink_source_project}/openspec/changes/symlink-validation/tasks.md")" == 'symlink-openspec' ]]; then
            validation_pass 'Test B.8 PASS: symlinked config target sees resolved project OpenSpec read-only at logical path'
        else
            validation_fail "Test B.8 FAIL: symlinked config target OpenSpec visibility/policy failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        if command -v openspec >/dev/null 2>&1; then
            output="$(run_validation_spi -- "${direct_openspec_project}" -q --backend bwrap -x node -e 'const {execFileSync}=require("child_process"); const out=execFileSync("openspec",["list","--json"],{cwd:process.cwd(),encoding:"utf8"}); const parsed=JSON.parse(out); if(parsed.changes?.[0]?.name!=="direct-validation") throw new Error(out); if(out.includes("Note: OpenSpec")) throw new Error("telemetry note in stdout"); process.stdout.write("DIRECT_OPENSPEC_JSON_OK")' 2>&1 || true)"
            if [[ "${output}" == 'DIRECT_OPENSPEC_JSON_OK' ]]; then
                validation_pass 'Test B.9 PASS: direct OpenSpec target emits clean JSON for footer parsing'
            else
                validation_fail "Test B.9 FAIL: direct OpenSpec JSON parsing failed (${output})"
                failed_tests=$((failed_tests + 1))
            fi
        else
            printf 'ℹ️  Test B.9 SKIP: openspec unavailable for direct OpenSpec JSON probe\n'
        fi

        # shellcheck disable=SC2016 # $TMPDIR must expand inside the sandboxed shell.
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'case "$TMPDIR" in /tmp/spi-*) ;; *) printf "bad-path:%s" "$TMPDIR"; exit 1 ;; esac; test -d "$TMPDIR" && test -w "$TMPDIR" && test "$(stat -c %a "$TMPDIR")" = 700 && printf TMPDIR_OK' 2>&1 || true)"
        if [[ "${output}" == 'TMPDIR_OK' ]]; then
            validation_pass 'Test B.6 PASS: TMPDIR points to a private writable /tmp/spi-* directory'
        else
            validation_fail "Test B.6 FAIL: private TMPDIR check failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'command -v spi-host-tool >/dev/null && spi-host-tool' 2>&1 || true)"
        if [[ "${output}" == 'host-tool-ok' ]]; then
            validation_pass 'Test D.1 PASS: ~/.local/bin host tools are exposed on PATH'
        else
            validation_fail "Test D.1 FAIL: ~/.local/bin host tool was not exposed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # $HOME expands inside the sandbox.
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'for d in "$HOME/.cache/uv" "$HOME/.local/share/pnpm" "$HOME/.local/share/cargo" "$HOME/.local/share/go" "$HOME/.bun"; do if ! test -w "$d"; then printf "NOT_WRITABLE:%s" "$d"; exit 1; fi; done; printf HOST_TOOL_STATE_OK' 2>&1 || true)"
        if [[ "${output}" == 'HOST_TOOL_STATE_OK' ]]; then
            validation_pass 'Test D.1b PASS: scoder-parity host tool state is writable'
        else
            validation_fail "Test D.1b FAIL: host tool state is unavailable (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'grep -q "^nameserver " /etc/resolv.conf && printf RESOLVER_OK' 2>&1 || true)"
        if [[ "${output}" == 'RESOLVER_OK' ]]; then
            validation_pass 'Test D.2 PASS: DNS resolver config is available'
        else
            validation_warn "Test D.2 WARN: DNS resolver config unavailable or unusual (${output})"
        fi

        if command -v timeout >/dev/null 2>&1; then
            output="$(timeout 10s env \
                HOME="${test_home}" \
                PATH="${PATH}" \
                USER="${USER:-aemonge}" \
                LOGNAME="${LOGNAME:-${USER:-aemonge}}" \
                TERM="${TERM:-xterm-256color}" \
                LANG="${LANG:-C.UTF-8}" \
                PI_BIN=/bin/true \
                PI_CODING_AGENT_DIR="${test_home}/.pi/agent" \
                SPI_FORCE_PROBE=1 \
                "${script_path}" -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'getent hosts api.openai.com >/dev/null && printf DNS_OK' 2>&1 || true)"
            if [[ "${output}" == 'DNS_OK' ]]; then
                validation_pass 'Test D.3 PASS: DNS lookup works inside sandbox'
            else
                printf 'ℹ️  Test D.3 SKIP: DNS lookup not guaranteed in this environment (%s)\n' "${output}"
            fi
        else
            printf 'ℹ️  Test D.3 SKIP: timeout unavailable for bounded DNS probe\n'
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf git-ok > .git/spi-default && cat .git/spi-default' 2>&1 || true)"
        if [[ "${output}" == 'git-ok' && "$(<"${test_project}/.git/spi-default")" == 'git-ok' ]]; then
            validation_pass 'Test C.1 PASS: .git is writable inside the selected target by default'
        else
            validation_fail "Test C.1 FAIL: default .git write failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        if output="$(run_validation_spi -- "${test_project}" -q --backend bwrap --allow-git -x /bin/bash --noprofile --norc -lc 'printf spi-git-ok > .git/spi-allowed && cat .git/spi-allowed' 2>&1)" &&
            [[ "${output}" == "spi-git-ok" ]] && [[ -f "${test_project}/.git/spi-allowed" ]]; then
            validation_pass 'Test C.2 PASS: --allow-git remains compatible with default Git writes'
        else
            validation_fail "Test C.2 FAIL: --allow-git compatibility failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf agents-ok > .agents/spi-default && cat .agents/spi-default' 2>&1 || true)"
        if [[ "${output}" == 'agents-ok' && "$(<"${test_project}/.agents/spi-default")" == 'agents-ok' ]]; then
            validation_pass 'Test C.3 PASS: project .agents is writable inside the selected target'
        else
            validation_fail "Test C.3 FAIL: project .agents write failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # $path expands inside the sandboxed shell.
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'for path in .github/spi-validation .turbo/spi-validation .cargo/spi-validation .gitignore package-lock.json poetry.lock Cargo.lock pnpm-lock.yaml yarn.lock; do if { printf bad > "$path"; } 2>/dev/null; then printf "WRITE_ALLOWED:%s" "$path"; exit 1; fi; done; printf INFRA_RO' 2>&1 || true)"
        if [[ "${output}" == *INFRA_RO* && "${output}" != *WRITE_ALLOWED:* ]] && [[ ! -e "${test_project}/.github/spi-validation" ]] &&
            [[ "$(<"${test_project}/Cargo.lock")" == 'lock' ]]; then
            validation_pass 'Test C.4 PASS: scoder-compatible critical infrastructure is read-only by default'
        else
            validation_fail "Test C.4 FAIL: critical infrastructure protection failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap --allow-infra -x /bin/bash --noprofile --norc -lc 'printf infra-ok > .github/spi-allowed && printf lock-ok > Cargo.lock && printf INFRA_RW' 2>&1 || true)"
        if [[ "${output}" == 'INFRA_RW' ]] && [[ "$(<"${test_project}/.github/spi-allowed")" == 'infra-ok' ]] &&
            [[ "$(<"${test_project}/Cargo.lock")" == 'lock-ok' ]]; then
            validation_pass 'Test C.5 PASS: --allow-infra restores target infrastructure writes'
        else
            validation_fail "Test C.5 FAIL: --allow-infra did not restore writes (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc "mkdir -p ${neighbor_dir_q} && printf bad > ${neighbor_dir_q}/escape.txt && printf attempted" 2>&1 || true)"
        if [[ ! -e "${neighbor_dir}/escape.txt" ]] && [[ -f "${neighbor_dir}/secret.txt" ]] &&
            [[ "$(<"${neighbor_dir}/secret.txt")" == "neighbor-secret" ]]; then
            validation_pass 'Test D.1 PASS: parent/neighbor path escape does not mutate host paths'
        else
            validation_fail "Test D.1 FAIL: parent/neighbor host path was mutated (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # $HOME must expand inside the sandboxed shell.
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf bad > "$HOME/.pi/config"' 2>&1 || true)"
        if [[ -f "${test_home}/.pi/config" ]] && [[ "$(<"${test_home}/.pi/config")" == "original-pi-config" ]] &&
            [[ "${output}" =~ Read-only|Permission\ denied|cannot\ create|Operation\ not\ permitted ]]; then
            validation_pass 'Test E.1 PASS: Pi config is blocked by default'
        else
            validation_fail "Test E.1 FAIL: default Pi config protection did not block writes (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # $HOME must expand inside the sandboxed shell.
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'test -r "$HOME/.pi/config" && cat "$HOME/.pi/config"' 2>&1 || true)"
        if [[ "${output}" == 'original-pi-config' ]]; then
            validation_pass 'Test E.2 PASS: Pi config is readable when bound read-only'
        else
            validation_fail "Test E.2 FAIL: Pi config read failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_home}/.pi" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf selected-pi-ok > selected-target-write && cat selected-target-write' 2>&1 || true)"
        if [[ "${output}" == 'selected-pi-ok' && "$(<"${test_home}/.pi/selected-target-write")" == 'selected-pi-ok' ]]; then
            validation_pass 'Test E.2b PASS: selecting ~/.pi makes that target writable'
        else
            validation_fail "Test E.2b FAIL: selected ~/.pi target was not writable (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # $PI_CODING_AGENT_DIR must expand inside the sandboxed shell.
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'for d in sessions auth trust models metadata cache projects workspaces providers state tasks status todos plans jobs runs ui statusline; do printf ok > "$PI_CODING_AGENT_DIR/$d/spi-validation" || exit 1; done; printf PI_STATE_OK' 2>&1 || true)"
        if [[ "${output}" == 'PI_STATE_OK' ]] && [[ -f "${test_home}/.pi/agent/sessions/spi-validation" ]] &&
            [[ -f "${test_home}/.pi/agent/auth/spi-validation" ]] && [[ -f "${test_home}/.pi/agent/cache/spi-validation" ]] &&
            [[ -f "${test_home}/.pi/agent/projects/spi-validation" ]] && [[ -f "${test_home}/.pi/agent/workspaces/spi-validation" ]] &&
            [[ -f "${test_home}/.pi/agent/providers/spi-validation" ]] && [[ -f "${test_home}/.pi/agent/state/spi-validation" ]] &&
            [[ -f "${test_home}/.pi/agent/tasks/spi-validation" ]] && [[ -f "${test_home}/.pi/agent/statusline/spi-validation" ]]; then
            validation_pass 'Test E.3 PASS: role-based Pi runtime/status state subdirectories are writable'
        else
            validation_fail "Test E.3 FAIL: role-based Pi runtime/status state was not writable (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # $HOME must expand inside the sandboxed shell.
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'cat "$HOME/.config/pi/config.toml" "$HOME/.local/share/pi/resource.txt" >/dev/null || exit 1; if printf bad > "$HOME/.config/pi/config.toml" 2>/dev/null; then printf XDG_CONFIG_WRITE_ALLOWED; else printf XDG_CONFIG_RO; fi; if printf bad > "$HOME/.local/share/pi/resource.txt" 2>/dev/null; then printf XDG_DATA_WRITE_ALLOWED; else printf XDG_DATA_RO; fi' 2>&1 || true)"
        if [[ "${output}" == *XDG_CONFIG_RO* ]] && [[ "${output}" == *XDG_DATA_RO* ]] &&
            [[ "${output}" != *XDG_CONFIG_WRITE_ALLOWED* ]] && [[ "${output}" != *XDG_DATA_WRITE_ALLOWED* ]] &&
            [[ "$(<"${test_home}/.config/pi/config.toml")" == 'pi-xdg-config' ]] &&
            [[ "$(<"${test_home}/.local/share/pi/resource.txt")" == 'pi-xdg-data' ]]; then
            validation_pass 'Test E.11 PASS: Pi XDG config/data resources are visible read-only'
        else
            validation_fail "Test E.11 FAIL: Pi XDG config/data resource policy failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # $HOME must expand inside the sandboxed shell.
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf state-ok > "$HOME/.local/state/pi/status" || exit 1; printf cache-ok > "$HOME/.cache/pi/status" || exit 1; printf PI_XDG_STATE_OK' 2>&1 || true)"
        if [[ "${output}" == 'PI_XDG_STATE_OK' ]] && [[ "$(<"${test_home}/.local/state/pi/status")" == 'state-ok' ]] &&
            [[ "$(<"${test_home}/.cache/pi/status")" == 'cache-ok' ]]; then
            validation_pass 'Test E.12 PASS: Pi XDG state/cache dirs are writable without broad XDG exposure'
        else
            validation_fail "Test E.12 FAIL: Pi XDG state/cache dirs were not writable (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # $HOME must expand inside the sandboxed shell.
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'cat "$HOME/.pi/agent/settings.json" "$HOME/.pi/agent/trust.json" >/dev/null || exit 1; mkdir "$HOME/.pi/agent/settings.json.lock" "$HOME/.pi/agent/trust.json.lock" || exit 1; if printf bad > "$HOME/.pi/agent/settings.json" 2>/dev/null; then printf ROOT_CONFIG_WRITE_ALLOWED; else printf ROOT_CONFIG_RO; fi; rmdir "$HOME/.pi/agent/settings.json.lock" "$HOME/.pi/agent/trust.json.lock" || exit 1; printf PI_AGENT_ROOT_LOCK_OK' 2>&1 || true)"
        if [[ "${output}" == *ROOT_CONFIG_RO* && "${output}" == *PI_AGENT_ROOT_LOCK_OK* ]] &&
            [[ "$(<"${test_home}/.pi/agent/settings.json")" == '{"theme":"original"}' ]] &&
            [[ "$(<"${test_home}/.pi/agent/trust.json")" == '{"trusted":false}' ]]; then
            validation_pass 'Test E.9 PASS: Pi root config is read-only while disposable lock dirs work'
        else
            validation_fail "Test E.9 FAIL: Pi root config/lock policy failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # $HOME must expand inside the sandboxed shell.
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'cat "$HOME/.pi/providers/catalog.txt" "$HOME/.pi/models/catalog.txt" >/dev/null || exit 1; if printf bad > "$HOME/.pi/providers/catalog.txt" 2>/dev/null; then printf PROVIDER_WRITE_ALLOWED; else printf PROVIDER_CONFIG_RO; fi; if printf bad > "$HOME/.pi/models/catalog.txt" 2>/dev/null; then printf MODEL_WRITE_ALLOWED; else printf MODEL_CONFIG_RO; fi' 2>&1 || true)"
        if [[ "${output}" == *PROVIDER_CONFIG_RO* ]] && [[ "${output}" == *MODEL_CONFIG_RO* ]] &&
            [[ "${output}" != *PROVIDER_WRITE_ALLOWED* ]] && [[ "${output}" != *MODEL_WRITE_ALLOWED* ]] &&
            [[ "$(<"${test_home}/.pi/providers/catalog.txt")" == 'provider-catalog' ]] &&
            [[ "$(<"${test_home}/.pi/models/catalog.txt")" == 'model-catalog' ]]; then
            validation_pass 'Test E.6 PASS: provider/model config resources are visible read-only'
        else
            validation_fail "Test E.6 FAIL: provider/model config read-only check failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # $HOME must expand inside the sandboxed shell.
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'cat "$HOME/.agents/skills/example/SKILL.md" >/dev/null || exit 1; if printf bad > "$HOME/.agents/skills/example/SKILL.md" 2>/dev/null; then printf SKILL_WRITE_ALLOWED; else printf SKILLS_RO; fi' 2>&1 || true)"
        if [[ "${output}" == *SKILLS_RO* ]] && [[ "${output}" != *SKILL_WRITE_ALLOWED* ]] &&
            [[ "$(<"${test_home}/.agents/skills/example/SKILL.md")" == 'skill-resource' ]]; then
            validation_pass 'Test E.7 PASS: ~/.agents/skills resources are visible read-only'
        else
            validation_fail "Test E.7 FAIL: ~/.agents/skills read-only check failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        local linked_skills_home="${validation_root}/linked-skills-home"
        mkdir -p -- "${linked_skills_home}/.pi/agent"
        ln -s "${test_project}/.agents" "${linked_skills_home}/.agents"
        output="$(run_validation_spi_with_home "${linked_skills_home}" "${linked_skills_home}/.pi/agent" -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc "test ! -e \"\$HOME/.agents/skills\" || exit 1; cat ${project_skill_file_q} >/dev/null || exit 1; printf SKILL_ALIAS_DEDUP_OK" 2>&1 || true)"
        if [[ "${output}" == 'SKILL_ALIAS_DEDUP_OK' ]]; then
            validation_pass 'Test E.10 PASS: symlinked global skills are not rebound as duplicate aliases'
        else
            validation_fail "Test E.10 FAIL: symlinked global skills alias was present or project skills were unreadable (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf project-pi-ok > .pi/spi-default && cat .pi/spi-default' 2>&1 || true)"
        if [[ "${output}" == 'project-pi-ok' && "$(<"${test_project}/.pi/spi-default")" == 'project-pi-ok' ]]; then
            validation_pass 'Test E.8 PASS: project .pi is writable inside the selected target'
        else
            validation_fail "Test E.8 FAIL: project .pi write failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # $HOME must expand inside the sandboxed shell.
        if output="$(run_validation_spi -- "${test_project}" -q --backend bwrap --allow-pi-config -x /bin/bash --noprofile --norc -lc 'printf spi-pi-ok > "$HOME/.pi/spi-validation-allowed" && cat "$HOME/.pi/spi-validation-allowed"' 2>&1)" &&
            [[ "${output}" == "spi-pi-ok" ]] && [[ -f "${test_home}/.pi/spi-validation-allowed" ]] &&
            [[ "$(<"${test_home}/.pi/spi-validation-allowed")" == "spi-pi-ok" ]]; then
            validation_pass 'Test E.4 PASS: --allow-pi-config permits temp ~/.pi writes'
        else
            validation_fail "Test E.4 FAIL: --allow-pi-config did not permit temp ~/.pi writes (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        local symlink_home="${validation_root}/symlink-home"
        local symlink_target_dir="${symlink_home}/.pi/linked-targets"
        mkdir -p -- "${symlink_home}/.pi/agent" "${symlink_home}/.pi" "${symlink_target_dir}"
        printf 'symlink-pi-config\n' >"${symlink_target_dir}/config"
        ln -s "${symlink_target_dir}/config" "${symlink_home}/.pi/config"
        # shellcheck disable=SC2016 # $HOME must expand inside the sandboxed shell.
        output="$(run_validation_spi_with_home "${symlink_home}" "${symlink_home}/.pi/agent" -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'cat "$HOME/.pi/config" || exit 1; if printf bad > "$HOME/.pi/config" 2>/dev/null; then printf SYMLINK_WRITE_ALLOWED; else printf SYMLINK_CONFIG_RO; fi' 2>&1 || true)"
        if [[ "${output}" == *symlink-pi-config* ]] && [[ "${output}" == *SYMLINK_CONFIG_RO* ]] &&
            [[ "${output}" != *SYMLINK_WRITE_ALLOWED* ]] && [[ "$(<"${symlink_target_dir}/config")" == 'symlink-pi-config' ]]; then
            validation_pass 'Test E.5 PASS: symlinked Pi config target is visible read-only'
        else
            validation_fail "Test E.5 FAIL: symlinked Pi config was not visible (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        if [[ -S "${terminal_nvim_socket}" ]]; then
            # shellcheck disable=SC2016 # $SSH_AUTH_SOCK must expand inside the sandboxed shell.
            output="$(SPI_VALIDATION_SSH_AUTH_SOCK="${terminal_nvim_socket}" run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'test -S "$SSH_AUTH_SOCK" && printf SSH_AGENT_OK' 2>&1 || true)"
            if [[ "${output}" == 'SSH_AGENT_OK' ]]; then
                validation_pass 'Test H.1a PASS: SSH_AUTH_SOCK is forwarded by default'
            else
                validation_fail "Test H.1a FAIL: SSH_AUTH_SOCK forwarding failed (${output})"
                failed_tests=$((failed_tests + 1))
            fi
            # shellcheck disable=SC2016 # $SSH_AUTH_SOCK expands inside the sandboxed shell.
            output="$(SPI_VALIDATION_SSH_AUTH_SOCK="${terminal_nvim_socket}" run_validation_spi -- "${test_project}" -q --backend bwrap --no-ssh-agent -x /bin/bash --noprofile --norc -lc 'test -z "${SSH_AUTH_SOCK:-}" && printf NO_SSH_AGENT' 2>&1 || true)"
            if [[ "${output}" == 'NO_SSH_AGENT' ]]; then
                validation_pass 'Test H.1b PASS: --no-ssh-agent disables forwarding'
            else
                validation_fail "Test H.1b FAIL: --no-ssh-agent did not disable forwarding (${output})"
                failed_tests=$((failed_tests + 1))
            fi
        fi

        # shellcheck disable=SC2016 # Environment variables must expand inside the sandboxed shell.
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'test -n "$TERM" && test -n "$COLORTERM" && test -n "$LANG" && test -n "$SHELL" && test "$GIT_OPTIONAL_LOCKS" = "0" && printf TUI_ENV_OK' 2>&1 || true)"
        if [[ "${output}" == 'TUI_ENV_OK' ]]; then
            validation_pass 'Test H.2 PASS: TUI environment variables are present'
        else
            validation_fail "Test H.2 FAIL: missing TUI environment variables (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # Terminal env/config variables must expand inside the sandboxed shell.
        output="$(run_spi_terminal_fixture -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'cat "$HOME/.config/starship.toml" "$XDG_CONFIG_HOME/starship.toml" "$HOME/.zshenv" "$ZDOTDIR/.zshrc" >/dev/null || exit 1; if printf blocked > "$HOME/.zshrc" 2>/dev/null; then printf WRITE_ALLOWED; else printf TERMINAL_CONFIG_RO; fi' 2>&1 || true)"
        if [[ "${output}" == *TERMINAL_CONFIG_RO* ]] && [[ "${output}" != *WRITE_ALLOWED* ]] && [[ "$(<"${test_home}/.zshrc")" == 'validation-zshrc' ]]; then
            validation_pass 'Test H.3 PASS: terminal config files are readable and read-only'
        else
            validation_fail "Test H.3 FAIL: terminal config read-only check failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # EDITOR/VISUAL expand inside the sandboxed shell.
        output="$(run_spi_terminal_fixture -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'test "$EDITOR" = "$HOME/.config/nvim/scripts/opencode-editor" && test "$VISUAL" = "$EDITOR" && test -x "$EDITOR" && if { printf bad > "$EDITOR"; } 2>/dev/null; then exit 1; fi; printf NVIM_EDITOR_OK' 2>&1 || true)"
        if [[ "${output}" == *NVIM_EDITOR_OK* ]] && [[ "$(head -n 1 "${terminal_nvim_editor}")" == '#!/usr/bin/env bash' ]]; then
            validation_pass 'Test H.3b PASS: scoder-compatible Neovim EDITOR/VISUAL bridge is read-only'
        else
            validation_fail "Test H.3b FAIL: Neovim editor bridge failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        if [[ -S "${terminal_nvim_socket}" && -S "${terminal_nvim_listen_socket}" && -S "${terminal_tmux_socket}" ]]; then
            # shellcheck disable=SC2016 # Terminal socket variables must expand inside the sandboxed shell.
            output="$(run_spi_terminal_fixture -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'tmux_socket="${TMUX%%,*}"; test -S "$NVIM" && test -S "$NVIM_LISTEN_ADDRESS" && test -S "$tmux_socket" && test "$TMUX_PANE" = "%7" && printf TERMINAL_SOCKET_OK' 2>&1 || true)"
            if [[ "${output}" == 'TERMINAL_SOCKET_OK' ]]; then
                validation_pass 'Test H.4 PASS: terminal sockets are exact-bound and env is preserved'
            else
                validation_fail "Test H.4 FAIL: terminal socket forwarding check failed (${output})"
                failed_tests=$((failed_tests + 1))
            fi

            # shellcheck disable=SC2016 # Terminal variables expand inside the sandboxed shell.
            output="$(run_spi_terminal_fixture -- "${test_project}" -q --backend bwrap --no-nvim-remote -x /bin/bash --noprofile --norc -lc 'tmux_socket="${TMUX%%,*}"; test -z "${NVIM:-}" && test -z "${NVIM_LISTEN_ADDRESS:-}" && test -S "$tmux_socket" && test "$TMUX_PANE" = "%7" && test "$EDITOR" = v_quickedit_hover && printf NVIM_REMOTE_DISABLED' 2>&1 || true)"
            if [[ "${output}" == 'NVIM_REMOTE_DISABLED' ]]; then
                validation_pass 'Test H.4b PASS: --no-nvim-remote disables Neovim while retaining exact tmux integration'
            else
                validation_fail "Test H.4b FAIL: --no-nvim-remote policy failed (${output})"
                failed_tests=$((failed_tests + 1))
            fi
        else
            printf 'ℹ️  Test H.4/H.4b SKIP: python3 unavailable for fake Unix socket fixtures\n'
        fi

        output="$(run_spi_terminal_fixture -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc "test ! -e ${terminal_runtime_marker_q} && printf NO_RUNTIME_WIDE" 2>&1 || true)"
        if [[ "${output}" == 'NO_RUNTIME_WIDE' ]]; then
            validation_pass 'Test H.5 PASS: broad runtime directory is not exposed'
        else
            validation_fail "Test H.5 FAIL: broad runtime directory was visible (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'pwd' 2>&1 || true)"
        if [[ "${output}" == "${test_project}" ]]; then
            validation_pass 'Test I.1 PASS: project path is preserved inside sandbox'
        else
            validation_fail "Test I.1 FAIL: project path changed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${target_file_path}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc "cat ${sibling_file_path_q}" 2>&1 || true)"
        if [[ "${output}" == 'beta' ]]; then
            validation_pass 'Test L.1 PASS: file target mode keeps sibling files readable'
        else
            validation_fail "Test L.1 FAIL: sibling read output was ${output}"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${target_file_path}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc "printf updated > ${target_file_path_q} && cat ${target_file_path_q}" 2>&1 || true)"
        if [[ "${output}" == 'updated' && "$(<"${target_file_path}")" == 'updated' ]]; then
            validation_pass 'Test L.2 PASS: writable single-file target changes sync back on success'
        else
            validation_fail "Test L.2 FAIL: writable single-file target did not sync (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${target_file_path}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc "printf blocked > ${sibling_file_path_q}" 2>&1 || true)"
        if [[ "${output}" =~ Read-only|Permission\ denied|cannot\ create|Operation\ not\ permitted ]] && [[ "$(<"${sibling_file_path}")" == 'beta' ]]; then
            validation_pass 'Test L.3 PASS: writable single-file mode keeps siblings read-only'
        else
            validation_fail "Test L.3 FAIL: sibling write was not blocked (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'git --scoder-git-version' 2>&1 || true)"
        if [[ "${output}" == scoder-git* ]]; then
            validation_pass 'Test M.1 PASS: /usr/bin/git is shadowed by scoder-git'
        else
            validation_fail "Test M.1 FAIL: /usr/bin/git is not shadowed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'git push 2>&1' 2>&1 || true)"
        if [[ "${output}" == *'fatal: scoder blocked git push'* ]]; then
            validation_pass 'Test M.2 PASS: git push is denied by policy wrapper'
        else
            validation_fail "Test M.2 FAIL: git push was not denied (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        git -C "${test_project}" init -q
        git -C "${test_project}" config user.email spi-validation@example.invalid
        git -C "${test_project}" config user.name 'spi validation'
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap --allow-git -x /bin/bash --noprofile --norc -lc 'printf commit-ok > committed.txt && git add committed.txt && git commit -m "validation commit" >/dev/null && git log --oneline -1' 2>&1 || true)"
        if [[ "${output}" == *'validation commit'* ]]; then
            validation_pass 'Test M.3 PASS: git add/commit works with --allow-git'
        else
            validation_fail "Test M.3 FAIL: git add/commit failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        git -C "${test_project}" branch validation-switch-target >/dev/null 2>&1 || true
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap --allow-git -x /bin/bash --noprofile --norc -lc 'git switch --quiet validation-switch-target >/dev/null && git branch --show-current' 2>&1 || true)"
        if [[ "${output}" == 'validation-switch-target' ]]; then
            validation_pass 'Test M.4 PASS: git switch existing branch works with --allow-git'
        else
            validation_fail "Test M.4 FAIL: git switch existing branch failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap --allow-git -x /bin/bash --noprofile --norc -lc 'git switch --quiet -c validation-switch-created >/dev/null && git branch --show-current' 2>&1 || true)"
        if [[ "${output}" == 'validation-switch-created' ]]; then
            validation_pass 'Test M.5 PASS: git switch -c creates local branches with --allow-git'
        else
            validation_fail "Test M.5 FAIL: git switch -c failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap --allow-git -x /bin/bash --noprofile --norc -lc 'git switch --force validation-switch-target 2>&1' 2>&1 || true)"
        if [[ "${output}" == *'git switch unsafe option: --force'* ]]; then
            validation_pass 'Test M.6 PASS: unsafe git switch flags are denied'
        else
            validation_fail "Test M.6 FAIL: git switch --force was not denied (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap --allow-git -x /bin/bash --noprofile --norc -lc 'git reset --hard HEAD 2>&1' 2>&1 || true)"
        if [[ "${output}" == *'Denied git reset --hard blocked'* ]]; then
            validation_pass 'Test M.7 PASS: destructive git reset remains denied'
        else
            validation_fail "Test M.7 FAIL: git reset --hard was not denied (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap --add "${shared_ro_dir}" -x /bin/bash --noprofile --norc -lc "cat ${shared_ro_dir_q}/note.txt" 2>&1 || true)"
        if [[ "${output}" == 'shared-ro' ]]; then
            validation_pass 'Test N.1 PASS: --add exposes extra path read-only'
        else
            validation_fail "Test N.1 FAIL: --add read failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap --add "${shared_ro_dir}" -x /bin/bash --noprofile --norc -lc "printf blocked > ${shared_ro_dir_q}/note.txt" 2>&1 || true)"
        if [[ "${output}" =~ Read-only|Permission\ denied|cannot\ create|Operation\ not\ permitted ]] && [[ "$(<"${shared_ro_dir}/note.txt")" == 'shared-ro' ]]; then
            validation_pass 'Test N.2 PASS: --add keeps extra path read-only'
        else
            validation_fail "Test N.2 FAIL: --add did not block writes (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap --add-rw "${shared_rw_dir}" -x /bin/bash --noprofile --norc -lc "printf updated > ${shared_rw_dir_q}/note.txt && cat ${shared_rw_dir_q}/note.txt" 2>&1 || true)"
        if [[ "${output}" == 'updated' ]] && [[ "$(<"${shared_rw_dir}/note.txt")" == 'updated' ]]; then
            validation_pass 'Test N.3 PASS: --add-rw allows writes'
        else
            validation_fail "Test N.3 FAIL: --add-rw write failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi
    else
        printf 'ℹ️  Live bwrap validation skipped because bwrap/probe prerequisites failed\n'
    fi

    output="$(env HOME="${test_home}" PATH="${PATH}" PI_BIN=/bin/true PI_CODING_AGENT_DIR="${test_home}/.pi/agent" "${script_path}" -- "${test_project}" -q --backend unsupported 2>&1 || true)"
    if [[ "${output}" == *'spi supports only the bwrap backend'* ]]; then
        validation_pass 'Test F.1 PASS: non-Bubblewrap backend requests fail closed'
    else
        validation_fail "Test F.1 FAIL: non-Bubblewrap backend request did not fail closed (${output})"
        failed_tests=$((failed_tests + 1))
    fi

    output="$(env HOME="${test_home}" PATH="${PATH}" PI_BIN=/bin/true PI_CODING_AGENT_DIR="${test_home}/.pi/agent" SPI_FORCE_PROBE=1 "${script_path}" -- / -q -x /bin/true 2>&1 || true)"
    if [[ "${output}" == *'refusing to mount the host root writable'* ]]; then
        validation_pass 'Test F.2 PASS: writable host-root targets are rejected'
    else
        validation_fail "Test F.2 FAIL: writable host-root target was not rejected (${output})"
        failed_tests=$((failed_tests + 1))
    fi

    if [[ "${SPI_VALIDATION_EXTERNAL:-0}" != "1" ]]; then
        for external_name in spi-static-test spi-parser-test; do
            external_test="${script_dir}/test/${external_name}"
            if [[ -x "${external_test}" ]]; then
                if output="$(SPI_VALIDATION_EXTERNAL=1 "${external_test}" 2>&1)"; then
                    validation_pass "Test X.${external_name} PASS: external ${external_name} passed"
                else
                    external_status=$?
                    validation_fail "Test X.${external_name} FAIL: external ${external_name} failed with ${external_status}"
                    printf '%s\n' "${output}"
                    failed_tests=$((failed_tests + 1))
                fi
            else
                printf 'ℹ️  Test X.%s SKIP: external script not present or not executable\n' "${external_name}"
            fi
        done
    fi

    rm -rf -- "${validation_root}"

    printf '\n'
    if [[ "${failed_tests}" -eq 0 ]]; then
        printf '🎉 All SPI validation tests passed!\n'
        return 0
    fi

    printf '⚠️  %s SPI validation test(s) failed\n' "${failed_tests}"
    return 1
}

if [[ $# -eq 1 ]]; then
    case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    -V | --version)
        version
        exit 0
        ;;
    esac
fi

