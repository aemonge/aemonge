            validation_fail "Test E.1 FAIL: default Pi config protection did not block writes (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # $HOME must expand inside the sandboxed shell.
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'test -r "$HOME/.pi/config" && cat "$HOME/.pi/config"' 2>&1 || true)"
        if [[ "${output}" == 'original-pi-config' ]]; then
            validation_pass 'Test E.2 PASS: Pi config is readable when bound read-only'
        else
            validation_fail "Test E.2 FAIL: Pi config read failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # $PI_CODING_AGENT_DIR must expand inside the sandboxed shell.
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'for d in sessions auth trust models metadata cache projects workspaces providers state tasks status todos plans jobs runs ui statusline; do printf ok > "$PI_CODING_AGENT_DIR/$d/spi-validation" || exit 1; done; printf PI_STATE_OK' 2>&1 || true)"
        if [[ "${output}" == 'PI_STATE_OK' ]] && [[ -f "${test_home}/.pi/agent/sessions/spi-validation" ]] &&
            [[ -f "${test_home}/.pi/agent/auth/spi-validation" ]] && [[ -f "${test_home}/.pi/agent/cache/spi-validation" ]] &&
            [[ -f "${test_home}/.pi/agent/projects/spi-validation" ]] && [[ -f "${test_home}/.pi/agent/workspaces/spi-validation" ]] &&
            [[ -f "${test_home}/.pi/agent/providers/spi-validation" ]] && [[ -f "${test_home}/.pi/agent/state/spi-validation" ]] &&
            [[ -f "${test_home}/.pi/agent/tasks/spi-validation" ]] && [[ -f "${test_home}/.pi/agent/statusline/spi-validation" ]]; then
            validation_pass 'Test E.3 PASS: role-based Pi runtime/status state subdirectories are writable'
