        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap --allow-git -x /bin/bash --noprofile --norc -lc 'printf commit-ok > committed.txt && git add committed.txt && git commit -m "validation commit" >/dev/null && git log --oneline -1' 2>&1 || true)"
        if [[ "${output}" == *'validation commit'* ]]; then
