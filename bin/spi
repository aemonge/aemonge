#!/usr/bin/env bash

# spi - Safe wrapper for Pi using bubblewrap.
# Heavy-copy adaptation of bin/scoder's sandbox model for the Pi CLI MVP.

set -euo pipefail

readonly PROGRAM_NAME="spi"
readonly PROGRAM_VERSION="0.1.0"
readonly PI_BIN_DEFAULT="pi"

readonly RED='\033[0;31m'
readonly YELLOW='\033[1;33m'
readonly GREEN='\033[0;32m'
readonly NC='\033[0m'

usage() {
    cat <<'USAGE_EOF'
spi 0.1.0
Safe Pi wrapper using Bubblewrap.

Usage:
  spi [PI_ARGS...] [-- [TARGET] [SPI_OPTIONS...]]
  spi [PI_ARGS...] -- [TARGET] -x COMMAND [ARG...]

Pi arguments before "--" are forwarded to pi unchanged. Arguments after "--"
select the target and configure spi's sandbox.

Options after "--":
  -h, --help                 Show this help and exit
  -V, --version              Show version and exit
  -a, --add PATH             Add extra file/dir to sandbox read-only
  -A, --add-rw PATH          Add extra file/dir to sandbox read-write
  -b, --bin PATH             Path/name of pi binary (default: "pi")
  -q, --quiet                Suppress non-essential output
  -v, --verbose              Show informational startup diagnostics
  -x, --exec COMMAND...      Execute raw command inside sandbox instead of pi
      --backend MODE         Sandbox backend: auto, bwrap, gondolin
      --doctor               Run diagnostics and exit
      --validate             Run comprehensive validation tests and exit
      --ro                   Mount target read-only
      --rw                   Mount target read-write (default)
      --allow-git            Allow write access to .git (default: read-only)
      --allow-pi-config      Write-bind all ~/.pi explicitly
      --allow-infra          Allow write access to protected control paths
      --full-dev             Allow full /dev access inside sandbox

Arguments:
  PI_ARGS                    Arguments passed verbatim to pi before "--"
  TARGET                     Directory or regular file exposed at the same
                             absolute path after "--" (default: $PWD)
  COMMAND [ARG...]           Raw command executed inside the sandbox

Environment:
  PI_BIN                     Overrides default pi binary
  PI_CODING_AGENT_DIR        Optional Pi state root override (Pi default: ~/.pi/agent)
  SPI_BACKEND                Default backend: auto, bwrap, gondolin
  SPI_FS_MODE                "ro" or "rw" (default)
  TMPDIR                     Set inside sandbox to /tmp/spi-<pid>

Protected by default:
  .git, .github, .pi, .agents, openspec, .claude, .mcp.json and common lockfiles.
  Git is shadowed with the existing scoder-git policy wrapper when available.

Pi state model:
  Normal mode uses tmpfs HOME, exposes existing ~/.pi read-only, and overlays
  the Pi agent root writable for startup settings/trust JSON and lock dirs, plus
  selected writable Pi runtime/state subdirectories for sessions, auth, trust,
  models, metadata, cache, project/workspace/provider state, and related state.
  Legacy/current ~/.pi/agent resource/config children such as extensions,
  packages, prompts, skills, themes, and keybindings remain read-only and follow
  symlinks at their logical HOME paths; mutable root JSON/state remains writable.
  Future XDG Pi config/data paths are also exposed when present.
  ~/.agents/skills is mounted read-only when present, unless it resolves to
  the same project .agents/skills tree already exposed by the target.
  Use --allow-pi-config only when Pi must write broader ~/.pi configuration.

Backends:
  bwrap     Implemented on supported Linux hosts.
  auto      Chooses bwrap on supported Linux hosts; never falls through to
            unsandboxed pi.
  gondolin  Fail-closed placeholder; Gondolin is inspiration only for this MVP.
USAGE_EOF
}

version() {
    printf '%s %s\n' "${PROGRAM_NAME}" "${PROGRAM_VERSION}"
    printf 'Sandbox backend default: %s\n' "${SPI_BACKEND:-auto}"
}

error() {
    printf '%b%s: %s%b\n' "${RED}" "${PROGRAM_NAME}" "$*" "${NC}" >&2
}

warning() {
    printf '%b%s: %s%b\n' "${YELLOW}" "${PROGRAM_NAME}" "$*" "${NC}" >&2
}

info() {
    if [[ "${QUIET}" -eq 0 && "${VERBOSE}" -eq 1 ]]; then
        printf '%b%s: %s%b\n' "${GREEN}" "${PROGRAM_NAME}" "$*" "${NC}" >&2
    fi
}

trace_startup() {
    [[ "${SPI_TRACE_STARTUP:-0}" == "1" ]] || return 0
    printf 'spi startup: %s\n' "$1" >&2
}

resolve_bind_source_path() {
    local source_path="$1"
    if [[ -L "${source_path}" ]]; then
        REPLY="$(realpath "${source_path}")"
        return
    fi
    REPLY="${source_path}"
}

is_path_within() {
    local parent_path="$1"
    local child_path="$2"
    [[ "${child_path}" == "${parent_path}" || "${child_path}" == "${parent_path}"/* ]]
}

add_extra_dir_once() {
    local dir_path="$1"
    [[ -n "${EXTRA_DIR_SET[${dir_path}]:-}" ]] && return 0
    EXTRA_DIR_SET["${dir_path}"]=1
    EXTRA_DIRS+=(--dir "${dir_path}")
}

add_parent_dirs_once() {
    local dir_path="$1"
    local parent=""
    local segment

    [[ -n "${PARENT_DIR_EXPANSION_SET[${dir_path}]:-}" ]] && return 0
    PARENT_DIR_EXPANSION_SET["${dir_path}"]=1

    IFS='/' read -r -a segments <<<"${dir_path}"
    for segment in "${segments[@]}"; do
        [[ -z "${segment}" ]] && continue
        parent="${parent}/${segment}"
        add_extra_dir_once "${parent}"
    done
}

add_extra_bind_once() {
    local bind_flag="$1"
    local host_p="$2"
    local sand_p="$3"
    local bind_key="${bind_flag}:${sand_p}"

    [[ -n "${EXTRA_BIND_DEST_SET[${bind_key}]:-}" ]] && return 0
    EXTRA_BIND_DEST_SET["${bind_key}"]=1
    EXTRA_BINDS+=("${bind_flag}" "${host_p}" "${sand_p}")
}

add_prepared_bind_once() {
    local bind_flag="$1"
    local host_p="$2"
    local sand_p="$3"
    local resolved_host_p
    local bind_key="${bind_flag}:${sand_p}"

    [[ -n "${EXTRA_BIND_DEST_SET[${bind_key}]:-}" ]] && return 0
    resolve_bind_source_path "${host_p}"
    resolved_host_p="${REPLY}"
    EXTRA_BIND_DEST_SET["${bind_key}"]=1
    add_parent_dirs_once "$(dirname "${sand_p}")"
    if [[ -d "${resolved_host_p}" ]]; then
        EXTRA_BINDS+=(--dir "${sand_p}")
    fi
    EXTRA_BINDS+=("${bind_flag}" "${resolved_host_p}" "${sand_p}")
}

add_sandbox_env_once() {
    local env_name="$1"
    local env_value="$2"

    [[ -n "${SANDBOX_ENV_SET[${env_name}]:-}" ]] && return 0
    SANDBOX_ENV_SET["${env_name}"]=1
    SANDBOX_ENVS+=(--setenv "${env_name}" "${env_value}")
}

map_host_path_to_sandbox() {
    local host_path="$1"
    if is_path_within "${HOST_HOME}" "${host_path}"; then
        REPLY="${SANDBOX_HOME}${host_path#"${HOST_HOME}"}"
        return
    fi
    REPLY="${host_path}"
}

bind_runtime_dir_precreated() {
    local host_p="$1"
    local sand_p="$2"
    local resolved_host_p

    resolve_bind_source_path "${host_p}"
    resolved_host_p="${REPLY}"
    add_parent_dirs_once "$(dirname "${sand_p}")"
    add_extra_bind_once --bind "${resolved_host_p}" "${sand_p}"
}

bind_runtime_dir() {
    local host_p="$1"
    local sand_p="$2"

    mkdir -p -- "${host_p}"
    bind_runtime_dir_precreated "${host_p}" "${sand_p}"
}

bind_prepared_runtime_dir() {
    local host_p="$1"
    local sand_p="$2"

    mkdir -p -- "${host_p}"
    add_prepared_bind_once --bind "${host_p}" "${sand_p}"
}

bind_runtime_path_precreated() {
    local host_p="$1"
    local sand_p="$2"
    local resolved_host_p

    [[ -e "${host_p}" ]] || return 0
    resolve_bind_source_path "${host_p}"
    resolved_host_p="${REPLY}"
    add_parent_dirs_once "$(dirname "${sand_p}")"
    add_extra_bind_once --bind "${resolved_host_p}" "${sand_p}"
}

opt_ro_bind_path() {
    local host_p="$1"
    local sand_p="$2"
    local resolved_host_p

    [[ -e "${host_p}" ]] || return 0
    resolve_bind_source_path "${host_p}"
    resolved_host_p="${REPLY}"
    add_parent_dirs_once "$(dirname "${sand_p}")"
    add_extra_bind_once --ro-bind "${resolved_host_p}" "${sand_p}"
}

opt_ro_bind_dir() {
    local host_p="$1"
    local sand_p="$2"

    [[ -d "${host_p}" ]] || return 0
    opt_ro_bind_path "${host_p}" "${sand_p}"
}

opt_ro_bind_global_skills() {
    local host_skills="${HOST_HOME}/.agents/skills"
    local project_skills="${PROJECT_SOURCE_DIR}/.agents/skills"
    local resolved_host_skills=""
    local resolved_project_skills=""

    [[ -d "${host_skills}" ]] || return 0

    resolved_host_skills="$(realpath "${host_skills}" 2>/dev/null || true)"
    if [[ -d "${project_skills}" ]]; then
        resolved_project_skills="$(realpath "${project_skills}" 2>/dev/null || true)"
    fi

    if [[ -n "${resolved_host_skills}" && "${resolved_host_skills}" == "${resolved_project_skills}" ]]; then
        info "Skipping ~/.agents/skills bind; it resolves to project .agents/skills already exposed by the target"
        return 0
    fi

    opt_ro_bind_dir "${host_skills}" "${SANDBOX_HOME}/.agents/skills"
}

bind_pi_xdg_resources() {
    local host_config_pi="${XDG_CONFIG_HOME:-${HOST_HOME}/.config}/pi"
    local host_data_pi="${XDG_DATA_HOME:-${HOST_HOME}/.local/share}/pi"
    local host_state_pi="${XDG_STATE_HOME:-${HOST_HOME}/.local/state}/pi"
    local host_cache_pi="${XDG_CACHE_HOME:-${HOST_HOME}/.cache}/pi"
    local sand_config_pi="${SANDBOX_CONFIG_DIR}/pi"
    local sand_data_pi="${SANDBOX_LOCAL_SHARE_DIR}/pi"
    local sand_state_pi="${SANDBOX_LOCAL_STATE_DIR}/pi"
    local sand_cache_pi="${SANDBOX_CACHE_DIR}/pi"

    add_sandbox_env_once XDG_CONFIG_HOME "${SANDBOX_CONFIG_DIR}"
    add_sandbox_env_once XDG_DATA_HOME "${SANDBOX_LOCAL_SHARE_DIR}"
    add_sandbox_env_once XDG_STATE_HOME "${SANDBOX_LOCAL_STATE_DIR}"
    add_sandbox_env_once XDG_CACHE_HOME "${SANDBOX_CACHE_DIR}"

    if [[ "${ALLOW_PI_CONFIG}" -eq 1 ]]; then
        [[ -d "${host_config_pi}" ]] && bind_runtime_dir "${host_config_pi}" "${sand_config_pi}"
        [[ -d "${host_data_pi}" ]] && bind_runtime_dir "${host_data_pi}" "${sand_data_pi}"
    else
        opt_ro_bind_dir "${host_config_pi}" "${sand_config_pi}"
        opt_ro_bind_dir "${host_data_pi}" "${sand_data_pi}"
    fi

    bind_runtime_dir "${host_state_pi}" "${sand_state_pi}"
    bind_runtime_dir "${host_cache_pi}" "${sand_cache_pi}"
}

bind_pi_agent_resource_paths() {
    local resource_path
    local host_p
    local sand_p

    for resource_path in "${PI_AGENT_RO_PATHS[@]}"; do
        host_p="${PI_AGENT_DIR}/${resource_path}"
        sand_p="${SANDBOX_PI_AGENT_DIR}/${resource_path}"
        [[ -e "${host_p}" ]] || continue
        add_prepared_bind_once --ro-bind "${host_p}" "${sand_p}"
    done

    for resource_path in "${PI_AGENT_MUTABLE_ROOT_FILES[@]}"; do
        host_p="${PI_AGENT_DIR}/${resource_path}"
        sand_p="${SANDBOX_PI_AGENT_DIR}/${resource_path}"
        [[ -e "${host_p}" ]] || continue
        add_prepared_bind_once --bind "${host_p}" "${sand_p}"
    done
}

bind_pi_agent_tmpfs_root() {
    add_parent_dirs_once "$(dirname "${SANDBOX_PI_AGENT_DIR}")"
    EXTRA_BINDS+=(--tmpfs "${SANDBOX_PI_AGENT_DIR}")
}

bind_footer_xdg_resources() {
    local host_config_home="${XDG_CONFIG_HOME:-${HOST_HOME}/.config}"
    local host_cache_home="${XDG_CACHE_HOME:-${HOST_HOME}/.cache}"

    # Pi-compatible OpenCode footer/status integrations load their plugin config
    # and OpenSpec metadata through XDG config/cache paths. Expose only the
    # read-only config trees and cached package code needed for those resources;
    # do not expose OpenCode data/state such as auth, sessions, DBs, or logs.
    opt_ro_bind_dir "${host_config_home}/opencode" "${SANDBOX_CONFIG_DIR}/opencode"
    opt_ro_bind_dir "${host_config_home}/openspec" "${SANDBOX_CONFIG_DIR}/openspec"
    opt_ro_bind_dir "${host_cache_home}/opencode/packages" "${SANDBOX_CACHE_DIR}/opencode/packages"
}

bind_nearest_project_openspec() {
    local logical_search_dir
    local resolved_logical_search_dir
    local resolved_source_search_dir
    local openspec_dir
    local logical_openspec_dir
    local source_openspec_dir

    if [[ "${TARGET_KIND}" == "dir" ]]; then
        logical_search_dir="${TARGET_PATH}"
    else
        logical_search_dir="${TARGET_PARENT_DIR}"
    fi

    while [[ -n "${logical_search_dir}" && "${logical_search_dir}" != "/" ]]; do
        openspec_dir="${logical_search_dir}/openspec"
        if is_project_openspec_dir "${openspec_dir}"; then
            resolve_project_openspec_source "${openspec_dir}"
            source_openspec_dir="${REPLY}"
            # If OpenSpec is inside the primary project bind, normal protected
            # control-dir overlays handle it. Nested targets need the nearest
            # sibling/ancestor OpenSpec tree exposed explicitly for Pi footer
            # parity, without exposing the rest of that parent directory.
            if [[ "${logical_search_dir}" != "${PROJECT_DIR}" ]]; then
                add_prepared_bind_once --ro-bind "${source_openspec_dir}" "${openspec_dir}"
                info "OpenSpec footer: mounted nearest project-local openspec/ read-only"
            fi
            if [[ "${source_openspec_dir}" != "${openspec_dir}" ]]; then
                add_prepared_bind_once --ro-bind "${source_openspec_dir}" "${source_openspec_dir}"
                info "OpenSpec footer: mounted resolved project-local openspec/ read-only"
            fi
            return 0
        fi
        logical_search_dir="$(dirname "${logical_search_dir}")"
    done

    if [[ "${TARGET_SOURCE_PATH}" == "${TARGET_PATH}" ]]; then
        return 0
    fi

    if [[ "${TARGET_KIND}" == "dir" ]]; then
        resolved_logical_search_dir="${TARGET_PATH}"
        resolved_source_search_dir="${TARGET_SOURCE_PATH}"
    else
        resolved_logical_search_dir="${TARGET_PARENT_DIR}"
        resolved_source_search_dir="${TARGET_SOURCE_PARENT_DIR}"
    fi

    while [[ -n "${resolved_source_search_dir}" && "${resolved_source_search_dir}" != "/" && \
        -n "${resolved_logical_search_dir}" && "${resolved_logical_search_dir}" != "/" ]]; do
        source_openspec_dir="${resolved_source_search_dir}/openspec"
        logical_openspec_dir="${resolved_logical_search_dir}/openspec"
        if is_project_openspec_dir "${source_openspec_dir}"; then
            add_prepared_bind_once --ro-bind "${source_openspec_dir}" "${logical_openspec_dir}"
            if [[ "${source_openspec_dir}" != "${logical_openspec_dir}" ]]; then
                add_prepared_bind_once --ro-bind "${source_openspec_dir}" "${source_openspec_dir}"
            fi
            info "OpenSpec footer: mounted resolved nearest project-local openspec/ read-only"
            return 0
        fi
        resolved_source_search_dir="$(dirname "${resolved_source_search_dir}")"
        resolved_logical_search_dir="$(dirname "${resolved_logical_search_dir}")"
    done
}

is_project_openspec_dir() {
    local openspec_dir="$1"

    [[ -d "${openspec_dir}" ]] || return 1
    [[ -d "${openspec_dir}/changes" || -d "${openspec_dir}/specs" ]]
}

resolve_project_openspec_source() {
    local openspec_dir="$1"
    local child
    local resolved_child
    local candidate

    for child in changes specs; do
        if [[ -L "${openspec_dir}/${child}" ]]; then
            resolved_child="$(realpath "${openspec_dir}/${child}" 2>/dev/null || true)"
            [[ -n "${resolved_child}" ]] || continue
            candidate="$(dirname "${resolved_child}")"
            if is_project_openspec_dir "${candidate}"; then
                REPLY="${candidate}"
                return 0
            fi
        fi
    done

    REPLY="${openspec_dir}"
}

is_safe_pi_socket_env_name() {
    local env_name="$1"

    case "${env_name}" in
    PI_*SOCKET*) ;;
    *) return 1 ;;
    esac
    case "${env_name}" in
    *AUTH* | *TOKEN* | *SECRET* | *CREDENTIAL* | *PASSWORD* | *KEY* | *SSH* | *GPG*) return 1 ;;
    esac
    case "${env_name}" in
    *STATUS* | *TASK* | *TODO* | *PLAN* | *JOB* | *RUN* | *UI* | *FOOTER*) return 0 ;;
    *) return 1 ;;
    esac
}

is_safe_pi_socket_path() {
    local host_p="$1"
    local runtime_root="${XDG_RUNTIME_DIR:-}"

    [[ "${host_p}" == /* ]] || return 1
    [[ -S "${host_p}" ]] || return 1
    if [[ -n "${runtime_root}" && "${runtime_root}" == /* ]] && is_path_within "${runtime_root}" "${host_p}"; then
        return 0
    fi
    is_path_within /tmp "${host_p}"
}

bind_pi_socket_envs() {
    local env_name
    local env_output
    local host_p
    local sand_p

    env_output="$(compgen -e || true)"
    while IFS= read -r env_name; do
        [[ -n "${env_name}" ]] || continue
        is_safe_pi_socket_env_name "${env_name}" || continue
        host_p="${!env_name:-}"
        is_safe_pi_socket_path "${host_p}" || continue
        map_host_path_to_sandbox "${host_p}"
        sand_p="${REPLY}"
        bind_runtime_dir_precreated "${host_p}" "${sand_p}"
        add_sandbox_env_once "${env_name}" "${sand_p}"
        info "Pi integration: mounted exact ${env_name} socket"
    done <<<"${env_output}"
}

bind_pi_binary_package_tree() {
    local pi_bin_real="$1"
    local candidate
    local resolved_candidate
    local sand_candidate
    local -a pnpm_home_candidates=()

    if [[ -n "${PNPM_HOME:-}" && "${PNPM_HOME}" == /* ]]; then
        pnpm_home_candidates+=("${PNPM_HOME}")
    fi
    if [[ -n "${XDG_DATA_HOME:-}" && "${XDG_DATA_HOME}" == /* ]]; then
        pnpm_home_candidates+=("${XDG_DATA_HOME}/pnpm")
    fi
    pnpm_home_candidates+=("${HOST_HOME}/.local/share/pnpm")

    for candidate in "${pnpm_home_candidates[@]}"; do
        [[ -d "${candidate}" ]] || continue
        resolved_candidate="$(realpath "${candidate}" 2>/dev/null || true)"
        [[ -n "${resolved_candidate}" ]] || continue
        is_path_within "${resolved_candidate}" "${pi_bin_real}" || continue

        sand_candidate="${candidate}"
        opt_ro_bind_dir "${candidate}" "${sand_candidate}"
        info "Pi integration: mounted pnpm package tree read-only for Pi executable"
        return 0
    done

    return 1
}

add_custom_bind() {
    local bind_flag="$1"
    local requested_path="$2"
    local resolved_path

    if [[ ! -e "${requested_path}" ]]; then
        error "added path does not exist: ${requested_path}"
        exit 1
    fi
    resolved_path="$(realpath "${requested_path}")"
    add_parent_dirs_once "$(dirname "${resolved_path}")"
    SAFE_BINDS+=("${bind_flag}" "${resolved_path}" "${resolved_path}")
}

resolve_target_mode() {
    local requested_target="$1"
    local logical_target
    local resolved_target

    if [[ ! -e "${requested_target}" ]]; then
        error "target path does not exist: ${requested_target}"
        exit 1
    fi

    if [[ "${requested_target}" == /* ]]; then
        logical_target="${requested_target}"
    else
        logical_target="${PWD}/${requested_target}"
    fi
    resolved_target="$(realpath "${requested_target}")"
    if [[ -d "${resolved_target}" ]]; then
        TARGET_KIND="dir"
        TARGET_PATH="${logical_target}"
        TARGET_SOURCE_PATH="${resolved_target}"
        TARGET_PARENT_DIR="$(dirname "${logical_target}")"
        TARGET_SOURCE_PARENT_DIR="$(dirname "${resolved_target}")"
        return
    fi
    if [[ -f "${resolved_target}" ]]; then
        TARGET_KIND="file"
        TARGET_PATH="${logical_target}"
        TARGET_SOURCE_PATH="${resolved_target}"
        TARGET_PARENT_DIR="$(dirname "${logical_target}")"
        TARGET_SOURCE_PARENT_DIR="$(dirname "${resolved_target}")"
        return
    fi

    error "target must be a directory or regular file: ${requested_target}"
    exit 1
}

resolve_backend() {
    case "${BACKEND}" in
    auto)
        if [[ "$(uname -s 2>/dev/null || printf unknown)" != "Linux" ]] || ! command -v bwrap >/dev/null 2>&1; then
            error "auto backend requires Linux and bubblewrap; refusing to run pi without a sandbox"
            exit 1
        fi
        BACKEND="bwrap"
        ;;
    bwrap)
        if [[ "$(uname -s 2>/dev/null || printf unknown)" != "Linux" ]]; then
            error "bubblewrap backend requires Linux"
            exit 1
        fi
        if ! command -v bwrap >/dev/null 2>&1; then
            error "bubblewrap (bwrap) not found in PATH"
            error "install bubblewrap, or rerun only after another supported backend exists"
            exit 1
        fi
        ;;
    gondolin)
        error "Gondolin backend is not implemented in spi ${PROGRAM_VERSION}; use --backend bwrap on Linux"
        error "Gondolin is tracked as inspiration only, so spi fails closed instead of running plain pi"
        exit 1
        ;;
    *)
        error "unknown backend: ${BACKEND} (expected auto, bwrap, gondolin)"
        exit 1
        ;;
    esac
}

check_bwrap_namespace_support() {
    local probe_output
    local -a probe_cmd

    if [[ "${SPI_FORCE_PROBE:-0}" == "1" ]]; then
        return 0
    fi

    probe_cmd=(
        bwrap
        --unshare-user-try
        --ro-bind /usr /usr
        --ro-bind /bin /bin
        --ro-bind /lib /lib
        --proc /proc
        --dev /dev
    )
    [[ -d /lib64 ]] && probe_cmd+=(--ro-bind /lib64 /lib64)
    probe_cmd+=(-- /bin/sh -c 'exit 0')

    if probe_output="$("${probe_cmd[@]}" 2>&1)"; then
        return 0
    fi

    case "${probe_output}" in
    *"Creating new namespace failed"* | *"max_"*"_namespaces exceeded"* | *"(ENOSPC)"*)
        error "bubblewrap cannot create the namespaces spi needs in this environment"
        error "run spi from a normal host shell or enable unprivileged user namespaces"
        return 1
        ;;
    esac

    error "bubblewrap namespace probe failed: ${probe_output}"
    return 1
}

discover_pi_binary() {
    PI_BIN_HOST="$(command -v "${PI_BIN}" 2>/dev/null || true)"
    if [[ -z "${PI_BIN_HOST}" ]]; then
        error "pi binary not found: ${PI_BIN}"
        exit 1
    fi
    if [[ ! -x "${PI_BIN_HOST}" ]]; then
        error "pi binary is not executable: ${PI_BIN_HOST}"
        exit 1
    fi

    PI_BIN_REAL="$(realpath "${PI_BIN_HOST}")"
    PI_BIN_SANDBOX="${PI_BIN_REAL}"

    add_parent_dirs_once "$(dirname "${PI_BIN_REAL}")"
    case "${PI_BIN_REAL}" in
    /usr/* | /bin/* | /sbin/*) ;;
    *)
        if ! bind_pi_binary_package_tree "${PI_BIN_REAL}"; then
            add_extra_bind_once --ro-bind "${PI_BIN_REAL}" "${PI_BIN_REAL}"
        fi
        ;;
    esac
}

discover_git_wrapper() {
    local script_dir

    script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
    SCODER_GIT_HOST="${SCODER_GIT:-${script_dir}/scoder-git}"
    if [[ ! -x "${SCODER_GIT_HOST}" ]]; then
        error "scoder-git wrapper not found or not executable: ${SCODER_GIT_HOST}"
        exit 1
    fi
    SCODER_GIT_HOST="$(realpath "${SCODER_GIT_HOST}")"

    REAL_GIT_HOST="$(command -v git 2>/dev/null || true)"
    if [[ -z "${REAL_GIT_HOST}" || ! -x "${REAL_GIT_HOST}" ]]; then
        error "real git binary not found in host PATH"
        exit 1
    fi
    REAL_GIT_HOST="$(realpath "${REAL_GIT_HOST}")"
}

opt_ro_bind_terminal_file() {
    local host_p="$1"
    local sand_p="$2"
    local label="$3"

    [[ -e "${host_p}" ]] || return 0
    opt_ro_bind_path "${host_p}" "${sand_p}"
    info "Terminal integration: mounted ${label} read-only"
}

bind_zsh_startup_files() {
    local host_dir="$1"
    local sand_dir="$2"
    local zsh_file
    local -a zsh_startup_files=(.zshenv .zshrc .zprofile .zlogin)

    for zsh_file in "${zsh_startup_files[@]}"; do
        opt_ro_bind_terminal_file "${host_dir}/${zsh_file}" "${sand_dir}/${zsh_file}" "${zsh_file}"
    done
}

bind_terminal_socket_path() {
    local env_name="$1"
    local host_p="$2"
    local sand_p

    if [[ -z "${host_p}" ]]; then
        return 1
    fi
    case "${host_p}" in
    /*) ;;
    *)
        warning "not forwarding ${env_name}; socket path is not absolute: ${host_p}"
        return 1
        ;;
    esac
    if [[ ! -S "${host_p}" ]]; then
        warning "not forwarding ${env_name}; not an existing Unix socket: ${host_p}"
        return 1
    fi

    map_host_path_to_sandbox "${host_p}"
    sand_p="${REPLY}"
    bind_runtime_dir_precreated "${host_p}" "${sand_p}"
    info "Terminal integration: mounted ${env_name} socket ${host_p}"
    REPLY="${sand_p}"
}

bind_terminal_socket_env() {
    local env_name="$1"
    local host_p="${!env_name:-}"
    local sand_p

    bind_terminal_socket_path "${env_name}" "${host_p}" || return 0
    sand_p="${REPLY}"
    add_sandbox_env_once "${env_name}" "${sand_p}"
}

bind_tmux_socket_env() {
    local tmux_value="${TMUX:-}"
    local tmux_socket
    local tmux_suffix
    local sand_socket

    [[ -n "${tmux_value}" ]] || return 0
    tmux_socket="${tmux_value%%,*}"
    tmux_suffix="${tmux_value#"${tmux_socket}"}"

    bind_terminal_socket_path TMUX "${tmux_socket}" || return 0
    sand_socket="${REPLY}"
    add_sandbox_env_once TMUX "${sand_socket}${tmux_suffix}"
    if [[ -n "${TMUX_PANE:-}" ]]; then
        add_sandbox_env_once TMUX_PANE "${TMUX_PANE}"
    fi
}

bind_terminal_integration() {
    local xdg_starship=""
    local sand_xdg_starship=""
    local zdotdir_sandbox=""

    opt_ro_bind_terminal_file "${HOST_HOME}/.config/starship.toml" "${SANDBOX_HOME}/.config/starship.toml" starship.toml

    if [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
        xdg_starship="${XDG_CONFIG_HOME}/starship.toml"
        map_host_path_to_sandbox "${xdg_starship}"
        sand_xdg_starship="${REPLY}"
        opt_ro_bind_terminal_file "${xdg_starship}" "${sand_xdg_starship}" XDG_CONFIG_HOME/starship.toml
    fi

    bind_zsh_startup_files "${HOST_HOME}" "${SANDBOX_HOME}"
    if [[ -n "${ZDOTDIR:-}" ]]; then
        if [[ "${ZDOTDIR}" == /* ]] && is_path_within "${HOST_HOME}" "${ZDOTDIR}"; then
            map_host_path_to_sandbox "${ZDOTDIR}"
            zdotdir_sandbox="${REPLY}"
            bind_zsh_startup_files "${ZDOTDIR}" "${zdotdir_sandbox}"
        else
            warning "not mounting ZDOTDIR; it is outside HOME or not absolute: ${ZDOTDIR}"
        fi
    fi

    bind_terminal_socket_env NVIM
    bind_terminal_socket_env NVIM_LISTEN_ADDRESS
    bind_tmux_socket_env
}

is_stale_workspace_env_name() {
    local env_name="$1"

    case "${env_name}" in
    OPENCODE_API_KEY)
        return 1
        ;;
    OPENCODE*)
        return 0
        ;;
    NVIM_OPENCODE_PORT | NVIM_LOG_FILE | NVIM_THEME_COLOR | \
        USER_PREFIX | TMUX_WORKSPACE_ROOT | GALACTICA_HOME | MYVIMRC)
        return 0
        ;;
    *)
        return 1
        ;;
    esac
}

inherit_safe_environment() {
    local env_name
    local env_output
    env_output="$(compgen -e || true)"
    while IFS= read -r env_name; do
        is_stale_workspace_env_name "${env_name}" && continue
        case "${env_name}" in
        HOME | PATH | PWD | OLDPWD | SHELL | SHLVL | _ | USER | LOGNAME | TERM | COLORTERM | LANG | LC_ALL | \
            XDG_CONFIG_HOME | XDG_DATA_HOME | XDG_STATE_HOME | XDG_CACHE_HOME | \
            PI_BIN | PI_CODING_AGENT_DIR | PI_SESSION_* | PI_PROVIDER | PI_MODEL | PI_REASONING_LEVEL | \
            PI_*SOCKET* | \
            SPI_* | TMPDIR | GIT_OPTIONAL_LOCKS | SSH_AUTH_SOCK | \
            NVIM | NVIM_LISTEN_ADDRESS | TMUX | TMUX_PANE)
            ;;
        *)
            if [[ -n "${!env_name:-}" ]]; then
                BWRAP_CMD+=(--setenv "${env_name}" "${!env_name}")
            fi
            ;;
        esac
    done <<<"${env_output}"
}

preserve_pi_session_environment() {
    local env_name
    local env_output

    env_output="$(compgen -e || true)"
    while IFS= read -r env_name; do
        case "${env_name}" in
        PI_SESSION_* | PI_PROVIDER | PI_MODEL | PI_REASONING_LEVEL)
            if [[ -n "${!env_name:-}" ]]; then
                add_sandbox_env_once "${env_name}" "${!env_name}"
            fi
            ;;
        esac
    done <<<"${env_output}"
}

run_doctor() {
    local status=0

    printf 'SPI doctor\n'
    printf '  backend requested: %s\n' "${BACKEND}"
    if [[ "$(uname -s 2>/dev/null || printf unknown)" == "Linux" ]]; then
        printf '  host OS: Linux\n'
    else
        printf '  host OS: unsupported (%s)\n' "$(uname -s 2>/dev/null || printf unknown)"
        status=1
    fi
    if command -v bwrap >/dev/null 2>&1; then
        printf '  bwrap: %s (%s)\n' "$(command -v bwrap)" "$(bwrap --version 2>/dev/null || printf unknown)"
    else
        printf '  bwrap: missing\n'
        status=1
    fi
    if command -v "${PI_BIN}" >/dev/null 2>&1; then
        printf '  pi: %s\n' "$(command -v "${PI_BIN}")"
    else
        printf '  pi: missing (%s)\n' "${PI_BIN}"
        status=1
    fi
    printf '  Pi state root: %s%s\n' "${PI_AGENT_DIR}" "$([[ "${PI_AGENT_DIR_FROM_ENV}" -eq 1 ]] && printf ' (from PI_CODING_AGENT_DIR)' || printf ' (Pi default)')"
    if [[ "${ALLOW_PI_CONFIG}" -eq 1 ]]; then
        printf '  Pi mount mode: full ~/.pi writable by explicit --allow-pi-config opt-in\n'
    else
        printf '  Pi mount mode: role-based; existing ~/.pi read-only with writable agent root and selected runtime/state dirs\n'
        printf '  Pi writable agent root: %s (settings/trust JSON and lock dirs)\n' "${PI_AGENT_DIR}"
        printf '  Pi writable runtime dirs: %s\n' "${PI_RUNTIME_WRITABLE_LABEL}"
        printf '  Pi read-only resources: ~/.pi config/resources, ~/.pi/agent packages/extensions/prompts/skills/themes/keybindings, future ~/.config/pi and ~/.local/share/pi, plus ~/.agents/skills when present\n'
        printf '  Pi writable XDG runtime/state: ~/.local/state/pi and ~/.cache/pi or XDG overrides\n'
    fi
    printf '  Project .pi/.agents protection: read-only by default with other control-plane paths\n'
    printf '  Pi env preservation: PI_SESSION_*, PI_PROVIDER, PI_MODEL, PI_REASONING_LEVEL when set\n'
    printf '  Gondolin: unsupported placeholder; fail-closed\n'

    return "${status}"
}

validation_pass() {
    printf '✅ %s\n' "$1"
}

validation_fail() {
    printf '❌ %s\n' "$1"
}

validation_warn() {
    printf '⚠️  %s\n' "$1"
}

run_validation() {
    local script_path="$0"
    local script_dir
    local validation_root
    local test_home
    local test_project
    local direct_openspec_project
    local symlink_source_project
    local symlink_logical_project
    local neighbor_dir
    local shared_ro_dir
    local shared_rw_dir
    local terminal_xdg_config_home
    local terminal_zdotdir
    local terminal_runtime_dir
    local terminal_runtime_marker
    local terminal_nvim_socket
    local terminal_nvim_listen_socket
    local terminal_tmux_socket
    local target_file_path
    local sibling_file_path
    local failed_tests=0
    local live_bwrap=0
    local output
    local external_test
    local external_name
    local external_status
    local neighbor_dir_q
    local shared_ro_dir_q
    local shared_rw_dir_q
    local terminal_runtime_marker_q
    local target_file_path_q
    local sibling_file_path_q
    local project_skill_file_q

    script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
    validation_root="$(mktemp -d "${TMPDIR:-/tmp}/spi-validation.XXXXXX")"
    test_home="${validation_root}/home"
    test_project="${validation_root}/project"
    direct_openspec_project="${validation_root}/direct-openspec"
    symlink_source_project="${validation_root}/symlink-source/.config"
    symlink_logical_project="${test_home}/.config/linked-nvim"
    neighbor_dir="${validation_root}/neighbor"
    shared_ro_dir="${validation_root}/shared-ro"
    shared_rw_dir="${validation_root}/shared-rw"
    terminal_xdg_config_home="${test_home}/xdg-config"
    terminal_zdotdir="${test_home}/.config/zsh"
    terminal_runtime_dir="${validation_root}/runtime"
    terminal_runtime_marker="${terminal_runtime_dir}/marker.txt"
    terminal_nvim_socket="${terminal_runtime_dir}/nvim.sock"
    terminal_nvim_listen_socket="${terminal_runtime_dir}/nvim-listen.sock"
    terminal_tmux_socket="${terminal_runtime_dir}/tmux/default"
    target_file_path="${test_project}/src/lib/target.txt"
    sibling_file_path="${test_project}/src/lib/sibling.txt"
    printf -v neighbor_dir_q '%q' "${neighbor_dir}"
    printf -v shared_ro_dir_q '%q' "${shared_ro_dir}"
    printf -v shared_rw_dir_q '%q' "${shared_rw_dir}"
    printf -v terminal_runtime_marker_q '%q' "${terminal_runtime_marker}"
    printf -v target_file_path_q '%q' "${target_file_path}"
    printf -v sibling_file_path_q '%q' "${sibling_file_path}"
    printf -v project_skill_file_q '%q' "${test_project}/.agents/skills/example/SKILL.md"

    mkdir -p -- \
        "${test_home}/.pi/agent" \
        "${test_home}/.pi/agent/tasks" \
        "${test_home}/.pi/agent/status" \
        "${test_home}/.pi/agent/todos" \
        "${test_home}/.pi/agent/plans" \
        "${test_home}/.pi/agent/jobs" \
        "${test_home}/.pi/agent/runs" \
        "${test_home}/.pi/agent/ui" \
        "${test_home}/.pi/agent/statusline" \
        "${test_home}/.pi/providers" \
        "${test_home}/.pi/models" \
        "${test_home}/.config/pi" \
        "${test_home}/.local/share/pi" \
        "${test_home}/.local/state/pi" \
        "${test_home}/.cache/pi" \
        "${test_home}/.agents/skills/example" \
        "${test_home}/.local/bin" \
        "${test_home}/.config" \
        "${terminal_xdg_config_home}" \
        "${terminal_zdotdir}" \
        "${test_home}/.pi" \
        "${test_project}/.git" \
        "${test_project}/.agents/skills/example" \
        "${test_project}/.pi" \
        "${test_project}/node_modules" \
        "${test_project}/src/lib" \
        "${direct_openspec_project}/openspec/changes/direct-validation" \
        "${direct_openspec_project}/openspec/specs" \
        "${direct_openspec_project}/.pi/prompts" \
        "${validation_root}/nested-parent/nvim" \
        "${validation_root}/nested-parent/openspec/changes/nested-validation" \
        "${symlink_source_project}/nvim" \
        "${symlink_source_project}/openspec/changes/symlink-validation" \
        "$(dirname -- "${terminal_tmux_socket}")" \
        "${neighbor_dir}"
    ln -s "${symlink_source_project}/nvim" "${symlink_logical_project}"
    printf 'original-pi-config\n' >"${test_home}/.pi/config"
    printf '{"theme":"original"}\n' >"${test_home}/.pi/agent/settings.json"
    printf '{"trusted":false}\n' >"${test_home}/.pi/agent/trust.json"
    printf 'provider-catalog\n' >"${test_home}/.pi/providers/catalog.txt"
    printf 'model-catalog\n' >"${test_home}/.pi/models/catalog.txt"
    printf 'pi-xdg-config\n' >"${test_home}/.config/pi/config.toml"
    printf 'pi-xdg-data\n' >"${test_home}/.local/share/pi/resource.txt"
    printf 'skill-resource\n' >"${test_home}/.agents/skills/example/SKILL.md"
    printf 'project-skill-resource\n' >"${test_project}/.agents/skills/example/SKILL.md"
    printf "format = \"\$directory\"\n" >"${test_home}/.config/starship.toml"
    printf "format = \"\$character\"\n" >"${terminal_xdg_config_home}/starship.toml"
    printf 'validation-zshenv\n' >"${test_home}/.zshenv"
    printf 'validation-zshrc\n' >"${test_home}/.zshrc"
    printf 'validation-zdotdir-zshrc\n' >"${terminal_zdotdir}/.zshrc"
    printf 'runtime-marker\n' >"${terminal_runtime_marker}"
    printf 'neighbor-secret\n' >"${neighbor_dir}/secret.txt"
    printf 'SPI_VALIDATION=1\n' >"${test_project}/.env"
    printf 'ignored\n' >"${test_project}/.gitignore"
    printf 'project-pi-original\n' >"${test_project}/.pi/original.txt"
    printf 'schema: spec-driven\n' >"${direct_openspec_project}/openspec/config.yaml"
    printf 'schema: spec-driven\ncreated: 2026-08-04\n' >"${direct_openspec_project}/openspec/changes/direct-validation/.openspec.yaml"
    printf 'direct-pi-prompt\n' >"${direct_openspec_project}/.pi/prompts/opsx-propose.md"
    printf 'alpha\n' >"${target_file_path}"
    printf 'beta\n' >"${sibling_file_path}"
    printf 'nested-openspec\n' >"${validation_root}/nested-parent/openspec/changes/nested-validation/tasks.md"
    printf 'symlink-openspec\n' >"${symlink_source_project}/openspec/changes/symlink-validation/tasks.md"
    printf '%s\n' '#!/usr/bin/env bash' 'printf host-tool-ok' >"${test_home}/.local/bin/spi-host-tool"
    chmod +x "${test_home}/.local/bin/spi-host-tool"
    mkdir -p -- "${shared_ro_dir}" "${shared_rw_dir}"
    printf 'shared-ro\n' >"${shared_ro_dir}/note.txt"
    printf 'shared-rw\n' >"${shared_rw_dir}/note.txt"
    if command -v python3 >/dev/null 2>&1; then
        python3 - "${terminal_nvim_socket}" "${terminal_nvim_listen_socket}" "${terminal_tmux_socket}" <<'PY'
import os
import socket
import sys

for path in sys.argv[1:]:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    sock = socket.socket(socket.AF_UNIX)
    sock.bind(path)
    sock.close()
PY
    fi

    printf 'SPI validation\n'

    if command -v bwrap >/dev/null 2>&1; then
        validation_pass "Test 0.1 PASS: bwrap found at $(command -v bwrap)"
        if check_bwrap_namespace_support; then
            validation_pass 'Test 0.2 PASS: bwrap namespace probe succeeded'
            live_bwrap=1
        else
            validation_fail 'Test 0.2 FAIL: bwrap namespace probe failed'
            failed_tests=$((failed_tests + 1))
        fi
    else
        validation_fail 'Test 0.1 FAIL: bwrap not found'
        failed_tests=$((failed_tests + 1))
    fi

    if [[ -x /bin/true ]]; then
        validation_pass 'Test 0.3 PASS: safe fake Pi binary is available at /bin/true'
    else
        validation_fail 'Test 0.3 FAIL: /bin/true is not executable'
        failed_tests=$((failed_tests + 1))
        live_bwrap=0
    fi

    run_validation_spi_with_home() {
        local sandbox_home="$1"
        local sandbox_agent_dir="$2"
        local sandbox_xdg_config_home="${SPI_VALIDATION_XDG_CONFIG_HOME:-${sandbox_home}/.config}"
        local sandbox_xdg_data_home="${SPI_VALIDATION_XDG_DATA_HOME:-${sandbox_home}/.local/share}"
        local sandbox_xdg_state_home="${SPI_VALIDATION_XDG_STATE_HOME:-${sandbox_home}/.local/state}"
        local sandbox_xdg_cache_home="${SPI_VALIDATION_XDG_CACHE_HOME:-${sandbox_home}/.cache}"
        shift 2

        env \
            HOME="${sandbox_home}" \
            PATH="${PATH}" \
            XDG_CONFIG_HOME="${sandbox_xdg_config_home}" \
            XDG_DATA_HOME="${sandbox_xdg_data_home}" \
            XDG_STATE_HOME="${sandbox_xdg_state_home}" \
            XDG_CACHE_HOME="${sandbox_xdg_cache_home}" \
            USER="${USER:-aemonge}" \
            LOGNAME="${LOGNAME:-${USER:-aemonge}}" \
            TERM="${TERM:-xterm-256color}" \
            LANG="${LANG:-C.UTF-8}" \
            PI_BIN=/bin/true \
            PI_CODING_AGENT_DIR="${sandbox_agent_dir}" \
            SPI_FORCE_PROBE=1 \
            "${script_path}" "$@"
    }

    run_validation_spi() {
        run_validation_spi_with_home "${test_home}" "${test_home}/.pi/agent" "$@"
    }

    run_spi_terminal_fixture() {
        SPI_VALIDATION_XDG_CONFIG_HOME="${terminal_xdg_config_home}" \
            ZDOTDIR="${terminal_zdotdir}" \
            NVIM="${terminal_nvim_socket}" \
            NVIM_LISTEN_ADDRESS="${terminal_nvim_listen_socket}" \
            TMUX="${terminal_tmux_socket},777,0" \
            TMUX_PANE="%7" \
            run_validation_spi "$@"
    }

    if [[ "${live_bwrap}" -eq 1 ]]; then
        # shellcheck disable=SC2016 # $HOME must expand inside the sandboxed shell.
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf "%s" "$HOME"' 2>&1 || true)"
        if [[ "${output}" == "${test_home}" ]]; then
            validation_pass 'Test A.1 PASS: HOME mirrors host home path on tmpfs'
        else
            validation_fail "Test A.1 FAIL: HOME is ${output} (expected ${test_home})"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # $HOME must expand inside the sandboxed shell.
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf SPI_TEST > "$HOME/.bashrc"' 2>&1 || true)"
        if [[ ! -e "${test_home}/.bashrc" ]]; then
            validation_pass 'Test A.2 PASS: ~/.bashrc writes do not leak to host'
        else
            validation_fail "Test A.2 FAIL: ~/.bashrc write leaked to host (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'touch /usr/bin/spi-validation-system-write 2>&1' 2>&1 || true)"
        if [[ "${output}" =~ Read-only|Permission\ denied|cannot\ touch|Operation\ not\ permitted ]]; then
            validation_pass 'Test A.3 PASS: system files are read-only'
        else
            validation_fail "Test A.3 FAIL: system file write was not blocked (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        if output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf spi-rw-ok > validation-write.txt && cat validation-write.txt' 2>&1)" &&
            [[ "${output}" == "spi-rw-ok" ]] && [[ -f "${test_project}/validation-write.txt" ]] &&
            [[ "$(<"${test_project}/validation-write.txt")" == "spi-rw-ok" ]]; then
            validation_pass 'Test B.1 PASS: default rw workspace writes persist to target'
        else
            validation_fail "Test B.1 FAIL: default rw workspace write failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap --ro -x /bin/bash --noprofile --norc -lc 'printf nope > ro-blocked.txt' 2>&1 || true)"
        if [[ ! -e "${test_project}/ro-blocked.txt" ]] && [[ "${output}" =~ Read-only|Permission\ denied|cannot\ create|Operation\ not\ permitted ]]; then
            validation_pass 'Test B.2 PASS: --ro blocks workspace writes'
        else
            validation_fail "Test B.2 FAIL: --ro workspace write was not blocked (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        if output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf nm-ok > node_modules/spi-validation && cat node_modules/spi-validation' 2>&1)" &&
            [[ "${output}" == "nm-ok" ]] && [[ -f "${test_project}/node_modules/spi-validation" ]]; then
            validation_pass 'Test B.3 PASS: node_modules is writable when workspace is rw'
        else
            validation_fail "Test B.3 FAIL: node_modules was not writable (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'test -e .env && cat .env' 2>&1 || true)"
        if [[ "${output}" == 'SPI_VALIDATION=1' ]]; then
            validation_pass 'Test B.4 PASS: project .env is visible'
        else
            validation_fail "Test B.4 FAIL: project .env was not visible (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf RAW_OK' 2>&1 || true)"
        if [[ "${output}" == 'RAW_OK' ]]; then
            validation_pass 'Test B.5 PASS: raw commands execute inside sandbox'
        else
            validation_fail "Test B.5 FAIL: raw command output was ${output}"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${validation_root}/nested-parent/nvim" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'task_path="$(dirname "$PWD")/openspec/changes/nested-validation/tasks.md"; cat "$task_path" >/dev/null || exit 1; if printf bad > "$task_path" 2>/dev/null; then printf OPENSPEC_WRITE_ALLOWED; else printf OPENSPEC_RO; fi' 2>&1 || true)"
        if [[ "${output}" == *OPENSPEC_RO* ]] && [[ "${output}" != *OPENSPEC_WRITE_ALLOWED* ]] && \
            [[ "$(<"${validation_root}/nested-parent/openspec/changes/nested-validation/tasks.md")" == 'nested-openspec' ]]; then
            validation_pass 'Test B.7 PASS: nested target sees nearest project OpenSpec read-only'
        else
            validation_fail "Test B.7 FAIL: nested target OpenSpec visibility/policy failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${symlink_logical_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'task_path="$HOME/.config/openspec/changes/symlink-validation/tasks.md"; cat "$task_path" >/dev/null || exit 1; if printf bad > "$task_path" 2>/dev/null; then printf SYMLINK_OPENSPEC_WRITE_ALLOWED; else printf SYMLINK_OPENSPEC_RO; fi' 2>&1 || true)"
        if [[ "${output}" == *SYMLINK_OPENSPEC_RO* ]] && [[ "${output}" != *SYMLINK_OPENSPEC_WRITE_ALLOWED* ]] && \
            [[ "$(<"${symlink_source_project}/openspec/changes/symlink-validation/tasks.md")" == 'symlink-openspec' ]]; then
            validation_pass 'Test B.8 PASS: symlinked config target sees resolved project OpenSpec read-only at logical path'
        else
            validation_fail "Test B.8 FAIL: symlinked config target OpenSpec visibility/policy failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        if command -v openspec >/dev/null 2>&1; then
            output="$(run_validation_spi -- "${direct_openspec_project}" -q --backend bwrap -x node -e 'const {execFileSync}=require("child_process"); const out=execFileSync("openspec",["list","--json"],{cwd:process.cwd(),encoding:"utf8"}); const parsed=JSON.parse(out); if(parsed.changes?.[0]?.name!=="direct-validation") throw new Error(out); if(out.includes("Note: OpenSpec")) throw new Error("telemetry note in stdout"); process.stdout.write("DIRECT_OPENSPEC_JSON_OK")' 2>&1 || true)"
            if [[ "${output}" == 'DIRECT_OPENSPEC_JSON_OK' ]]; then
                validation_pass 'Test B.9 PASS: direct OpenSpec target emits clean JSON for footer parsing'
            else
                validation_fail "Test B.9 FAIL: direct OpenSpec JSON parsing failed (${output})"
                failed_tests=$((failed_tests + 1))
            fi
        else
            printf 'ℹ️  Test B.9 SKIP: openspec unavailable for direct OpenSpec JSON probe\n'
        fi

        # shellcheck disable=SC2016 # $TMPDIR must expand inside the sandboxed shell.
        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'case "$TMPDIR" in /tmp/spi-*) ;; *) printf "bad-path:%s" "$TMPDIR"; exit 1 ;; esac; test -d "$TMPDIR" && test -w "$TMPDIR" && test "$(stat -c %a "$TMPDIR")" = 700 && printf TMPDIR_OK' 2>&1 || true)"
        if [[ "${output}" == 'TMPDIR_OK' ]]; then
            validation_pass 'Test B.6 PASS: TMPDIR points to a private writable /tmp/spi-* directory'
        else
            validation_fail "Test B.6 FAIL: private TMPDIR check failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'command -v spi-host-tool >/dev/null && spi-host-tool' 2>&1 || true)"
        if [[ "${output}" == 'host-tool-ok' ]]; then
            validation_pass 'Test D.1 PASS: ~/.local/bin host tools are exposed on PATH'
        else
            validation_fail "Test D.1 FAIL: ~/.local/bin host tool was not exposed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'grep -q "^nameserver " /etc/resolv.conf && printf RESOLVER_OK' 2>&1 || true)"
        if [[ "${output}" == 'RESOLVER_OK' ]]; then
            validation_pass 'Test D.2 PASS: DNS resolver config is available'
        else
            validation_warn "Test D.2 WARN: DNS resolver config unavailable or unusual (${output})"
        fi

        if command -v timeout >/dev/null 2>&1; then
            output="$(timeout 10s env \
                HOME="${test_home}" \
                PATH="${PATH}" \
                USER="${USER:-aemonge}" \
                LOGNAME="${LOGNAME:-${USER:-aemonge}}" \
                TERM="${TERM:-xterm-256color}" \
                LANG="${LANG:-C.UTF-8}" \
                PI_BIN=/bin/true \
                PI_CODING_AGENT_DIR="${test_home}/.pi/agent" \
                SPI_FORCE_PROBE=1 \
                "${script_path}" -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'getent hosts api.openai.com >/dev/null && printf DNS_OK' 2>&1 || true)"
            if [[ "${output}" == 'DNS_OK' ]]; then
                validation_pass 'Test D.3 PASS: DNS lookup works inside sandbox'
            else
                printf 'ℹ️  Test D.3 SKIP: DNS lookup not guaranteed in this environment (%s)\n' "${output}"
            fi
        else
            printf 'ℹ️  Test D.3 SKIP: timeout unavailable for bounded DNS probe\n'
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf nope > .git/spi-blocked' 2>&1 || true)"
        if [[ ! -e "${test_project}/.git/spi-blocked" ]] && [[ "${output}" =~ Read-only|Permission\ denied|cannot\ create|Operation\ not\ permitted ]]; then
            validation_pass 'Test C.1 PASS: .git is protected read-only by default'
        else
            validation_fail "Test C.1 FAIL: default .git protection did not block writes (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        if output="$(run_validation_spi -- "${test_project}" -q --backend bwrap --allow-git -x /bin/bash --noprofile --norc -lc 'printf spi-git-ok > .git/spi-allowed && cat .git/spi-allowed' 2>&1)" &&
            [[ "${output}" == "spi-git-ok" ]] && [[ -f "${test_project}/.git/spi-allowed" ]] &&
            [[ "$(<"${test_project}/.git/spi-allowed")" == "spi-git-ok" ]]; then
            validation_pass 'Test C.2 PASS: --allow-git permits .git writes'
        else
            validation_fail "Test C.2 FAIL: --allow-git did not permit .git writes (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf bad > .agents/spi-blocked' 2>&1 || true)"
        if [[ ! -e "${test_project}/.agents/spi-blocked" ]] && [[ "${output}" =~ Read-only|Permission\ denied|cannot\ create|Operation\ not\ permitted ]]; then
            validation_pass 'Test C.3 PASS: project .agents is protected read-only by default'
        else
            validation_fail "Test C.3 FAIL: project .agents protection did not block writes (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc "mkdir -p ${neighbor_dir_q} && printf bad > ${neighbor_dir_q}/escape.txt && printf attempted" 2>&1 || true)"
        if [[ ! -e "${neighbor_dir}/escape.txt" ]] && [[ -f "${neighbor_dir}/secret.txt" ]] &&
            [[ "$(<"${neighbor_dir}/secret.txt")" == "neighbor-secret" ]]; then
            validation_pass 'Test D.1 PASS: parent/neighbor path escape does not mutate host paths'
