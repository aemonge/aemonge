            output="$(run_spi_terminal_fixture -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'tmux_socket="${TMUX%%,*}"; test -S "$NVIM" && test -S "$NVIM_LISTEN_ADDRESS" && test -S "$tmux_socket" && test "$TMUX_PANE" = "%7" && printf TERMINAL_SOCKET_OK' 2>&1 || true)"
