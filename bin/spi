        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap --allow-git -x /bin/bash --noprofile --norc -lc 'git reset --hard HEAD 2>&1' 2>&1 || true)"
        if [[ "${output}" == *'Denied git reset --hard blocked'* ]]; then
            validation_pass 'Test M.7 PASS: destructive git reset remains denied'
        else
            validation_fail "Test M.7 FAIL: git reset --hard was not denied (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap --add "${shared_ro_dir}" -x /bin/bash --noprofile --norc -lc "cat ${shared_ro_dir_q}/note.txt" 2>&1 || true)"
        if [[ "${output}" == 'shared-ro' ]]; then
            validation_pass 'Test N.1 PASS: --add exposes extra path read-only'
        else
            validation_fail "Test N.1 FAIL: --add read failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap --add "${shared_ro_dir}" -x /bin/bash --noprofile --norc -lc "printf blocked > ${shared_ro_dir_q}/note.txt" 2>&1 || true)"
        if [[ "${output}" =~ Read-only|Permission\ denied|cannot\ create|Operation\ not\ permitted ]] && [[ "$(<"${shared_ro_dir}/note.txt")" == 'shared-ro' ]]; then
            validation_pass 'Test N.2 PASS: --add keeps extra path read-only'
        else
            validation_fail "Test N.2 FAIL: --add did not block writes (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_spi -- "${test_project}" -q --backend bwrap --add-rw "${shared_rw_dir}" -x /bin/bash --noprofile --norc -lc "printf updated > ${shared_rw_dir_q}/note.txt && cat ${shared_rw_dir_q}/note.txt" 2>&1 || true)"
        if [[ "${output}" == 'updated' ]] && [[ "$(<"${shared_rw_dir}/note.txt")" == 'updated' ]]; then
            validation_pass 'Test N.3 PASS: --add-rw allows writes'
        else
            validation_fail "Test N.3 FAIL: --add-rw write failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi
    else
        printf 'ℹ️  Live bwrap validation skipped because bwrap/probe prerequisites failed\n'
    fi

    output="$(env HOME="${test_home}" PATH="${PATH}" PI_BIN=/bin/true PI_CODING_AGENT_DIR="${test_home}/.pi/agent" "${script_path}" -- "${test_project}" -q --backend gondolin 2>&1 || true)"
    if [[ "${output}" == *'Gondolin backend is not implemented'* ]]; then
        validation_pass 'Test F.1 PASS: --backend gondolin fails closed'
    else
        validation_fail "Test F.1 FAIL: --backend gondolin did not fail closed (${output})"
        failed_tests=$((failed_tests + 1))
    fi

    if [[ "${SPI_VALIDATION_EXTERNAL:-0}" != "1" ]]; then
        for external_name in spi-static-test spi-parser-test; do
            external_test="${script_dir}/test/${external_name}"
            if [[ -x "${external_test}" ]]; then
                if output="$(SPI_VALIDATION_EXTERNAL=1 "${external_test}" 2>&1)"; then
                    validation_pass "Test X.${external_name} PASS: external ${external_name} passed"
                else
                    external_status=$?
                    validation_fail "Test X.${external_name} FAIL: external ${external_name} failed with ${external_status}"
                    printf '%s\n' "${output}"
                    failed_tests=$((failed_tests + 1))
                fi
            else
                printf 'ℹ️  Test X.%s SKIP: external script not present or not executable\n' "${external_name}"
            fi
        done
    fi

    rm -rf -- "${validation_root}"

    printf '\n'
    if [[ "${failed_tests}" -eq 0 ]]; then
        printf '🎉 All SPI validation tests passed!\n'
        return 0
    fi

    printf '⚠️  %s SPI validation test(s) failed\n' "${failed_tests}"
    return 1
}

if [[ $# -eq 1 ]]; then
    case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    -V | --version)
        version
        exit 0
        ;;
    esac
fi

# -------- defaults --------
PI_BIN="${PI_BIN:-${PI_BIN_DEFAULT}}"
BACKEND="${SPI_BACKEND:-auto}"
FS_MODE="${SPI_FS_MODE:-rw}"
QUIET=0
VERBOSE=0
VALIDATE_MODE=0
DOCTOR_MODE=0
ALLOW_GIT=0
ALLOW_INFRA=0
ALLOW_PI_CONFIG=0
RESTRICT_DEV=1
RO_SET=0
RW_SET=0
SPI_PARSE_MODE=0
HOST_HOME="${HOME}"
HOST_USER="${USER:-andres}"
HOST_LOGNAME="${LOGNAME:-${HOST_USER}}"
PI_AGENT_DIR_FROM_ENV=0
if [[ -n "${PI_CODING_AGENT_DIR:-}" ]]; then
    PI_AGENT_DIR="${PI_CODING_AGENT_DIR}"
    PI_AGENT_DIR_FROM_ENV=1
else
    PI_AGENT_DIR="${HOST_HOME}/.pi/agent"
fi

PROJECT_TARGET=""
PROJECT_DIR=""
PROJECT_SOURCE_DIR=""
PROJECT_ALIAS_DIR=""
TARGET_KIND=""
TARGET_PATH=""
TARGET_SOURCE_PATH=""
TARGET_PARENT_DIR=""
TARGET_SOURCE_PARENT_DIR=""
INVOCATION_CWD=""
SANDBOX_PROJECT_ROOT=""
SANDBOX_WORKDIR=""
PI_ARGS=()
SPI_ARGS=()
RAW_COMMAND=()
ADD_RO_PATHS=()
ADD_RW_PATHS=()
EXTRA_BINDS=()
EXTRA_DIRS=()
SAFE_BINDS=()
SANDBOX_ENVS=()
declare -A EXTRA_DIR_SET=()
declare -A PARENT_DIR_EXPANSION_SET=()
declare -A EXTRA_BIND_DEST_SET=()
declare -A SANDBOX_ENV_SET=()

# Pi writable runtime/state is intentionally narrow. Existing ~/.pi is mounted
# read-only first, then ~/.pi/agent is overlaid writable so Pi can mkdir direct
# startup lock dirs such as settings.json.lock/trust.json.lock and update the
# corresponding root-agent JSON. Known child state trees are still listed and
# precreated explicitly for diagnostics/tests and compatibility with older Pi
# layouts. Known ~/.pi/agent resource/config children are overlaid read-only
# after the writable root so symlinked package/extension/prompt/skill/theme
# resources resolve without granting broad write access to their targets.
PI_AGENT_STATE_SUBDIRS=(
    tasks
    status
    todos
    plans
    jobs
    runs
    ui
    statusline
    sessions
    auth
    trust
    models
    metadata
    cache
    git
    npm
    projects
    workspaces
    providers
    state
)
PI_RUNTIME_WRITABLE_LABEL="tasks status todos plans jobs runs ui statusline sessions auth trust models metadata cache git npm projects workspaces providers state"
PI_AGENT_RO_PATHS=(
    extensions
    packages
    prompts
    skills
    themes
    keybindings.json
)
PI_AGENT_MUTABLE_ROOT_FILES=(
    settings.json
    trust.json
    auth.json
    models-store.json
)

while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--" && "${SPI_PARSE_MODE}" -eq 0 ]]; then
        SPI_PARSE_MODE=1
        shift
        continue
    fi
    if [[ "${SPI_PARSE_MODE}" -eq 0 ]]; then
        PI_ARGS+=("$1")
    else
        SPI_ARGS+=("$1")
    fi
    shift
done

set -- "${SPI_ARGS[@]}"
while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    -V | --version)
        version
        exit 0
        ;;
    -a | --add)
        if [[ $# -lt 2 ]]; then error "missing argument for $1"; exit 1; fi
        ADD_RO_PATHS+=("$2")
        shift 2
        ;;
    -A | --add-rw)
        if [[ $# -lt 2 ]]; then error "missing argument for $1"; exit 1; fi
        ADD_RW_PATHS+=("$2")
        shift 2
        ;;
    -b | --bin)
        if [[ $# -lt 2 ]]; then error "missing argument for $1"; exit 1; fi
        PI_BIN="$2"
        shift 2
        ;;
    -q | --quiet)
        QUIET=1
        shift
        ;;
    -v | --verbose)
        VERBOSE=1
        shift
        ;;
    --backend)
        if [[ $# -lt 2 ]]; then error "missing argument for --backend"; exit 1; fi
        BACKEND="$2"
        shift 2
        ;;
    --backend=*)
        BACKEND="${1#--backend=}"
        shift
        ;;
    --doctor | --docotr)
        DOCTOR_MODE=1
        shift
        ;;
    --validate)
        VALIDATE_MODE=1
        shift
        ;;
    --ro)
        RO_SET=1
        FS_MODE="ro"
        shift
        ;;
    --rw)
        RW_SET=1
        FS_MODE="rw"
        shift
        ;;
    --allow-git)
        ALLOW_GIT=1
        shift
        ;;
    --allow-infra)
        ALLOW_INFRA=1
        shift
        ;;
    --allow-pi-config)
        ALLOW_PI_CONFIG=1
        shift
        ;;
    --full-dev)
        RESTRICT_DEV=0
        shift
        ;;
    -x | --exec)
        shift
        if [[ $# -eq 0 ]]; then error "missing command for -x/--exec"; exit 1; fi
        RAW_COMMAND=("$@")
        break
        ;;
    -*)
        error "unknown option: $1"
        echo "Try '${PROGRAM_NAME} --help' for more information." >&2
        exit 1
        ;;
    *)
        if [[ -z "${PROJECT_TARGET}" ]]; then
            PROJECT_TARGET="$1"
        else
            error "unexpected spi argument after target: $1"
            exit 1
        fi
        shift
        ;;
    esac
done

if [[ "${VALIDATE_MODE}" -eq 1 ]]; then
    run_validation
    exit $?
fi
if [[ "${DOCTOR_MODE}" -eq 1 ]]; then
    run_doctor
    exit $?
fi

if [[ "${RO_SET}" -eq 1 && "${RW_SET}" -eq 1 ]]; then
    error "--ro and --rw are mutually exclusive"
    exit 1
fi
if [[ "${FS_MODE}" != "ro" && "${FS_MODE}" != "rw" ]]; then
    error "invalid FS mode '${FS_MODE}' (expected 'ro' or 'rw')"
    exit 1
fi
if [[ -z "${PROJECT_TARGET}" ]]; then
    PROJECT_TARGET="${PWD}"
fi

resolve_backend
[[ "${BACKEND}" == "bwrap" ]] || { error "resolved backend is not implemented: ${BACKEND}"; exit 1; }
check_bwrap_namespace_support || exit 1
discover_pi_binary
discover_git_wrapper

resolve_target_mode "${PROJECT_TARGET}"
INVOCATION_CWD="$(realpath "${PWD}")"
if [[ "${TARGET_KIND}" == "dir" ]]; then
    if [[ "${TARGET_PATH}" != "${TARGET_SOURCE_PATH}" ]]; then
        PROJECT_DIR="${TARGET_SOURCE_PATH}"
        PROJECT_ALIAS_DIR="${TARGET_PATH}"
    else
        PROJECT_DIR="${TARGET_PATH}"
    fi
    PROJECT_SOURCE_DIR="${TARGET_SOURCE_PATH}"
    SANDBOX_PROJECT_ROOT="${PROJECT_DIR}"
    SANDBOX_WORKDIR="${PROJECT_DIR}"
else
    PROJECT_DIR="${TARGET_PARENT_DIR}"
    PROJECT_SOURCE_DIR="${TARGET_SOURCE_PARENT_DIR}"
    SANDBOX_PROJECT_ROOT="${PROJECT_DIR}"
    SANDBOX_WORKDIR="${INVOCATION_CWD}"
fi

SANDBOX_HOME="${HOST_HOME}"
SANDBOX_LOCAL_DIR="${SANDBOX_HOME}/.local"
SANDBOX_LOCAL_SHARE_DIR="${SANDBOX_LOCAL_DIR}/share"
SANDBOX_LOCAL_STATE_DIR="${SANDBOX_LOCAL_DIR}/state"
SANDBOX_CONFIG_DIR="${SANDBOX_HOME}/.config"
SANDBOX_CACHE_DIR="${SANDBOX_HOME}/.cache"
SPI_TMPDIR="/tmp/spi-$$"

map_host_path_to_sandbox "${PI_AGENT_DIR}"
SANDBOX_PI_AGENT_DIR="${REPLY}"

if [[ "${TARGET_KIND}" == "file" || "${FS_MODE}" == "ro" ]]; then
    PROJECT_BIND_FLAG="--ro-bind"
else
    PROJECT_BIND_FLAG="--bind"
fi

SANDBOX_PATH="/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin"
if [[ -d "${HOST_HOME}/.local/bin" ]]; then
    resolve_bind_source_path "${HOST_HOME}/.local/bin"
    EXTRA_BINDS+=(--ro-bind "${REPLY}" "${SANDBOX_HOME}/.local/bin")
    SANDBOX_PATH="${SANDBOX_HOME}/.local/bin:${SANDBOX_PATH}"
fi

if [[ "${ALLOW_PI_CONFIG}" -eq 1 ]]; then
    bind_runtime_dir "${HOST_HOME}/.pi" "${SANDBOX_HOME}/.pi"
else
    opt_ro_bind_dir "${HOST_HOME}/.pi" "${SANDBOX_HOME}/.pi"
    bind_pi_agent_tmpfs_root
    for state_subdir in "${PI_AGENT_STATE_SUBDIRS[@]}"; do
        bind_prepared_runtime_dir "${PI_AGENT_DIR}/${state_subdir}" "${SANDBOX_PI_AGENT_DIR}/${state_subdir}"
    done
    bind_pi_agent_resource_paths
fi
bind_pi_xdg_resources
bind_nearest_project_openspec
bind_footer_xdg_resources
opt_ro_bind_global_skills

opt_ro_bind_path "${HOST_HOME}/.gitconfig" "${SANDBOX_HOME}/.gitconfig"
opt_ro_bind_path "${HOST_HOME}/.config/git/config" "${SANDBOX_HOME}/.config/git/config"
opt_ro_bind_path /run/systemd/resolve /run/systemd/resolve
opt_ro_bind_path /run/dbus /run/dbus
opt_ro_bind_path /run/NetworkManager /run/NetworkManager
opt_ro_bind_path /var/run/nscd /var/run/nscd
bind_terminal_integration
bind_pi_socket_envs

if [[ "${TARGET_KIND}" == "file" ]] && ! is_path_within "${PROJECT_SOURCE_DIR}" "${INVOCATION_CWD}"; then
    EXTRA_BINDS+=(--ro-bind "${INVOCATION_CWD}" "${INVOCATION_CWD}")
fi
if [[ -n "${PROJECT_ALIAS_DIR}" ]]; then
    add_prepared_bind_once "${PROJECT_BIND_FLAG}" "${PROJECT_SOURCE_DIR}" "${PROJECT_ALIAS_DIR}"
fi

PROTECTED_CONTROL_DIRS=(
    ".git"
    ".github"
    ".pi"
    ".agents"
    "openspec"
    ".claude"
)
PROTECTED_CONTROL_FILES=(
    ".mcp.json"
    ".gitignore"
    "package-lock.json"
    "pnpm-lock.yaml"
    "yarn.lock"
    "poetry.lock"
    "Cargo.lock"
)

if [[ "${ALLOW_INFRA}" -eq 0 ]]; then
    for control_dir in "${PROTECTED_CONTROL_DIRS[@]}"; do
        if [[ "${control_dir}" == ".git" && "${ALLOW_GIT}" -eq 1 ]]; then
            continue
        fi
        if [[ -d "${PROJECT_SOURCE_DIR}/${control_dir}" ]]; then
            SAFE_BINDS+=(--ro-bind "${PROJECT_SOURCE_DIR}/${control_dir}" "${SANDBOX_PROJECT_ROOT}/${control_dir}")
            if [[ -n "${PROJECT_ALIAS_DIR}" ]]; then
                SAFE_BINDS+=(--ro-bind "${PROJECT_SOURCE_DIR}/${control_dir}" "${PROJECT_ALIAS_DIR}/${control_dir}")
            fi
            info "Protecting ${control_dir}/ (read-only)"
        fi
    done
    for control_file in "${PROTECTED_CONTROL_FILES[@]}"; do
        if [[ -f "${PROJECT_SOURCE_DIR}/${control_file}" ]]; then
            SAFE_BINDS+=(--ro-bind "${PROJECT_SOURCE_DIR}/${control_file}" "${SANDBOX_PROJECT_ROOT}/${control_file}")
            if [[ -n "${PROJECT_ALIAS_DIR}" ]]; then
                SAFE_BINDS+=(--ro-bind "${PROJECT_SOURCE_DIR}/${control_file}" "${PROJECT_ALIAS_DIR}/${control_file}")
            fi
            info "Protecting ${control_file} (read-only)"
        fi
    done
fi

for added_path in "${ADD_RO_PATHS[@]}"; do
    add_custom_bind --ro-bind "${added_path}"
done
for added_path in "${ADD_RW_PATHS[@]}"; do
    add_custom_bind --bind "${added_path}"
done

BWRAP_CMD=(
    bwrap
    --ro-bind /usr /usr
    --ro-bind /bin /bin
    --ro-bind /lib /lib
)

if bwrap --help 2>/dev/null | grep -q -- "--disable-userns"; then
    BWRAP_CMD=(bwrap --unshare-user "${BWRAP_CMD[@]:1}")
    BWRAP_CMD+=(--disable-userns)
else
    BWRAP_CMD=(bwrap --unshare-user-try "${BWRAP_CMD[@]:1}")
fi

[[ -d /lib64 ]] && BWRAP_CMD+=(--ro-bind /lib64 /lib64)
[[ -d /sys ]] && BWRAP_CMD+=(--ro-bind /sys /sys)
BWRAP_CMD+=(--ro-bind /etc /etc)
BWRAP_CMD+=(
    --ro-bind "${REAL_GIT_HOST}" /spi/real-git
    --ro-bind "${SCODER_GIT_HOST}" /usr/bin/git
)

if [[ "${RESTRICT_DEV}" -eq 1 ]]; then
    BWRAP_CMD+=(
        --dev-bind /dev/null /dev/null
        --dev-bind /dev/zero /dev/zero
        --dev-bind /dev/random /dev/random
        --dev-bind /dev/urandom /dev/urandom
        --dev-bind /dev/tty /dev/tty
        --tmpfs /dev/shm
    )
else
    BWRAP_CMD+=(--dev /dev)
fi

BWRAP_CMD+=(
    --proc /proc
    --tmpfs /tmp
    --dir "${SPI_TMPDIR}"
    --chmod 0700 "${SPI_TMPDIR}"
    --tmpfs /home
    --dir "${SANDBOX_HOME}"
    --dir "${SANDBOX_LOCAL_DIR}"
    --dir "${SANDBOX_LOCAL_SHARE_DIR}"
    --dir "${SANDBOX_LOCAL_STATE_DIR}"
    --dir "${SANDBOX_CONFIG_DIR}"
    --dir "${SANDBOX_CACHE_DIR}"
)
BWRAP_CMD+=("${EXTRA_DIRS[@]}")
if [[ "${SANDBOX_PROJECT_ROOT}" != "/" ]]; then
    BWRAP_CMD+=(--dir "$(dirname "${SANDBOX_PROJECT_ROOT}")")
    BWRAP_CMD+=(--dir "${SANDBOX_PROJECT_ROOT}")
fi
BWRAP_CMD+=("${EXTRA_BINDS[@]}")
BWRAP_CMD+=("${PROJECT_BIND_FLAG}" "${PROJECT_SOURCE_DIR}" "${SANDBOX_PROJECT_ROOT}")
BWRAP_CMD+=("${SAFE_BINDS[@]}")

BWRAP_CMD+=(
    --chdir "${SANDBOX_WORKDIR}"
    --die-with-parent
    --clearenv
)
inherit_safe_environment
preserve_pi_session_environment
BWRAP_CMD+=("${SANDBOX_ENVS[@]}")
BWRAP_CMD+=(
    --setenv PATH "${SANDBOX_PATH}"
    --setenv HOME "${SANDBOX_HOME}"
    --setenv USER "${HOST_USER}"
    --setenv LOGNAME "${HOST_LOGNAME}"
    --setenv TERM "${TERM:-xterm-256color}"
    --setenv COLORTERM "${COLORTERM:-truecolor}"
    --setenv LANG "${LANG:-C.UTF-8}"
    --setenv LC_ALL "${LC_ALL:-C.UTF-8}"
    --setenv SHELL "${SHELL:-/bin/bash}"
    --setenv GIT_OPTIONAL_LOCKS 0
    --setenv SCODER_REAL_GIT /spi/real-git
    --setenv TMPDIR "${SPI_TMPDIR}"
    --setenv SPI_BACKEND "${BACKEND}"
    --setenv OPENSPEC_TELEMETRY 0
)

if [[ "${PI_AGENT_DIR_FROM_ENV}" -eq 1 ]]; then
    BWRAP_CMD+=(--setenv PI_CODING_AGENT_DIR "${SANDBOX_PI_AGENT_DIR}")
fi

if [[ ${#RAW_COMMAND[@]} -gt 0 ]]; then
    BWRAP_CMD+=("${RAW_COMMAND[@]}")
else
    BWRAP_CMD+=("${PI_BIN_SANDBOX}" "${PI_ARGS[@]}")
fi

trace_startup "bwrap command built"
info "Launching spi sandbox with ${BACKEND}..."
exec "${BWRAP_CMD[@]}"
