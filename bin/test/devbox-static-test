#!/usr/bin/env bash
# shellcheck disable=SC2016 # Assertions intentionally match literal shell source.
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly DEVBOX="${SCRIPT_DIR}/../devbox"
readonly DEVBOX_GIT="${SCRIPT_DIR}/../devbox-git"
readonly DEVBOX_AGENT_CONTEXT="${SCRIPT_DIR}/../devbox-agent-context.md"

[[ -x "${DEVBOX}" ]] || { printf 'FAIL: devbox executable missing: %s\n' "${DEVBOX}" >&2; exit 1; }
[[ -x "${DEVBOX_GIT}" ]] || { printf 'FAIL: devbox-git executable missing: %s\n' "${DEVBOX_GIT}" >&2; exit 1; }
[[ -r "${DEVBOX_AGENT_CONTEXT}" ]] || { printf 'FAIL: Devbox agent context missing: %s\n' "${DEVBOX_AGENT_CONTEXT}" >&2; exit 1; }

assert_contains() {
    local description="$1"
    local text="$2"
    if grep -F -q -- "${text}" "${DEVBOX}"; then
        printf 'PASS: %s\n' "${description}"
    else
        printf 'FAIL: %s (missing %s)\n' "${description}" "${text}" >&2
        exit 1
    fi
}

assert_absent() {
    local description="$1"
    local text="$2"
    if grep -F -q -- "${text}" "${DEVBOX}"; then
        printf 'FAIL: %s (unexpected %s)\n' "${description}" "${text}" >&2
        exit 1
    fi
    printf 'PASS: %s\n' "${description}"
}

assert_contains 'identifies the unified command' 'readonly PROGRAM_NAME="devbox"'
assert_contains 'uses command-first parsing' 'DEVBOX_COMMAND+=("$1")'
assert_contains 'supports a literal child delimiter' 'DEVBOX_COMMAND+=(--)'
assert_contains 'defaults to an interactive Zsh login shell' 'RAW_COMMAND=("${DEVBOX_SHELL:-zsh}" -l)'
assert_absent 'does not expose a box/profile selector' '--box'
assert_absent 'does not advertise an exec mode' '-x, --exec'
assert_contains 'uses a writable target by default' 'FS_MODE="${DEVBOX_FS_MODE:-rw}"'
assert_contains 'protects critical infrastructure by default' 'ALLOW_INFRA=0'
assert_contains 'fails closed on conflicting mount destinations' 'conflicting mount policy for ${sand_p}'
assert_contains 'keeps Git writable under the Devbox policy wrapper' 'ALLOW_GIT=1'
assert_contains 'defaults to the canonical devbox-git entry point' '${SCRIPT_DIR}/devbox-git'
assert_contains 'retains the legacy Scoder Git override during migration' '${SCODER_GIT:-${SCRIPT_DIR}/devbox-git}'
