readonly DEVBOX="${DEVBOX_ROOT}/devbox"
TEST_ROOT="$(mktemp -d)"
readonly TEST_ROOT
cleanup() {
    rm -rf -- "${TEST_ROOT}"
    rm -f -- "${X11_SOCKET:-}"
}
