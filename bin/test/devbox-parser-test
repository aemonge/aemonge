python3 - "${WAYLAND_SOCKET}" "${X11_SOCKET}" "${TMUX_SOCKET}" <<'PY'
import os
import socket
import sys
for path in sys.argv[1:]:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    sock = socket.socket(socket.AF_UNIX)
    sock.bind(path)
    sock.close()
PY

cat >"${TEST_BIN}/bwrap" <<'BWRAP'
#!/usr/bin/env bash
if [[ "${1:-}" == "--version" ]]; then
    printf 'bubblewrap 1.0.0\n'
    exit 0
fi
if [[ "${1:-}" == "--help" ]]; then
    printf '%s\n' '--disable-userns'
    exit 0
fi
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
    if [[ "${args[i]}" == "--" && "${args[i + 1]:-}" == "/bin/sh" ]]; then
        exit 0
    fi
done
printf '%s\0' "$@" >"${DEVBOX_TEST_CAPTURE}"
BWRAP
chmod +x "${TEST_BIN}/bwrap" "${PI_BIN}" "${OPENCODE_BIN}" "${FAKE_GIT_WRAPPER}"
ln -s "${DEVBOX}" "${DEVBOX_SYMLINK}"

BWRAP_ARGS=()
run_devbox_process() {
    local devbox_entry="$1"
    shift

    env -i \
        HOME="${TEST_HOME}" \
        USER="${USER:-developer}" LOGNAME="${LOGNAME:-${USER:-developer}}" \
        PATH="${TEST_BIN}:/usr/local/bin:/usr/bin:/bin" \
        TERM=xterm-256color LANG=C.UTF-8 \
        XDG_CONFIG_HOME="${DEVBOX_TEST_XDG_CONFIG_HOME:-${TEST_HOME}/.config}" \
        XDG_DATA_HOME="${DEVBOX_TEST_XDG_DATA_HOME:-${TEST_HOME}/.local/share}" \
        XDG_CACHE_HOME="${DEVBOX_TEST_XDG_CACHE_HOME:-${TEST_HOME}/.cache}" \
        XDG_RUNTIME_DIR="${RUNTIME_DIR}" WAYLAND_DISPLAY=wayland-9 \
        DISPLAY=:9 XAUTHORITY="${XAUTH_FILE}" TMUX="${TMUX_SOCKET},777,0" TMUX_PANE=%7 \
        AWS_PROFILE=fixture AWS_REGION=us-east-1 \
        AWS_SHARED_CREDENTIALS_FILE="${DEVBOX_TEST_AWS_CREDENTIALS_FILE:-${AWS_CUSTOM_CREDENTIALS}}" \
        SCODER_GIT="${FAKE_GIT_WRAPPER}" \
        DEVBOX_FORCE_PROBE=1 DEVBOX_TEST_CAPTURE="${CAPTURE}" \
        "${devbox_entry}" "$@"
}

run_devbox() {
    local devbox_entry="${DEVBOX_TEST_ENTRY:-${DEVBOX}}"

    rm -f -- "${CAPTURE}"
    run_devbox_process "${devbox_entry}" "$@" >/dev/null
    mapfile -d '' -t BWRAP_ARGS <"${CAPTURE}"
}

assert_devbox_failure() {
    local description="$1"
    local expected_message="$2"
    shift 2
    local output
    local status

    rm -f -- "${CAPTURE}"
    if output="$(run_devbox_process "${DEVBOX}" "$@" 2>&1)"; then
        status=0
    else
        status=$?
    fi
    if [[ "${status}" -ne 0 && "${output}" == *"${expected_message}"* && ! -e "${CAPTURE}" ]]; then
        printf 'PASS: %s\n' "${description}"
        return 0
    fi
    printf 'FAIL: %s (status=%s, output=%s)\n' "${description}" "${status}" "${output}" >&2
    exit 1
}

assert_sequence_contains() {
    local description="$1"
    shift
    local -a expected=("$@")
    local i j matched
    for ((i = 0; i <= ${#BWRAP_ARGS[@]} - ${#expected[@]}; i++)); do
        matched=1
        for ((j = 0; j < ${#expected[@]}; j++)); do
            [[ "${BWRAP_ARGS[i + j]}" == "${expected[j]}" ]] || { matched=0; break; }
        done
        if [[ "${matched}" -eq 1 ]]; then
            printf 'PASS: %s\n' "${description}"
            return 0
        fi
    done
    printf 'FAIL: %s (missing sequence:' "${description}" >&2
    printf ' %q' "${expected[@]}" >&2
    printf ')\n' >&2
    exit 1
}

assert_sequence_absent() {
    local description="$1"
    shift
    local -a expected=("$@")
    local i j matched
    for ((i = 0; i <= ${#BWRAP_ARGS[@]} - ${#expected[@]}; i++)); do
        matched=1
        for ((j = 0; j < ${#expected[@]}; j++)); do
            [[ "${BWRAP_ARGS[i + j]}" == "${expected[j]}" ]] || { matched=0; break; }
        done
        if [[ "${matched}" -eq 1 ]]; then
            printf 'FAIL: %s (unexpected sequence:' "${description}" >&2
            printf ' %q' "${expected[@]}" >&2
            printf ')\n' >&2
            exit 1
        fi
    done
    printf 'PASS: %s\n' "${description}"
}

assert_no_conflicting_bind_destinations() {
    local description="$1"
    local index flag destination previous
    local -A destination_modes=()

    for ((index = 0; index < ${#BWRAP_ARGS[@]}; index++)); do
        flag="${BWRAP_ARGS[index]}"
        case "${flag}" in
        --bind | --ro-bind)
            destination="${BWRAP_ARGS[index + 2]:-}"
            previous="${destination_modes[${destination}]:-}"
            if [[ -n "${previous}" && "${previous}" != "${flag}" ]]; then
                printf 'FAIL: %s (%s has %s and %s)\n' "${description}" "${destination}" "${previous}" "${flag}" >&2
                exit 1
            fi
            destination_modes[${destination}]="${flag}"
            index=$((index + 2))
            ;;
        esac
    done
    printf 'PASS: %s\n' "${description}"
}

assert_tail() {
    local description="$1"
    shift
    local -a expected=("$@")
    local start=$(( ${#BWRAP_ARGS[@]} - ${#expected[@]} ))
    local i
    for ((i = 0; i < ${#expected[@]}; i++)); do
        if [[ "${BWRAP_ARGS[start + i]}" != "${expected[i]}" ]]; then
            printf 'FAIL: %s\n' "${description}" >&2
            exit 1
        fi
    done
    printf 'PASS: %s\n' "${description}"
}

