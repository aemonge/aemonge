#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
readonly DEVBOX="${SCRIPT_DIR}/../devbox"
export DEVBOX_TEST_TARGET="${DEVBOX}"
PI_BIN=pi
LIVE_VALIDATION_ROOT=""
cleanup_live_validation() {
    if [[ -n "${LIVE_VALIDATION_ROOT}" && -d "${LIVE_VALIDATION_ROOT}" ]]; then
        rm -rf -- "${LIVE_VALIDATION_ROOT}"
    fi
}
trap cleanup_live_validation EXIT

validation_pass() { printf '✅ %s\n' "$1"; }
validation_fail() { printf '❌ %s\n' "$1"; }
validation_warn() { printf '⚠️  %s\n' "$1"; }

check_bwrap_namespace_support() {
    bwrap --ro-bind / / --proc /proc --dev /dev --unshare-pid --die-with-parent -- /bin/true >/dev/null 2>&1
}

run_validation() {
    local script_path="${SCRIPT_DIR}/devbox-test-adapter"
    local validation_root
    local test_home
    local test_project
    local direct_openspec_project
    local symlink_source_project
    local symlink_logical_project
    local neighbor_dir
    local shared_ro_dir
    local shared_rw_dir
    local terminal_xdg_config_home
    local terminal_zdotdir
    local terminal_runtime_dir
    local terminal_runtime_marker
    local terminal_nvim_socket
    local terminal_nvim_listen_socket
    local terminal_nvim_editor
    local terminal_tmux_socket
    local target_file_path
    local sibling_file_path
    local plugin_home
    local plugin_agent_dir
    local plugin_package_dir
    local pi_root_config_source_dir
    local validation_pi_bin
    local failed_tests=0
    local live_bwrap=0
    local output
    local neighbor_dir_q
    local shared_ro_dir_q
    local shared_rw_dir_q
    local terminal_runtime_marker_q
    local target_file_path_q
    local sibling_file_path_q
    local project_skill_file_q

    validation_root="$(mktemp -d "${TMPDIR:-/tmp}/devbox-live-validation.XXXXXX")"
    LIVE_VALIDATION_ROOT="${validation_root}"
    test_home="${validation_root}/home"
    test_project="${validation_root}/project"
    direct_openspec_project="${validation_root}/direct-openspec"
    symlink_source_project="${validation_root}/symlink-source/.config"
    symlink_logical_project="${test_home}/.config/linked-nvim"
    neighbor_dir="${validation_root}/neighbor"
    shared_ro_dir="${validation_root}/shared-ro"
    shared_rw_dir="${validation_root}/shared-rw"
    terminal_xdg_config_home="${test_home}/xdg-config"
    terminal_zdotdir="${test_home}/.config/zsh"
    terminal_runtime_dir="${validation_root}/runtime"
    terminal_runtime_marker="${terminal_runtime_dir}/marker.txt"
    terminal_nvim_socket="${terminal_runtime_dir}/nvim.sock"
    terminal_nvim_listen_socket="${terminal_runtime_dir}/nvim-listen.sock"
    terminal_nvim_editor="${test_home}/.config/nvim/scripts/opencode-editor"
    terminal_tmux_socket="${terminal_runtime_dir}/tmux/default"
    target_file_path="${test_project}/src/lib/target.txt"
    sibling_file_path="${test_project}/src/lib/sibling.txt"
    plugin_home="${validation_root}/plugin-home"
    plugin_agent_dir="${plugin_home}/.pi/agent"
    plugin_package_dir="${plugin_agent_dir}/packages/devbox-validation-package"
    pi_root_config_source_dir="${validation_root}/pi-root-config-source"
    validation_pi_bin="$(command -v "${PI_BIN}" 2>/dev/null || true)"
    printf -v neighbor_dir_q '%q' "${neighbor_dir}"
    printf -v shared_ro_dir_q '%q' "${shared_ro_dir}"
    printf -v shared_rw_dir_q '%q' "${shared_rw_dir}"
    printf -v terminal_runtime_marker_q '%q' "${terminal_runtime_marker}"
    printf -v target_file_path_q '%q' "${target_file_path}"
    printf -v sibling_file_path_q '%q' "${sibling_file_path}"
    printf -v project_skill_file_q '%q' "${test_project}/.agents/skills/example/SKILL.md"

    mkdir -p -- \
        "${test_home}/.pi/agent" \
        "${test_home}/.pi/agent/tasks" \
        "${test_home}/.pi/agent/status" \
        "${test_home}/.pi/agent/todos" \
        "${test_home}/.pi/agent/plans" \
        "${test_home}/.pi/agent/jobs" \
        "${test_home}/.pi/agent/runs" \
        "${test_home}/.pi/agent/ui" \
        "${test_home}/.pi/agent/statusline" \
        "${test_home}/.pi/providers" \
        "${test_home}/.pi/models" \
        "${test_home}/.config/pi" \
        "${test_home}/.local/share/pi" \
        "${test_home}/.local/state/pi" \
        "${test_home}/.cache/pi" \
        "${test_home}/.agents/skills/example" \
        "${test_home}/.local/bin" \
        "${test_home}/.config/nvim/scripts" \
        "${terminal_xdg_config_home}" \
        "${terminal_zdotdir}" \
        "${test_home}/.pi" \
        "${test_project}/.git" \
        "${test_project}/.github" \
        "${test_project}/.turbo" \
        "${test_project}/.cargo" \
        "${test_project}/.agents/skills/example" \
        "${test_project}/.pi" \
        "${test_project}/node_modules" \
        "${test_project}/src/lib" \
        "${direct_openspec_project}/openspec/changes/direct-validation" \
        "${direct_openspec_project}/openspec/specs" \
        "${direct_openspec_project}/.pi/prompts" \
        "${plugin_agent_dir}/extensions" \
        "${plugin_package_dir}" \
        "${pi_root_config_source_dir}" \
        "${validation_root}/nested-parent/nvim" \
        "${validation_root}/nested-parent/openspec/changes/nested-validation" \
        "${symlink_source_project}/nvim" \
        "${symlink_source_project}/openspec/changes/symlink-validation" \
        "$(dirname -- "${terminal_tmux_socket}")" \
        "${neighbor_dir}"
    ln -s "${symlink_source_project}/nvim" "${symlink_logical_project}"
    printf 'original-pi-config\n' >"${test_home}/.pi/config"
    printf '{"theme":"original"}\n' >"${test_home}/.pi/agent/settings.json"
    printf '{"trusted":false}\n' >"${test_home}/.pi/agent/trust.json"
    printf '{"devboxSentinel":"fancy-footer"}\n' >"${pi_root_config_source_dir}/fancy-footer.json"
    printf '{"devboxSentinel":"galactica-status"}\n' >"${pi_root_config_source_dir}/galactica-status.json"
    ln -s "${pi_root_config_source_dir}/fancy-footer.json" "${test_home}/.pi/agent/fancy-footer.json"
    ln -s "${pi_root_config_source_dir}/galactica-status.json" "${test_home}/.pi/agent/galactica-status.json"
    printf 'provider-catalog\n' >"${test_home}/.pi/providers/catalog.txt"
    printf 'model-catalog\n' >"${test_home}/.pi/models/catalog.txt"
    printf 'pi-xdg-config\n' >"${test_home}/.config/pi/config.toml"
    printf 'pi-xdg-data\n' >"${test_home}/.local/share/pi/resource.txt"
    printf 'skill-resource\n' >"${test_home}/.agents/skills/example/SKILL.md"
    printf 'project-skill-resource\n' >"${test_project}/.agents/skills/example/SKILL.md"
    printf "format = \"\$directory\"\n" >"${test_home}/.config/starship.toml"
    printf "format = \"\$character\"\n" >"${terminal_xdg_config_home}/starship.toml"
    printf 'validation-zshenv\n' >"${test_home}/.zshenv"
    printf 'validation-zshrc\n' >"${test_home}/.zshrc"
    printf 'validation-zdotdir-zshrc\n' >"${terminal_zdotdir}/.zshrc"
    printf '%s\n' '#!/usr/bin/env bash' 'exit 0' >"${terminal_nvim_editor}"
    chmod +x "${terminal_nvim_editor}"
    printf 'runtime-marker\n' >"${terminal_runtime_marker}"
    printf 'neighbor-secret\n' >"${neighbor_dir}/secret.txt"
    printf 'DEVBOX_VALIDATION=1\n' >"${test_project}/.env"
    printf 'ignored\n' >"${test_project}/.gitignore"
    printf 'lock\n' >"${test_project}/package-lock.json"
    printf 'lock\n' >"${test_project}/poetry.lock"
    printf 'lock\n' >"${test_project}/Cargo.lock"
    printf 'lock\n' >"${test_project}/pnpm-lock.yaml"
    printf 'lock\n' >"${test_project}/yarn.lock"
    printf 'project-pi-original\n' >"${test_project}/.pi/original.txt"
    printf 'schema: spec-driven\n' >"${direct_openspec_project}/openspec/config.yaml"
    printf 'schema: spec-driven\ncreated: 2026-08-04\n' >"${direct_openspec_project}/openspec/changes/direct-validation/.openspec.yaml"
    printf 'direct-pi-prompt\n' >"${direct_openspec_project}/.pi/prompts/opsx-propose.md"
    printf '%s\n' '{"packages":["./packages/devbox-validation-package"]}' >"${plugin_agent_dir}/settings.json"
    printf '%s\n' '{}' >"${plugin_agent_dir}/trust.json"
    cat >"${plugin_agent_dir}/extensions/devbox-auto-validation.ts" <<'DEVBOX_AUTO_EXTENSION'
export default function (pi: any) {
  pi.registerFlag("devbox-auto-extension-loaded", {
    description: "DEVBOX auto-discovered extension loaded",
    type: "boolean",
    default: false,
  });
}
DEVBOX_AUTO_EXTENSION
    printf '%s\n' '{"name":"devbox-validation-package","pi":{"extensions":["./index.ts"]}}' >"${plugin_package_dir}/package.json"
    cat >"${plugin_package_dir}/index.ts" <<'DEVBOX_PACKAGE_EXTENSION'
export default function (pi: any) {
  pi.registerFlag("devbox-package-extension-loaded", {
    description: "DEVBOX settings package extension loaded",
    type: "boolean",
    default: false,
  });
}
DEVBOX_PACKAGE_EXTENSION
    printf 'alpha\n' >"${target_file_path}"
    printf 'beta\n' >"${sibling_file_path}"
    printf 'nested-openspec\n' >"${validation_root}/nested-parent/openspec/changes/nested-validation/tasks.md"
    printf 'symlink-openspec\n' >"${symlink_source_project}/openspec/changes/symlink-validation/tasks.md"
    printf '%s\n' '#!/usr/bin/env bash' 'printf host-tool-ok' >"${test_home}/.local/bin/devbox-host-tool"
    chmod +x "${test_home}/.local/bin/devbox-host-tool"
    mkdir -p -- "${shared_ro_dir}" "${shared_rw_dir}"
    printf 'shared-ro\n' >"${shared_ro_dir}/note.txt"
    printf 'shared-rw\n' >"${shared_rw_dir}/note.txt"
    if command -v python3 >/dev/null 2>&1; then
        python3 - "${terminal_nvim_socket}" "${terminal_nvim_listen_socket}" "${terminal_tmux_socket}" <<'PY'
import os
import socket
import sys

for path in sys.argv[1:]:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    sock = socket.socket(socket.AF_UNIX)
    sock.bind(path)
    sock.close()
PY
    fi

    printf 'devbox comprehensive live validation\n'

    if command -v bwrap >/dev/null 2>&1; then
        validation_pass "Test 0.1 PASS: bwrap found at $(command -v bwrap)"
        if check_bwrap_namespace_support; then
            validation_pass 'Test 0.2 PASS: bwrap namespace probe succeeded'
            live_bwrap=1
        else
            validation_fail 'Test 0.2 FAIL: bwrap namespace probe failed'
            failed_tests=$((failed_tests + 1))
        fi
    else
        validation_fail 'Test 0.1 FAIL: bwrap not found'
        failed_tests=$((failed_tests + 1))
    fi

    if [[ -x /bin/true ]]; then
        validation_pass 'Test 0.3 PASS: safe fake Pi binary is available at /bin/true'
    else
        validation_fail 'Test 0.3 FAIL: /bin/true is not executable'
        failed_tests=$((failed_tests + 1))
        live_bwrap=0
    fi

    run_validation_devbox_with_home() {
        local sandbox_home="$1"
        local sandbox_agent_dir="$2"
        local sandbox_xdg_config_home="${DEVBOX_VALIDATION_XDG_CONFIG_HOME:-${sandbox_home}/.config}"
        local sandbox_xdg_data_home="${DEVBOX_VALIDATION_XDG_DATA_HOME:-${sandbox_home}/.local/share}"
        local sandbox_xdg_state_home="${DEVBOX_VALIDATION_XDG_STATE_HOME:-${sandbox_home}/.local/state}"
        local sandbox_xdg_cache_home="${DEVBOX_VALIDATION_XDG_CACHE_HOME:-${sandbox_home}/.cache}"
        shift 2

        env \
            HOME="${sandbox_home}" \
            PATH="${PATH}" \
            XDG_CONFIG_HOME="${sandbox_xdg_config_home}" \
            XDG_DATA_HOME="${sandbox_xdg_data_home}" \
            XDG_STATE_HOME="${sandbox_xdg_state_home}" \
            XDG_CACHE_HOME="${sandbox_xdg_cache_home}" \
            USER="${USER:-aemonge}" \
            LOGNAME="${LOGNAME:-${USER:-aemonge}}" \
            TERM="${TERM:-xterm-256color}" \
            LANG="${LANG:-C.UTF-8}" \
            RUSTUP_HOME="${sandbox_home}/.local/share/rustup" \
            CARGO_HOME="${sandbox_home}/.local/share/cargo" \
            GOPATH="${sandbox_home}/.local/share/go" \
            GOBIN= \
            SSH_AUTH_SOCK="${DEVBOX_VALIDATION_SSH_AUTH_SOCK:-}" \
            PI_BIN="${DEVBOX_VALIDATION_PI_BIN:-/bin/true}" \
            PI_CODING_AGENT_DIR="${sandbox_agent_dir}" \
            DEVBOX_FORCE_PROBE=1 \
            "${script_path}" "$@"
    }

    run_validation_devbox() {
        run_validation_devbox_with_home "${test_home}" "${test_home}/.pi/agent" "$@"
    }

    run_devbox_terminal_fixture() {
        DEVBOX_VALIDATION_XDG_CONFIG_HOME="${terminal_xdg_config_home}" \
            ZDOTDIR="${terminal_zdotdir}" \
            NVIM="${terminal_nvim_socket}" \
            NVIM_LISTEN_ADDRESS="${terminal_nvim_listen_socket}" \
            TMUX="${terminal_tmux_socket},777,0" \
            TMUX_PANE="%7" \
            run_validation_devbox "$@"
    }

    if [[ "${live_bwrap}" -eq 1 ]]; then
        # shellcheck disable=SC2016 # $HOME must expand inside the sandboxed shell.
        output="$(run_validation_devbox -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf "%s" "$HOME"' 2>&1 || true)"
        if [[ "${output}" == "${test_home}" ]]; then
            validation_pass 'Test A.1 PASS: HOME mirrors host home path on tmpfs'
        else
            validation_fail "Test A.1 FAIL: HOME is ${output} (expected ${test_home})"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # $HOME must expand inside the sandboxed shell.
        output="$(run_validation_devbox -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf DEVBOX_TEST > "$HOME/.bashrc"' 2>&1 || true)"
        if [[ ! -e "${test_home}/.bashrc" ]]; then
            validation_pass 'Test A.2 PASS: ~/.bashrc writes do not leak to host'
        else
            validation_fail "Test A.2 FAIL: ~/.bashrc write leaked to host (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_devbox -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'touch /usr/bin/devbox-validation-system-write 2>&1' 2>&1 || true)"
        if [[ "${output}" =~ Read-only|Permission\ denied|cannot\ touch|Operation\ not\ permitted ]]; then
            validation_pass 'Test A.3 PASS: system files are read-only'
        else
            validation_fail "Test A.3 FAIL: system file write was not blocked (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        if [[ -n "${validation_pi_bin}" && -x "${validation_pi_bin}" ]]; then
            output="$(env -u PI_CODING_AGENT_DIR -u SSH_AUTH_SOCK \
                HOME="${plugin_home}" PATH="${PATH}" \
                USER="${USER:-aemonge}" LOGNAME="${LOGNAME:-${USER:-aemonge}}" \
                TERM="${TERM:-xterm-256color}" LANG="${LANG:-C.UTF-8}" \
                PI_BIN="${validation_pi_bin}" DEVBOX_FORCE_PROBE=1 \
                "${script_path}" --help -- "${test_project}" -q --backend bwrap --no-host-tools --no-ssh-agent 2>&1 || true)"
            if [[ "${output}" == *--devbox-auto-extension-loaded* && "${output}" == *--devbox-package-extension-loaded* ]]; then
                validation_pass 'Test A.4 PASS: real Pi loads global extensions and settings packages without a host PI_CODING_AGENT_DIR override'
            else
                validation_fail "Test A.4 FAIL: real Pi did not load mounted global extensions/settings packages (${output})"
                failed_tests=$((failed_tests + 1))
            fi
        else
            validation_warn 'Test A.4 SKIP: real Pi binary unavailable for extension loading probe'
        fi

        if output="$(run_validation_devbox -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf devbox-rw-ok > validation-write.txt && cat validation-write.txt' 2>&1)" &&
            [[ "${output}" == "devbox-rw-ok" ]] && [[ -f "${test_project}/validation-write.txt" ]] &&
            [[ "$(<"${test_project}/validation-write.txt")" == "devbox-rw-ok" ]]; then
            validation_pass 'Test B.1 PASS: default rw workspace writes persist to target'
        else
            validation_fail "Test B.1 FAIL: default rw workspace write failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_devbox -- "${test_project}" -q --backend bwrap --ro -x /bin/bash --noprofile --norc -lc 'printf nope > ro-blocked.txt' 2>&1 || true)"
        if [[ ! -e "${test_project}/ro-blocked.txt" ]] && [[ "${output}" =~ Read-only|Permission\ denied|cannot\ create|Operation\ not\ permitted ]]; then
            validation_pass 'Test B.2 PASS: --ro blocks workspace writes'
        else
            validation_fail "Test B.2 FAIL: --ro workspace write was not blocked (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        if output="$(run_validation_devbox -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf nm-ok > node_modules/devbox-validation && cat node_modules/devbox-validation' 2>&1)" &&
            [[ "${output}" == "nm-ok" ]] && [[ -f "${test_project}/node_modules/devbox-validation" ]]; then
            validation_pass 'Test B.3 PASS: node_modules is writable when workspace is rw'
        else
            validation_fail "Test B.3 FAIL: node_modules was not writable (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_devbox -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'test -e .env && cat .env' 2>&1 || true)"
        if [[ "${output}" == 'DEVBOX_VALIDATION=1' ]]; then
            validation_pass 'Test B.4 PASS: project .env is visible'
        else
            validation_fail "Test B.4 FAIL: project .env was not visible (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_devbox -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'printf RAW_OK' 2>&1 || true)"
        if [[ "${output}" == 'RAW_OK' ]]; then
            validation_pass 'Test B.5 PASS: raw commands execute inside sandbox'
        else
            validation_fail "Test B.5 FAIL: raw command output was ${output}"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # Variables expand inside the sandboxed shell.
        output="$(run_validation_devbox -- "${validation_root}/nested-parent/nvim" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'task_path="$(dirname "$PWD")/openspec/changes/nested-validation/tasks.md"; cat "$task_path" >/dev/null || exit 1; if printf bad > "$task_path" 2>/dev/null; then printf OPENSPEC_WRITE_ALLOWED; else printf OPENSPEC_RO; fi' 2>&1 || true)"
        if [[ "${output}" == *OPENSPEC_RO* ]] && [[ "${output}" != *OPENSPEC_WRITE_ALLOWED* ]] && \
            [[ "$(<"${validation_root}/nested-parent/openspec/changes/nested-validation/tasks.md")" == 'nested-openspec' ]]; then
            validation_pass 'Test B.7 PASS: nested target sees nearest project OpenSpec read-only'
        else
            validation_fail "Test B.7 FAIL: nested target OpenSpec visibility/policy failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # Variables expand inside the sandboxed shell.
        output="$(run_validation_devbox -- "${symlink_logical_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'task_path="$HOME/.config/openspec/changes/symlink-validation/tasks.md"; cat "$task_path" >/dev/null || exit 1; if printf bad > "$task_path" 2>/dev/null; then printf SYMLINK_OPENSPEC_WRITE_ALLOWED; else printf SYMLINK_OPENSPEC_RO; fi' 2>&1 || true)"
        if [[ "${output}" == *SYMLINK_OPENSPEC_RO* ]] && [[ "${output}" != *SYMLINK_OPENSPEC_WRITE_ALLOWED* ]] && \
            [[ "$(<"${symlink_source_project}/openspec/changes/symlink-validation/tasks.md")" == 'symlink-openspec' ]]; then
            validation_pass 'Test B.8 PASS: symlinked config target sees resolved project OpenSpec read-only at logical path'
        else
            validation_fail "Test B.8 FAIL: symlinked config target OpenSpec visibility/policy failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        if command -v openspec >/dev/null 2>&1; then
            output="$(run_validation_devbox -- "${direct_openspec_project}" -q --backend bwrap -x node -e 'const {execFileSync}=require("child_process"); const out=execFileSync("openspec",["list","--json"],{cwd:process.cwd(),encoding:"utf8"}); const parsed=JSON.parse(out); if(parsed.changes?.[0]?.name!=="direct-validation") throw new Error(out); if(out.includes("Note: OpenSpec")) throw new Error("telemetry note in stdout"); process.stdout.write("DIRECT_OPENSPEC_JSON_OK")' 2>&1 || true)"
            if [[ "${output}" == 'DIRECT_OPENSPEC_JSON_OK' ]]; then
                validation_pass 'Test B.9 PASS: direct OpenSpec target emits clean JSON for footer parsing'
            else
                validation_fail "Test B.9 FAIL: direct OpenSpec JSON parsing failed (${output})"
                failed_tests=$((failed_tests + 1))
            fi
        else
            printf 'ℹ️  Test B.9 SKIP: openspec unavailable for direct OpenSpec JSON probe\n'
        fi

        # shellcheck disable=SC2016 # $TMPDIR must expand inside the sandboxed shell.
        output="$(run_validation_devbox -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'case "$TMPDIR" in /tmp/devbox-*) ;; *) printf "bad-path:%s" "$TMPDIR"; exit 1 ;; esac; test -d "$TMPDIR" && test -w "$TMPDIR" && test "$(stat -c %a "$TMPDIR")" = 700 && printf TMPDIR_OK' 2>&1 || true)"
        if [[ "${output}" == 'TMPDIR_OK' ]]; then
            validation_pass 'Test B.6 PASS: TMPDIR points to a private writable /tmp/devbox-* directory'
        else
            validation_fail "Test B.6 FAIL: private TMPDIR check failed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_devbox -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'command -v devbox-host-tool >/dev/null && devbox-host-tool' 2>&1 || true)"
        if [[ "${output}" == 'host-tool-ok' ]]; then
            validation_pass 'Test D.1 PASS: ~/.local/bin host tools are exposed on PATH'
        else
            validation_fail "Test D.1 FAIL: ~/.local/bin host tool was not exposed (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        # shellcheck disable=SC2016 # $HOME expands inside the sandbox.
        output="$(run_validation_devbox -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'for d in "$HOME/.cache/uv" "$HOME/.local/share/pnpm" "$HOME/.local/share/cargo" "$HOME/.local/share/go" "$HOME/.bun"; do if ! test -w "$d"; then printf "NOT_WRITABLE:%s" "$d"; exit 1; fi; done; printf HOST_TOOL_STATE_OK' 2>&1 || true)"
        if [[ "${output}" == 'HOST_TOOL_STATE_OK' ]]; then
            validation_pass 'Test D.1b PASS: scoder-parity host tool state is writable'
        else
            validation_fail "Test D.1b FAIL: host tool state is unavailable (${output})"
            failed_tests=$((failed_tests + 1))
        fi

        output="$(run_validation_devbox -- "${test_project}" -q --backend bwrap -x /bin/bash --noprofile --norc -lc 'grep -q "^nameserver " /etc/resolv.conf && printf RESOLVER_OK' 2>&1 || true)"
        if [[ "${output}" == 'RESOLVER_OK' ]]; then
            validation_pass 'Test D.2 PASS: DNS resolver config is available'
        else
            validation_warn "Test D.2 WARN: DNS resolver config unavailable or unusual (${output})"
        fi

        if command -v timeout >/dev/null 2>&1; then
            output="$(timeout 10s env \
                HOME="${test_home}" \
                PATH="${PATH}" \
