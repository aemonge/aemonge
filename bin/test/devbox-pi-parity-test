#!/usr/bin/env bash
# shellcheck disable=SC2016 # Single-quoted probes expand only inside the sandbox.
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
readonly DEVBOX="${SCRIPT_DIR}/../devbox"
readonly TOOL_PROBE="${SCRIPT_DIR}/devbox-pi-tool-probe.ts"
TEST_ROOT="$(mktemp -d)"
readonly TEST_ROOT
NVIM_SERVER_PID=""
NVIM_SERVER_SOCKET=""
RPC_TIMEOUT="${DEVBOX_PI_RPC_TIMEOUT:-60}"
readonly RPC_TIMEOUT
cleanup() {
    if [[ -n "${NVIM_SERVER_SOCKET}" && -S "${NVIM_SERVER_SOCKET}" ]]; then
        nvim --server "${NVIM_SERVER_SOCKET}" --remote-expr 'execute("qa!")' >/dev/null 2>&1 || true
    fi
    if [[ -n "${NVIM_SERVER_PID}" ]]; then
        wait "${NVIM_SERVER_PID}" 2>/dev/null || true
    fi
    rm -rf -- "${TEST_ROOT}"
}
trap cleanup EXIT

pass() { printf 'PASS: %s\n' "$1"; }
fail() { printf 'FAIL: %s\n' "$1" >&2; exit 1; }

run_fixture_box() {
    local target="$1"
    shift
    # Keep ambient terminal replies out of non-interactive fixture commands.
    env -i \
        HOME="${FIXTURE_HOME}" USER="${USER:-developer}" LOGNAME="${LOGNAME:-${USER:-developer}}" \
        XDG_CONFIG_HOME="${FIXTURE_HOME}/.config" XDG_DATA_HOME="${FIXTURE_HOME}/.local/share" \
        XDG_STATE_HOME="${FIXTURE_HOME}/.local/state" XDG_CACHE_HOME="${FIXTURE_HOME}/.cache" \
        XDG_RUNTIME_DIR="${FIXTURE_RUNTIME}" \
        PI_CODING_AGENT_DIR="${FIXTURE_AGENT_LOGICAL}" \
        PATH="${PATH}" TERM="${TERM:-xterm-256color}" LANG="${LANG:-C.UTF-8}" \
        NVIM="${NVIM_SERVER_SOCKET}" \
        DEVBOX_FORCE_PROBE=1 \
        "${DEVBOX}" /bin/bash --noprofile --norc -lc "$1" -- "${target}" -q \
        --no-host-tools --no-aws --no-clipboard --no-ssh-agent "${@:2}" </dev/null
}

FIXTURE_HOME="${TEST_ROOT}/home"
FIXTURE_REAL_PROJECT="${TEST_ROOT}/real-project"
FIXTURE_AGENT_LOGICAL="${FIXTURE_HOME}/.pi/agent"
FIXTURE_AGENT_REAL="${FIXTURE_REAL_PROJECT}/.pi/agent"
FIXTURE_PROJECT="${TEST_ROOT}/ordinary-project"
FIXTURE_STATE_ROOT="${FIXTURE_HOME}/.local/state/devbox/pi-agent"
FIXTURE_RUNTIME="${TEST_ROOT}/runtime"
readonly FIXTURE_HOME FIXTURE_REAL_PROJECT FIXTURE_AGENT_LOGICAL FIXTURE_AGENT_REAL FIXTURE_PROJECT FIXTURE_STATE_ROOT FIXTURE_RUNTIME
mkdir -p -- \
    "${FIXTURE_HOME}/.pi" "${FIXTURE_AGENT_REAL}" "${FIXTURE_PROJECT}" "${FIXTURE_RUNTIME}" \
    "${FIXTURE_AGENT_REAL}/packages/example/node_modules" \
    "${FIXTURE_AGENT_REAL}/npm/node_modules/example" \
    "${FIXTURE_AGENT_REAL}/extensions" "${FIXTURE_AGENT_REAL}/skills/example" \
    "${FIXTURE_AGENT_REAL}/prompts" "${FIXTURE_AGENT_REAL}/scripts" \
    "${FIXTURE_AGENT_REAL}/taskflows" "${FIXTURE_AGENT_REAL}/themes" \
    "${FIXTURE_AGENT_REAL}/sessions" \
    "${FIXTURE_HOME}/.config/nvim/scripts" \
    "${FIXTURE_HOME}/.local/share/nvim/lazy/lazy.nvim"
chmod 0700 -- "${FIXTURE_RUNTIME}"
ln -s "${FIXTURE_AGENT_REAL}" "${FIXTURE_AGENT_LOGICAL}"
printf '# fixture root context\n' >"${FIXTURE_AGENT_REAL}/AGENTS.md"
printf '{"quietStartup":true,"externalEditor":"%s"}\n' \
    "${FIXTURE_HOME}/.config/nvim/scripts/pi-editor" >"${FIXTURE_AGENT_REAL}/settings.json"
printf '{}\n' >"${FIXTURE_AGENT_REAL}/keybindings.json"
printf '{}\n' >"${FIXTURE_AGENT_REAL}/fancy-footer.json"
printf '{}\n' >"${FIXTURE_AGENT_REAL}/galactica-status.json"
printf '{"existing":{"type":"api_key","key":"preserved"}}\n' >"${FIXTURE_AGENT_REAL}/auth.json"
cat >"${FIXTURE_HOME}/.config/nvim/init.lua" <<'LUA'
vim.g.devbox_fixture_config = true
local plugin_dir = vim.fn.stdpath("data") .. "/lazy/fixture-missing"
vim.fn.mkdir(plugin_dir, "p")
vim.fn.writefile({ "installed" }, plugin_dir .. "/fixture.txt")
vim.fn.writefile({ '{"fixture":{"branch":"main","commit":"fixture"}}' }, vim.fn.stdpath("config") .. "/lazy-lock.json")
LUA
printf '{"host":true}\n' >"${FIXTURE_HOME}/.config/nvim/lazy-lock.json"
printf 'preserved\n' >"${FIXTURE_HOME}/.local/share/nvim/lazy/lazy.nvim/fixture.txt"
cat >"${FIXTURE_HOME}/.config/nvim/scripts/opencode-editor" <<'EDITOR'
#!/usr/bin/env bash
set -Eeuo pipefail
file=${1:?}
vim_quote() {
    local value=${1//\'/\'\'}
    printf "'%s'" "$value"
}
expr="luaeval(\"(function() vim.cmd.edit(_A); return vim.api.nvim_buf_get_name(0) end)()\", $(vim_quote "$file"))"
opened="$(nvim --server "$NVIM" --remote-expr "$expr" </dev/null)"
[[ "$opened" == "$file" ]]
EDITOR
chmod +x "${FIXTURE_HOME}/.config/nvim/scripts/opencode-editor"
cat >"${FIXTURE_HOME}/.config/nvim/scripts/pi-editor" <<'EDITOR'
#!/usr/bin/env bash
set -Eeuo pipefail

(($# == 1)) || exit 2
runtime_dir=${XDG_RUNTIME_DIR:?}
request_dir=$(mktemp -d "${runtime_dir}/pi-editor.XXXXXXXX")
request="${request_dir}/request"
done_fifo="${request_dir}/done"
bridge_fifo="${request_dir}/bridge"
bridge_writer=""
cleanup() {
    if [[ -n "${bridge_writer}" ]]; then
        kill "${bridge_writer}" 2>/dev/null || true
        wait "${bridge_writer}" 2>/dev/null || true
    fi
    exec 3>&- 3<&- || true
    rm -rf -- "${request_dir}"
}
trap cleanup EXIT
mkfifo -m 600 -- "${done_fifo}" "${bridge_fifo}"
printf '%s\n%s\n%s\n' "$1" "${done_fifo}" "${bridge_fifo}" >"${request}"
exec 3<>"${done_fifo}"
(printf '%s\n' "${PI_NVIM_BRIDGE:?}" >"${bridge_fifo}") &
bridge_writer=$!
vim_quote() {
    local value=${1//\'/\'\'}
    printf "'%s'" "${value}"
}
expr="luaeval(\"(function(request_path) local request=vim.fn.readfile(request_path); vim.fn.delete(request_path); local prompt=request[1]; local done=request[2]; local bridge=request[3]; local descriptor=vim.json.decode(vim.fn.readfile(bridge)[1]); assert(vim.fn.filereadable(prompt)==1, 'prompt invisible'); assert(vim.fn.getftype(descriptor.path)=='socket', 'bridge invisible'); vim.fn.writefile({'edited in host'}, prompt); vim.fn.writefile({'done'}, done); return true end)(_A)\", $(vim_quote "${request}"))"
[[ "$(nvim --server "${NVIM:?}" --remote-expr "${expr}" </dev/null)" == v:true ]]
wait "${bridge_writer}"
bridge_writer=""
IFS= read -r -u 3 _
EDITOR
chmod +x "${FIXTURE_HOME}/.config/nvim/scripts/pi-editor"
cat >"${FIXTURE_HOME}/.config/nvim/scripts/make-socket.py" <<'PY'
import os
import socket
import sys
path = sys.argv[1]
try:
    os.unlink(path)
except FileNotFoundError:
    pass
sock = socket.socket(socket.AF_UNIX)
sock.bind(path)
sock.close()
PY
printf '{"name":"example"}\n' >"${FIXTURE_AGENT_REAL}/packages/example/package.json"
printf 'package dependency\n' >"${FIXTURE_AGENT_REAL}/packages/example/node_modules/dependency.txt"
printf 'npm package\n' >"${FIXTURE_AGENT_REAL}/npm/node_modules/example/index.js"
printf 'extension\n' >"${FIXTURE_AGENT_REAL}/extensions/example.ts"
printf '# skill\n' >"${FIXTURE_AGENT_REAL}/skills/example/SKILL.md"
printf '# prompt\n' >"${FIXTURE_AGENT_REAL}/prompts/example.md"
printf '#!/usr/bin/env bash\n' >"${FIXTURE_AGENT_REAL}/scripts/example"
printf '{}\n' >"${FIXTURE_AGENT_REAL}/taskflows/example.json"
printf '{}\n' >"${FIXTURE_AGENT_REAL}/themes/example.json"

fixture_visibility='test -L "$PI_CODING_AGENT_DIR"; test "$(realpath "$PI_CODING_AGENT_DIR")" = '"$(printf '%q' "${FIXTURE_AGENT_REAL}")"'; for path in AGENTS.md settings.json keybindings.json fancy-footer.json galactica-status.json packages/example/package.json packages/example/node_modules/dependency.txt npm/node_modules/example/index.js extensions/example.ts skills/example/SKILL.md prompts/example.md scripts/example taskflows/example.json themes/example.json; do test -r "$PI_CODING_AGENT_DIR/$path" || exit 1; done; test -r '"$(printf '%q' "${FIXTURE_AGENT_REAL}/AGENTS.md")"'; test ! -w "$PI_CODING_AGENT_DIR/settings.json"; test ! -w "$PI_CODING_AGENT_DIR/packages"; if { printf blocked > "$PI_CODING_AGENT_DIR/scripts/blocked"; } 2>/dev/null; then exit 1; fi; printf fixture-state > "$PI_CODING_AGENT_DIR/sessions/persistent"; printf FIXTURE_OK'

if ! output="$(run_fixture_box "${FIXTURE_PROJECT}" "${fixture_visibility}" 2>&1)"; then
    fail "symlinked Pi directory closure failed (${output})"
fi
[[ "${output}" == FIXTURE_OK && "$(<"${FIXTURE_STATE_ROOT}/sessions/persistent")" == fixture-state && ! -e "${FIXTURE_AGENT_REAL}/sessions/persistent" && ! -e "${FIXTURE_AGENT_REAL}/scripts/blocked" ]] || fail "symlinked Pi directory closure failed (${output})"
pass 'whole-directory Pi symlink preserves portable resources while isolating persistent state'

nvim_config_probe='nvim --headless '\''+lua assert(vim.g.devbox_fixture_config)'\'' +qa; test -r "$XDG_DATA_HOME/nvim/lazy/fixture-missing/fixture.txt"; test ! -w "$XDG_DATA_HOME/nvim/lazy/lazy.nvim/fixture.txt"; grep -q '\''"fixture"'\'' "$XDG_CONFIG_HOME/nvim/lazy-lock.json"; printf NVIM_CONFIG_OK'
if ! output="$(run_fixture_box "${FIXTURE_PROJECT}" "${nvim_config_probe}" 2>&1)"; then
    fail "host Neovim configuration startup failed (${output})"
fi
[[ "${output}" == NVIM_CONFIG_OK ]] || fail "host Neovim configuration did not load inside devbox (${output})"
[[ "$(<"${FIXTURE_HOME}/.config/nvim/lazy-lock.json")" == '{"host":true}' ]] || fail 'devbox changed the host Neovim lockfile'
[[ ! -e "${FIXTURE_HOME}/.local/share/nvim/lazy/fixture-missing" ]] || fail 'devbox installed a plugin into the host Neovim data directory'
[[ "$(<"${FIXTURE_HOME}/.local/share/nvim/lazy/lazy.nvim/fixture.txt")" == preserved ]] || fail 'devbox modified an existing host Neovim plugin'
[[ -r "${FIXTURE_HOME}/.local/share/devbox/nvim/lazy/fixture-missing/fixture.txt" ]] || fail 'missing plugin did not persist in dedicated devbox data'
grep -q '"fixture"' "${FIXTURE_HOME}/.local/state/devbox/nvim/lazy-lock.json" || fail 'lazy lockfile did not persist in dedicated devbox state'
pass 'fresh Neovim startup installs missing plugins and updates its lockfile without mutating host config or existing plugins'

credential_before="$(sha256sum "${FIXTURE_AGENT_REAL}/auth.json" | awk '{print $1}')"
credential_update='test -w "$PI_CODING_AGENT_DIR/auth.json"; test ! -w "$PI_CODING_AGENT_DIR/settings.json"; printf '\''{"existing":{"type":"api_key","key":"preserved"},"refreshed":{"type":"api_key","key":"updated"}}\n'\'' > "$PI_CODING_AGENT_DIR/auth.json"; printf AUTH_UPDATED'
if ! output="$(run_fixture_box "${FIXTURE_PROJECT}" "${credential_update}" 2>&1)"; then
    fail "writable Pi credential update failed (${output})"
fi
[[ "${output}" == AUTH_UPDATED && "$(sha256sum "${FIXTURE_AGENT_REAL}/auth.json" | awk '{print $1}')" != "${credential_before}" ]] || fail "Pi credential update did not persist (${output})"
credential_read='grep -q '\''"existing"'\'' "$PI_CODING_AGENT_DIR/auth.json" && grep -q '\''"refreshed"'\'' "$PI_CODING_AGENT_DIR/auth.json" && printf AUTH_PERSISTED'
if ! output="$(run_fixture_box "${FIXTURE_PROJECT}" "${credential_read}" 2>&1)"; then
    fail "persisted Pi credential read failed (${output})"
fi
[[ "${output}" == AUTH_PERSISTED ]] || fail "updated Pi credentials were not preserved across launches (${output})"
pass 'existing Pi credentials are writable, preserve prior entries, and persist across devbox launches'

NVIM_SERVER_SOCKET="${TEST_ROOT}/nvim.sock"
nvim_target="${FIXTURE_PROJECT}/open-in-nvim.txt"
printf 'open me\n' >"${nvim_target}"
nvim --headless --clean --listen "${NVIM_SERVER_SOCKET}" </dev/null >"${TEST_ROOT}/nvim.stdout" 2>"${TEST_ROOT}/nvim.stderr" &
NVIM_SERVER_PID=$!
for _ in {1..100}; do
    [[ -S "${NVIM_SERVER_SOCKET}" ]] && break
    sleep 0.05
done
[[ -S "${NVIM_SERVER_SOCKET}" ]] || fail 'fixture Neovim server did not create its socket'
nvim_open_command='test "$EDITOR" = "$HOME/.config/nvim/scripts/opencode-editor"; "$EDITOR" '"$(printf '%q' "${nvim_target}")"'; printf handoff > "$XDG_STATE_HOME/opencode/editor-handoff.marker"; printf NVIM_OPENED'
if ! output="$(run_fixture_box "${FIXTURE_PROJECT}" "${nvim_open_command}" 2>&1)"; then
    fail "Neovim editor bridge failed (${output})"
fi
[[ "${output}" == NVIM_OPENED && "$(<"${FIXTURE_HOME}/.local/state/opencode/editor-handoff.marker")" == handoff ]] || fail "Neovim file opening or shared handoff failed (${output})"
pass 'devbox EDITOR opens a project file in the forwarded Neovim server through shared handoff state'
pi_editor_command='prompt="$TMPDIR/prompt.md"; bridge="$TMPDIR/pi-nvim-bridge.sock"; printf original > "$prompt"; python3 "$HOME/.config/nvim/scripts/make-socket.py" "$bridge"; descriptor=$(printf '\''{"path":"%s"}'\'' "$bridge"); PI_NVIM_BRIDGE="$descriptor" "$HOME/.config/nvim/scripts/pi-editor" "$prompt"; test "$(cat "$prompt")" = "edited in host"; rm -f -- "$bridge"; printf PI_EDITOR_OK'
if ! output="$(run_fixture_box "${FIXTURE_PROJECT}" "${pi_editor_command}" 2>&1)"; then
    fail "Pi prompt editor namespace round-trip failed (${output})"
fi
[[ "${output}" == PI_EDITOR_OK ]] || fail "Pi prompt editor did not round-trip prompt and bridge paths (${output})"
pass 'Pi prompt, FIFO request, and bridge socket round-trip through the exact shared editor runtime'
nvim --server "${NVIM_SERVER_SOCKET}" --remote-expr 'execute("qa!")' >/dev/null 2>&1 || true
wait "${NVIM_SERVER_PID}" 2>/dev/null || true
NVIM_SERVER_PID=""
NVIM_SERVER_SOCKET=""

rm -f -- "${FIXTURE_STATE_ROOT}/sessions/persistent"
if ! output="$(run_fixture_box "${FIXTURE_AGENT_LOGICAL}" "${fixture_visibility}" 2>&1)"; then
    fail "Pi-directory target shadowed closure (${output})"
fi
[[ "${output}" == FIXTURE_OK && "$(<"${FIXTURE_STATE_ROOT}/sessions/persistent")" == fixture-state && ! -e "${FIXTURE_AGENT_REAL}/sessions/persistent" ]] || fail "Pi-directory target shadowed closure (${output})"
pass 'selecting the Pi directory as target cannot hide machine-local state overlays'

rm -f -- "${FIXTURE_STATE_ROOT}/sessions/locked"
if ! output="$(run_fixture_box "${FIXTURE_PROJECT}" 'test ! -w "$PI_CODING_AGENT_DIR/settings.json"; test ! -w "$PI_CODING_AGENT_DIR/packages"; printf temporary > "$PI_CODING_AGENT_DIR/sessions/locked"; printf LOCKED_OK' --locked 2>&1)"; then
    fail "locked Pi launch failed (${output})"
fi
[[ "${output}" == LOCKED_OK && ! -e "${FIXTURE_STATE_ROOT}/sessions/locked" && ! -e "${FIXTURE_AGENT_REAL}/sessions/locked" ]] || fail "locked Pi state was not ephemeral (${output})"
pass '--locked keeps Pi resources read-only and state ephemeral'

if ! output="$(run_fixture_box "${FIXTURE_PROJECT}" 'printf "{\"changed\":true}\n" > "$PI_CODING_AGENT_DIR/settings.json"; printf changed > "$PI_CODING_AGENT_DIR/packages/example/changed"; printf ALLOW_OK' --allow-pi-config 2>&1)"; then
    fail "--allow-pi-config launch failed (${output})"
fi
[[ "${output}" == ALLOW_OK && -e "${FIXTURE_AGENT_REAL}/packages/example/changed" && "$(<"${FIXTURE_AGENT_REAL}/settings.json")" == '{"changed":true}' ]] || fail "--allow-pi-config did not enable writes (${output})"
pass '--allow-pi-config explicitly enables configuration and package-source writes without replacing state isolation'

direct_path_probe='case ":$PATH:" in *:/usr/bin:*) ;; *) exit 1 ;; esac; for command_name in sh readlink rmdir; do command -v "$command_name" >/dev/null || exit 1; done; printf DIRECT_PATH_OK'
if ! output="$(run_fixture_box "${FIXTURE_PROJECT}" "${direct_path_probe}" 2>&1)" || [[ "${output}" != DIRECT_PATH_OK ]]; then
    fail "direct-command system PATH probe failed (${output})"
fi
pass 'direct Devbox commands retain /usr/bin and standard cleanup tools'

if ! output="$(env -i \
    HOME="${FIXTURE_HOME}" USER="${USER:-developer}" LOGNAME="${LOGNAME:-${USER:-developer}}" \
    XDG_CONFIG_HOME="${FIXTURE_HOME}/.config" XDG_DATA_HOME="${FIXTURE_HOME}/.local/share" \
    XDG_STATE_HOME="${FIXTURE_HOME}/.local/state" XDG_CACHE_HOME="${FIXTURE_HOME}/.cache" \
    PI_CODING_AGENT_DIR="${FIXTURE_AGENT_LOGICAL}" \
    PATH="${PATH}" TERM="${TERM:-xterm-256color}" LANG="${LANG:-C.UTF-8}" \
    DEVBOX_FORCE_PROBE=1 \
    "${DEVBOX}" /bin/zsh -l -c \
    'case ":$PATH:" in *:/usr/bin:*) ;; *) exit 1 ;; esac; for command_name in sh readlink rmdir; do command -v "$command_name" >/dev/null || exit 1; done; printf LOGIN_PATH_OK' \
    -- "${FIXTURE_PROJECT}" -q --no-host-tools --no-aws --no-clipboard --no-ssh-agent 2>&1)" || [[ "${output}" != LOGIN_PATH_OK ]]; then
    fail "login-shell system PATH probe failed (${output})"
fi
pass 'login Zsh retains /usr/bin and standard cleanup tools'

if ! command -v pi >/dev/null 2>&1; then
    printf 'SKIP: real Pi unavailable\n'
    exit 0
fi

rpc_probe() {
    local output_file="$1"
    local error_file="$2"
    shift 2
    printf '%s\n' \
        '{"id":"commands","type":"get_commands"}' \
        '{"id":"state","type":"get_state"}' \
        '{"id":"tools","type":"prompt","message":"/devbox-pi-tool-registry"}' |
        timeout "${RPC_TIMEOUT}" "$@" --mode rpc --no-session --no-approve -e "${TOOL_PROBE}" \
            >"${output_file}" 2>"${error_file}"
}

summarize_rpc() {
    python3 - "$1" <<'PY'
import collections
import json
import sys

commands = None
state = None
tools = None
for raw in open(sys.argv[1], encoding="utf-8"):
    event = json.loads(raw)
    if event.get("command") == "get_commands":
        commands = [item["name"] for item in event["data"]["commands"]]
    elif event.get("command") == "get_state":
        model = event["data"].get("model") or {}
        state = [model.get("provider"), model.get("id"), event["data"].get("thinkingLevel")]
    elif event.get("type") == "extension_ui_request":
        message = event.get("message", "")
        if message.startswith("DEVBOX_TOOLS:"):
            tools = json.loads(message.removeprefix("DEVBOX_TOOLS:"))
if commands is None or state is None or tools is None:
    raise SystemExit("missing RPC registry, state, or tool probe response")
counts = collections.Counter(commands)
tool_counts = collections.Counter(tools)
print(json.dumps({
    "commands": commands,
    "duplicates": sorted(name for name, count in counts.items() if count > 1),
    "state": state,
    "work_focus_count": tool_counts["work_focus"],
}, sort_keys=True))
PY
}

run_real_pair() {
    local label="$1"
    local target="$2"
    local host_out="${TEST_ROOT}/${label}-host.jsonl"
    local host_err="${TEST_ROOT}/${label}-host.stderr"
    local sand_out="${TEST_ROOT}/${label}-sandbox.jsonl"
    local sand_err="${TEST_ROOT}/${label}-sandbox.stderr"
    local host_summary
    local sand_summary
    local host_stderr
    local sand_stderr
    local probe_status

    if (cd -- "${target}" && rpc_probe "${host_out}" "${host_err}" pi); then
        :
    else
        probe_status=$?
        fail "${label} host Pi RPC probe failed (status=${probe_status}; $(<"${host_err}"))"
    fi
    if printf '%s\n' \
        '{"id":"commands","type":"get_commands"}' \
        '{"id":"state","type":"get_state"}' \
        '{"id":"tools","type":"prompt","message":"/devbox-pi-tool-registry"}' |
        timeout "${RPC_TIMEOUT}" "${DEVBOX}" pi --mode rpc --no-session --no-approve -e "${TOOL_PROBE}" -- \
            "${target}" -q --no-aws --no-clipboard --no-ssh-agent --add "${TOOL_PROBE}" \
            >"${sand_out}" 2>"${sand_err}"; then
        :
    else
        probe_status=$?
        fail "${label} sandbox Pi RPC probe failed (status=${probe_status}; $(<"${sand_err}"))"
    fi
    host_stderr="$(<"${host_err}")"
    sand_stderr="$(<"${sand_err}")"
    [[ "${sand_stderr}" == "${host_stderr}" ]] || fail "${label} Pi startup stderr differs (host=${host_stderr}; sandbox=${sand_stderr})"
    case "${host_stderr}" in
    "" | "pi-nvim-bridge: session_start (reason=startup, mode=rpc)") ;;
    *) fail "${label} Pi startup stderr is not clean (${host_stderr})" ;;
    esac
    host_summary="$(summarize_rpc "${host_out}")"
    sand_summary="$(summarize_rpc "${sand_out}")"
    [[ "${sand_summary}" == "${host_summary}" ]] || fail "${label} RPC registry/state differs (host=${host_summary}; sandbox=${sand_summary})"
    python3 - "${sand_summary}" <<'PY'
import json
import sys
summary = json.loads(sys.argv[1])
required = {"work", "openspec-focus", "galactica-status", "galactica-status-refresh", "next-loop"}
assert required <= set(summary["commands"]), summary
assert summary["commands"].count("work") == 1, summary
assert summary["duplicates"] == [], summary
assert summary["work_focus_count"] == 1, summary
assert summary["state"] == ["openai-codex", "gpt-5.6-sol", "high"], summary
PY
    pass "${label} real Pi RPC commands, model, thinking, and work_focus tool match host exactly"
}

run_real_pair ordinary-project /home/aemonge/usr
run_real_pair pi-directory-target /home/aemonge/.pi/agent

git -C "${FIXTURE_PROJECT}" init -q
printf 'base\n' >"${FIXTURE_PROJECT}/footer.txt"
git -C "${FIXTURE_PROJECT}" -c user.name=Fixture -c user.email=fixture@example.invalid add -- footer.txt
git -C "${FIXTURE_PROJECT}" -c user.name=Fixture -c user.email=fixture@example.invalid commit -qm fixture
printf 'added\n' >>"${FIXTURE_PROJECT}/footer.txt"
host_git_probe="$(cd -- "${FIXTURE_PROJECT}" && {
    git --no-optional-locks status --porcelain=2 --branch
    git --no-optional-locks diff --numstat HEAD
})"
sandbox_git_probe="$(run_fixture_box "${FIXTURE_PROJECT}" '
git --no-optional-locks status --porcelain=2 --branch
git --no-optional-locks diff --numstat HEAD
')"
[[ "${sandbox_git_probe}" == "${host_git_probe}" ]] || fail 'Fancy Footer lock-free Git status/diff output differs from host'
[[ "${sandbox_git_probe}" == *$'1\t0\tfooter.txt'* ]] || fail 'Fancy Footer Git numstat probe did not report the fixture diff'
pass 'Fancy Footer lock-free Git status and diff totals match host'

host_hashes="$(for name in AGENTS.md settings.json keybindings.json fancy-footer.json galactica-status.json; do sha256sum "/home/aemonge/.pi/agent/${name}"; done | awk '{print $1}')"
sandbox_hashes="$("${DEVBOX}" /bin/bash --noprofile --norc -lc 'for name in AGENTS.md settings.json keybindings.json fancy-footer.json galactica-status.json; do sha256sum "$PI_CODING_AGENT_DIR/$name"; done' -- /home/aemonge/.pi/agent -q --no-aws --no-clipboard --no-ssh-agent | awk '{print $1}')"
[[ "${sandbox_hashes}" == "${host_hashes}" ]] || fail 'sandbox root Pi configuration hashes differ from host'
pass 'sandbox root Pi context/configuration hashes match host'

host_node_version="$(node --version)"
host_pi_version="$(pi --version)"
runtime="$("${DEVBOX}" /bin/bash --noprofile --norc -lc 'printf "%s %s" "$(node --version)" "$(pi --version)"' -- /home/aemonge/usr -q --no-aws --no-clipboard --no-ssh-agent)"
[[ "${runtime}" == "${host_node_version} ${host_pi_version}" ]] || fail "unexpected real runtime (${runtime}; host Node=${host_node_version}; host Pi=${host_pi_version})"
pass "sandbox uses the unchanged host Node ${host_node_version} and Pi ${host_pi_version} runtimes"

printf 'devbox Pi parity tests passed\n'
