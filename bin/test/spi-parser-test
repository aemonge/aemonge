assert_file_contains '--verbose shows .git protection info' "${TEST_ROOT}/verbose.err" 'spi: Protecting .git/ (read-only)'
assert_file_contains '--verbose shows .agents protection info' "${TEST_ROOT}/verbose.err" 'spi: Protecting .agents/ (read-only)'
assert_file_contains '--verbose shows .gitignore protection info' "${TEST_ROOT}/verbose.err" 'spi: Protecting .gitignore (read-only)'
assert_file_contains '--verbose shows launch info' "${TEST_ROOT}/verbose.err" 'spi: Launching spi sandbox with bwrap...'

run_spi_with_stderr "${TEST_ROOT}/quiet-verbose.err" -- "${TEST_PROJECT}" --verbose -q --backend bwrap -x true
assert_file_absent '--quiet suppresses verbose .git protection info' "${TEST_ROOT}/quiet-verbose.err" 'spi: Protecting .git/ (read-only)'
assert_file_absent '--quiet suppresses verbose launch info' "${TEST_ROOT}/quiet-verbose.err" 'spi: Launching spi sandbox with bwrap...'

rm -f -- "${BWRAP_CAPTURE}" "${BWRAP_PROBE_CAPTURE}"
if env -i \
    HOME="${TEST_HOME}" PATH="${TEST_BIN}:${PATH}" \
    XDG_STATE_HOME="${TEST_STATE}" \
    USER="${USER:-aemonge}" LOGNAME="${LOGNAME:-${USER:-aemonge}}" \
    TERM="${TERM:-xterm-256color}" LANG="${LANG:-C.UTF-8}" \
    PI_BIN="${FAKE_PI}" SCODER_GIT="${FAKE_SCODER_GIT}" \
    SPI_TEST_BWRAP_CAPTURE="${BWRAP_CAPTURE}" \
    SPI_TEST_BWRAP_PROBE_CAPTURE="${BWRAP_PROBE_CAPTURE}" \
    "${SPI}" -- "${TEST_PROJECT}" -q --backend bwrap -x true >/dev/null 2>"${TEST_ROOT}/probe.err"; then
    mapfile -d '' -t BWRAP_ARGS <"${BWRAP_PROBE_CAPTURE}"
    assert_sequence_contains 'namespace probe mounts /usr for /bin -> /usr/bin shell chains' --ro-bind /usr /usr
    assert_sequence_contains 'namespace probe mounts /bin before executing /bin/sh' --ro-bind /bin /bin
else
    printf 'FAIL: namespace probe regression check failed\n' >&2
    sed 's/^/  /' "${TEST_ROOT}/probe.err" >&2
    exit 1
fi

rm -f -- "${BWRAP_CAPTURE}"
if env -i HOME="${TEST_HOME}" PATH="${TEST_BIN}:${PATH}" PI_BIN="${FAKE_PI}" SCODER_GIT="${FAKE_SCODER_GIT}" \
    "${SPI}" -- "${TEST_PROJECT}" -q --backend gondolin >/dev/null 2>"${TEST_ROOT}/gondolin.err"; then
    printf 'FAIL: gondolin backend unexpectedly succeeded\n' >&2
    exit 1
fi
if [[ -e "${BWRAP_CAPTURE}" ]]; then
    printf 'FAIL: gondolin backend invoked bubblewrap\n' >&2
    exit 1
fi
if grep -q 'Gondolin backend is not implemented' "${TEST_ROOT}/gondolin.err"; then
    printf 'PASS: gondolin backend fails early with actionable diagnostic\n'
else
    printf 'FAIL: gondolin diagnostic missing\n' >&2
    exit 1
fi

if [[ "${SPI_VALIDATION_EXTERNAL:-0}" == "1" ]]; then
    printf 'PASS: --validate regression check skipped during validation re-entry\n'
elif command -v bwrap >/dev/null 2>&1 && [[ -x "${SCRIPT_DIR}/../scoder-git" ]]; then
    readonly VALIDATE_HOME="${TEST_ROOT}/validate-home"
    mkdir -p "${VALIDATE_HOME}"
    if env -i \
        HOME="${VALIDATE_HOME}" PATH="${PATH}" \
        XDG_STATE_HOME="${TEST_STATE}" XDG_DATA_HOME="${TEST_XDG_DATA_HOME}" XDG_CACHE_HOME="${TEST_XDG_CACHE_HOME}" \
        USER="${USER:-aemonge}" LOGNAME="${LOGNAME:-${USER:-aemonge}}" \
        TERM="${TERM:-xterm-256color}" LANG="${LANG:-C.UTF-8}" \
        PI_BIN=/bin/true PI_CODING_AGENT_DIR="${VALIDATE_HOME}/.pi/agent" \
        SCODER_GIT="${SCRIPT_DIR}/../scoder-git" \
        "${SPI}" -- "${TEST_PROJECT}" --validate >"${TEST_ROOT}/validate.out" 2>"${TEST_ROOT}/validate.err"; then
        assert_file_contains '--validate runs validation suite, not doctor only' "${TEST_ROOT}/validate.out" 'All SPI validation tests passed'
        assert_file_absent '--validate output is not just doctor diagnostics' "${TEST_ROOT}/validate.out" 'SPI doctor'
    elif grep -F -q 'SPI validation' "${TEST_ROOT}/validate.out" && \
        grep -F -q 'bwrap namespace probe failed' "${TEST_ROOT}/validate.out" && \
        ! grep -F -q 'SPI doctor' "${TEST_ROOT}/validate.out"; then
        printf 'PASS: --validate dispatches to validation suite even when live bwrap is unavailable\n'
    else
        printf 'FAIL: --validate regression check failed\n' >&2
        sed 's/^/  /' "${TEST_ROOT}/validate.out" >&2
        sed 's/^/  /' "${TEST_ROOT}/validate.err" >&2
        exit 1
    fi
else
    printf 'PASS: --validate regression check skipped because real bwrap/scoder-git is unavailable\n'
fi

printf 'spi parser and bwrap capture tests passed\n'
