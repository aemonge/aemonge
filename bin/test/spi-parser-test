sequence_first_index() {
    local expected=("$@")
    local index offset matched

    for ((index = 0; index <= ${#BWRAP_ARGS[@]} - ${#expected[@]}; index++)); do
        matched=1
        for ((offset = 0; offset < ${#expected[@]}; offset++)); do
            if [[ "${BWRAP_ARGS[index + offset]}" != "${expected[offset]}" ]]; then
                matched=0
                break
            fi
        done
        if [[ "${matched}" -eq 1 ]]; then
            SEQUENCE_INDEX="${index}"
            return 0
        fi
    done
    return 1
}

sequence_last_index() {
    local expected=("$@")
    local index offset matched

    for ((index = ${#BWRAP_ARGS[@]} - ${#expected[@]}; index >= 0; index--)); do
        matched=1
        for ((offset = 0; offset < ${#expected[@]}; offset++)); do
            if [[ "${BWRAP_ARGS[index + offset]}" != "${expected[offset]}" ]]; then
                matched=0
                break
            fi
        done
        if [[ "${matched}" -eq 1 ]]; then
            SEQUENCE_INDEX="${index}"
            return 0
        fi
    done
    return 1
}

assert_last_sequence_before() {
    local description="$1"
    shift
    local before=()
    local after=()
    local before_index after_index

    while [[ $# -gt 0 && "$1" != "::" ]]; do
        before+=("$1")
        shift
    done
    if [[ $# -eq 0 ]]; then
        printf 'FAIL: %s\n  missing :: separator\n' "${description}" >&2
        exit 1
    fi
    shift
    after=("$@")

    if ! sequence_last_index "${before[@]}"; then
        printf 'FAIL: %s\n  missing before sequence: %q\n' "${description}" "${before[*]}" >&2
        exit 1
    fi
    before_index="${SEQUENCE_INDEX}"
    if ! sequence_first_index "${after[@]}"; then
        printf 'FAIL: %s\n  missing after sequence: %q\n' "${description}" "${after[*]}" >&2
        exit 1
    fi
    after_index="${SEQUENCE_INDEX}"

    if ((before_index < after_index)); then
        printf 'PASS: %s\n' "${description}"
        return 0
    fi

    printf 'FAIL: %s\n  last before index %d is not before first after index %d\n' "${description}" "${before_index}" "${after_index}" >&2
    exit 1
}

assert_placeholder_before_bind() {
    local description="$1"
    local placeholder_flag="$2"
    local bind_flag="$3"
    local source_path="$4"
    local dest_path="$5"
    local index

    for ((index = 2; index < ${#BWRAP_ARGS[@]} - 2; index++)); do
        if [[ "${BWRAP_ARGS[index]}" == "${bind_flag}" && \
            "${BWRAP_ARGS[index + 1]}" == "${source_path}" && \
            "${BWRAP_ARGS[index + 2]}" == "${dest_path}" && \
            "${BWRAP_ARGS[index - 2]}" == "${placeholder_flag}" && \
            "${BWRAP_ARGS[index - 1]}" == "${dest_path}" ]]; then
            printf 'PASS: %s\n' "${description}"
            return 0
        fi
    done

    printf 'FAIL: %s\n  expected %s placeholder immediately before %s %s %s\n' \
        "${description}" "${placeholder_flag}" "${bind_flag}" "${source_path}" "${dest_path}" >&2
    exit 1
}

assert_file_bind_after_tmpfs() {
    local description="$1"
    local bind_flag="$2"
    local source_path="$3"
    local dest_path="$4"
    local bind_index tmpfs_index index

    bind_index=-1
    tmpfs_index=-1
    for ((index = 0; index < ${#BWRAP_ARGS[@]} - 2; index++)); do
        if [[ "${BWRAP_ARGS[index]}" == "${bind_flag}" && \
            "${BWRAP_ARGS[index + 1]}" == "${source_path}" && \
            "${BWRAP_ARGS[index + 2]}" == "${dest_path}" ]]; then
            bind_index="${index}"
        fi
        if [[ "${BWRAP_ARGS[index]}" == "--tmpfs" && \
            "${BWRAP_ARGS[index + 1]}" == "$(dirname "${dest_path}")" ]]; then
            tmpfs_index="${index}"
        fi
    done

    if ((tmpfs_index >= 0 && bind_index > tmpfs_index)); then
        printf 'PASS: %s\n' "${description}"
        return 0
    fi

    printf 'FAIL: %s\n  expected direct %s %s %s after agent tmpfs, with no --file placeholder\n' \
        "${description}" "${bind_flag}" "${source_path}" "${dest_path}" >&2
    exit 1
}

