    "${SPI}" -- "${TEST_PROJECT}" -q --backend bwrap -x true >/dev/null 2>"${TEST_ROOT}/cache.err" && \
    [[ -e "${BWRAP_CAPTURE}" && ! -e "${BWRAP_PROBE_CAPTURE}" ]]; then
    printf 'PASS: startup cache skips an unchanged namespace probe\n'
