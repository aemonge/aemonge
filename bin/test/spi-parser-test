run_spi_with_stderr() {
    local stderr_file="$1"
    local home_root="${SPI_TEST_HOME_ROOT:-${TEST_HOME}}"
    local -a optional_env=()
    shift

    if [[ -n "${SPI_TEST_PI_CODING_AGENT_DIR:-}" ]]; then
        optional_env+=(PI_CODING_AGENT_DIR="${SPI_TEST_PI_CODING_AGENT_DIR}")
    fi
    if [[ -n "${SPI_TEST_PI_PROVIDER:-}" ]]; then
        optional_env+=(PI_PROVIDER="${SPI_TEST_PI_PROVIDER}")
    fi
    if [[ -n "${SPI_TEST_PI_MODEL:-}" ]]; then
        optional_env+=(PI_MODEL="${SPI_TEST_PI_MODEL}")
    fi
    if [[ -n "${SPI_TEST_PI_REASONING_LEVEL:-}" ]]; then
        optional_env+=(PI_REASONING_LEVEL="${SPI_TEST_PI_REASONING_LEVEL}")
    fi
    if [[ -n "${SPI_TEST_PI_SESSION_ID:-}" ]]; then
        optional_env+=(PI_SESSION_ID="${SPI_TEST_PI_SESSION_ID}")
    fi
    if [[ -n "${SPI_TEST_PI_STATUS_SOCKET:-}" ]]; then
        optional_env+=(PI_STATUS_SOCKET="${SPI_TEST_PI_STATUS_SOCKET}")
    fi
    if [[ -n "${SPI_TEST_PI_DENIED_SOCKET:-}" ]]; then
        optional_env+=(PI_LOGIN_SOCKET="${SPI_TEST_PI_DENIED_SOCKET}")
    fi

    rm -f -- "${BWRAP_CAPTURE}"
    if ! env -i \
        HOME="${home_root}" PATH="${TEST_BIN}:${PATH}" \
        XDG_STATE_HOME="${TEST_STATE}" XDG_DATA_HOME="${TEST_XDG_DATA_HOME}" XDG_CACHE_HOME="${TEST_XDG_CACHE_HOME}" \
        XDG_CONFIG_HOME="${TEST_XDG_CONFIG_HOME}" ZDOTDIR="${TEST_ZDOTDIR}" \
        NVIM="${TEST_NVIM_SOCKET}" NVIM_LISTEN_ADDRESS="${TEST_NVIM_LISTEN_SOCKET}" \
        TMUX="${TEST_TMUX_SOCKET},123,0" TMUX_PANE="%42" \
        USER="${USER:-aemonge}" LOGNAME="${LOGNAME:-${USER:-aemonge}}" \
        TERM="${TERM:-xterm-256color}" LANG="${LANG:-C.UTF-8}" \
        "${optional_env[@]}" \
        PI_BIN="${FAKE_PI}" SCODER_GIT="${FAKE_SCODER_GIT}" \
        SPI_FORCE_PROBE=1 SPI_TEST_BWRAP_CAPTURE="${BWRAP_CAPTURE}" \
        SPI_TEST_BWRAP_PROBE_CAPTURE="${BWRAP_PROBE_CAPTURE}" \
        "${SPI}" "$@" >/dev/null 2>"${stderr_file}"; then
        printf 'FAIL: spi invocation failed\n' >&2
        sed 's/^/  /' "${stderr_file}" >&2
        exit 1
    fi
    mapfile -d '' -t BWRAP_ARGS <"${BWRAP_CAPTURE}"
}

run_spi() {
    run_spi_with_stderr "${TEST_ROOT}/spi.err" "$@"
}

assert_sequence_contains() {
    local description="$1"
    shift
    local expected=("$@")
    local index offset matched

    for ((index = 0; index <= ${#BWRAP_ARGS[@]} - ${#expected[@]}; index++)); do
        matched=1
        for ((offset = 0; offset < ${#expected[@]}; offset++)); do
            if [[ "${BWRAP_ARGS[index + offset]}" != "${expected[offset]}" ]]; then
                matched=0
                break
            fi
        done
        if [[ "${matched}" -eq 1 ]]; then
            printf 'PASS: %s\n' "${description}"
            return 0
        fi
    done

    printf 'FAIL: %s\n  expected sequence: %q\n' "${description}" "${expected[*]}" >&2
    exit 1
}

assert_sequence_absent() {
    local description="$1"
    shift
    local expected=("$@")
    local index offset matched

    for ((index = 0; index <= ${#BWRAP_ARGS[@]} - ${#expected[@]}; index++)); do
        matched=1
        for ((offset = 0; offset < ${#expected[@]}; offset++)); do
            if [[ "${BWRAP_ARGS[index + offset]}" != "${expected[offset]}" ]]; then
                matched=0
                break
            fi
        done
        if [[ "${matched}" -eq 1 ]]; then
            printf 'FAIL: %s\n  unexpected sequence: %q\n' "${description}" "${expected[*]}" >&2
            exit 1
        fi
    done

    printf 'PASS: %s\n' "${description}"
}

assert_sequence_value_prefix() {
    local description="$1"
    local flag="$2"
    local prefix="$3"
    local index

    for ((index = 0; index < ${#BWRAP_ARGS[@]} - 1; index++)); do
        if [[ "${BWRAP_ARGS[index]}" == "${flag}" && "${BWRAP_ARGS[index + 1]}" == "${prefix}"* ]]; then
            printf 'PASS: %s\n' "${description}"
            return 0
        fi
    done

    printf 'FAIL: %s\n  expected %s value prefix: %s\n' "${description}" "${flag}" "${prefix}" >&2
    exit 1
}

assert_sequence_tail_prefix() {
    local description="$1"
    local prefix="$2"
    shift 2
    local expected=("$@")
    local index offset matched

    for ((index = 0; index <= ${#BWRAP_ARGS[@]} - ${#expected[@]} - 1; index++)); do
        matched=1
        for ((offset = 0; offset < ${#expected[@]}; offset++)); do
            if [[ "${BWRAP_ARGS[index + offset]}" != "${expected[offset]}" ]]; then
                matched=0
                break
            fi
        done
        if [[ "${matched}" -eq 1 && "${BWRAP_ARGS[index + ${#expected[@]}]}" == "${prefix}"* ]]; then
            printf 'PASS: %s\n' "${description}"
            return 0
        fi
    done

    printf 'FAIL: %s\n  expected sequence ending with prefix: %q -> %s\n' "${description}" "${expected[*]}" "${prefix}" >&2
    exit 1
}

assert_file_contains() {
    local description="$1"
    local file_path="$2"
    local expected_text="$3"

    if grep -F -q -- "${expected_text}" "${file_path}"; then
        printf 'PASS: %s\n' "${description}"
        return 0
    fi

    printf 'FAIL: %s\n  missing text: %s\n' "${description}" "${expected_text}" >&2
    exit 1
}

assert_file_absent() {
    local description="$1"
    local file_path="$2"
    local unexpected_text="$3"

    if grep -F -q -- "${unexpected_text}" "${file_path}"; then
        printf 'FAIL: %s\n  unexpected text: %s\n' "${description}" "${unexpected_text}" >&2
        exit 1
    fi

    printf 'PASS: %s\n' "${description}"
}

