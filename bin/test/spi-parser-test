#!/usr/bin/env bash
if [[ "${1:-}" == "--version" ]]; then
    printf 'bubblewrap 1.0.0\n'
    exit 0
fi
if [[ "${1:-}" == "--help" ]]; then
    printf '%s\n' '--disable-userns'
    exit 0
fi
args=("$@")
is_probe=0
has_usr_mount=0
has_bin_mount=0
for ((i = 0; i < ${#args[@]}; i++)); do
    if [[ "${args[i]}" == "--" && "${args[i + 1]:-}" == "/bin/sh" ]]; then
        is_probe=1
    fi
    if [[ "${args[i]}" == "--ro-bind" && "${args[i + 1]:-}" == "/usr" && "${args[i + 2]:-}" == "/usr" ]]; then
        has_usr_mount=1
    fi
    if [[ "${args[i]}" == "--ro-bind" && "${args[i + 1]:-}" == "/bin" && "${args[i + 2]:-}" == "/bin" ]]; then
        has_bin_mount=1
    fi
done
if [[ "${is_probe}" -eq 1 ]]; then
    if [[ "${has_usr_mount}" -ne 1 || "${has_bin_mount}" -ne 1 ]]; then
        printf 'probe missing executable filesystem mounts for /bin/sh\n' >&2
        exit 97
    fi
    printf '%s\0' "$@" >"${SPI_TEST_BWRAP_PROBE_CAPTURE}"
    exit 0
fi
printf '%s\0' "$@" >"${SPI_TEST_BWRAP_CAPTURE}"
BWRAP_EOF
