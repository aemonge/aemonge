#!/usr/bin/env bash
# shellcheck disable=SC2016 # Assertions intentionally match literal shell source.
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
readonly SPI="${SCRIPT_DIR}/../spi"

[[ -x "${SPI}" ]] || { printf '❌ spi executable is missing: %s\n' "${SPI}" >&2; exit 1; }

assert_contains() {
    local description="$1"
    local pattern="$2"
    if grep -F -q -- "${pattern}" "${SPI}"; then
        printf '✅ %s\n' "${description}"
    else
        printf '❌ %s\n  missing text: %s\n' "${description}" "${pattern}" >&2
        exit 1
    fi
}

assert_absent() {
    local description="$1"
    local pattern="$2"
    if grep -F -q -- "${pattern}" "${SPI}"; then
        printf '❌ %s\n  unexpected text: %s\n' "${description}" "${pattern}" >&2
        exit 1
    fi
    printf '✅ %s\n' "${description}"
}

assert_contains 'spi identifies itself correctly' 'readonly PROGRAM_NAME="spi"'
assert_contains 'spi defaults to Pi' 'readonly PI_BIN_DEFAULT="pi"'
assert_contains 'spi uses strict Bash mode' 'set -euo pipefail'
assert_contains 'spi requires Bubblewrap directly' 'bubblewrap (bwrap) not found in PATH'
assert_contains 'spi accepts only the bwrap compatibility backend value' 'spi supports only the bwrap backend'
assert_absent 'spi has no selectable SPI_BACKEND environment' 'SPI_BACKEND'
assert_absent 'spi has no backend resolution function' 'resolve_backend'

assert_contains 'critical target infrastructure is protected by default' 'ALLOW_INFRA=0'
assert_contains 'target protection uses scoder-compatible infrastructure directories' 'PROTECTED_INFRA_DIRS='
assert_contains 'target protection uses scoder-compatible lockfiles' 'PROTECTED_INFRA_FILES='
assert_contains 'writable host-root targets are explicitly refused' 'refusing to mount the host root writable'
assert_contains 'Git metadata is writable by default' 'ALLOW_GIT=1'
assert_contains 'Git is shadowed by the scoder policy wrapper' '--ro-bind "${SCODER_GIT_HOST}" /usr/bin/git'
assert_contains 'real Git is private to the wrapper' '--setenv SCODER_REAL_GIT /spi/real-git'
assert_contains 'global Git identity remains read-only' 'opt_ro_bind_path "${HOST_HOME}/.gitconfig"'

assert_contains 'Pi global configuration remains role-based' 'bind_pi_agent_tmpfs_root'
assert_contains 'Pi is pinned to the mounted config root even without a host override' '--setenv PI_CODING_AGENT_DIR "${SANDBOX_PI_AGENT_DIR}"'
assert_contains 'Pi state has selected persistent writable subdirectories' 'PI_AGENT_STATE_SUBDIRS='
assert_contains 'Pi resource paths remain read-only' 'PI_AGENT_RO_PATHS='
assert_contains 'Pi root configuration is overlaid read-only' 'PI_AGENT_ROOT_CONFIG_FILES='
assert_contains 'Pi XDG resources have a dedicated policy' 'bind_pi_xdg_resources'
assert_contains 'global skills remain read-only' 'opt_ro_bind_global_skills'
assert_contains 'nearest OpenSpec support remains available' 'bind_nearest_project_openspec'

assert_contains 'host development tools are enabled by default' 'ALLOW_HOST_TOOLS=1'
assert_contains 'host tools can be disabled' '--no-host-tools'
assert_contains 'uv state is writable for host tool parity' '".local/share/uv" ".cache/uv"'
assert_contains 'pnpm state is writable for host tool parity' '".local/share/pnpm" ".cache/pnpm"'
assert_contains 'Cargo home is discovered and persisted' 'CARGO_HOME_SANDBOX'
assert_contains 'Go path is discovered and persisted' 'GOPATH_SANDBOX'
assert_contains 'Pyenv is exposed read-only when present' 'PYENV_ROOT_SANDBOX'
assert_contains 'project virtualenv binaries are put on PATH' '${PROJECT_SOURCE_DIR}/.venv/bin'
assert_contains 'project Node binaries are put on PATH' '${PROJECT_SOURCE_DIR}/node_modules/.bin'

assert_contains 'SSH agent forwarding is enabled by default' 'FORWARD_SSH_AGENT=1'
assert_contains 'SSH agent forwarding can be disabled' '--no-ssh-agent'
assert_contains 'SSH socket is exact-bound' 'bind_runtime_path_precreated "${SSH_AUTH_SOCK}"'
assert_contains 'SSH_AUTH_SOCK is restored explicitly' 'add_sandbox_env_once SSH_AUTH_SOCK'
assert_contains 'GUI access is optional' '--allow-gui'
assert_contains 'GUI mode can expose X11 read-only' 'opt_ro_bind_dir /tmp/.X11-unix'
assert_contains 'GUI mode can expose the runtime directory' 'bind_runtime_dir "${XDG_RUNTIME_DIR}"'
assert_contains 'web developer mode starts Chromium DevTools' 'ensure_chromium_devtools'
assert_contains 'Chromium uses a dedicated Pi profile by default' 'SPI_CHROMIUM_PROFILE:-/tmp/pi-chrome'

assert_contains 'single-file mode uses a writable temporary overlay' 'prepare_single_file_overlay'
assert_contains 'single-file mode preserves read-only siblings' 'FILE_MODE_RO_SOURCE_SANDBOX_PATH'
assert_contains 'single-file mode syncs the selected target back' 'sync_single_file_target_back'
assert_contains 'single-file temporary state is cleaned on exit' 'trap cleanup_file_mode_tmp_dir EXIT'

assert_contains 'startup discovery cache is initialized' 'init_discovery_cache'
assert_contains 'startup cache validates script and bwrap identity' 'is_discovery_cache_current'
assert_contains 'startup cache is private' 'chmod 600 "${SPI_DISCOVERY_CACHE}"'
assert_contains 'namespace probes can hit the startup cache' 'bwrap namespace probe cache hit'

assert_contains 'doctor runs the comprehensive validation suite' 'SPI doctor: running comprehensive validation'
assert_contains 'doctor invokes run_validation' 'if run_validation; then'
assert_contains 'plugin integrity work is explicitly pending' 'plugin/extension integrity verification: PENDING'
assert_contains 'validation checks host tool writable state' 'scoder-parity host tool state is writable'
assert_contains 'validation checks default SSH forwarding' 'SSH_AUTH_SOCK is forwarded by default'
assert_contains 'validation checks writable single-file sync' 'writable single-file target changes sync back on success'
assert_contains 'validation checks global Pi root config is read-only' 'Pi root config is read-only while disposable lock dirs work'
assert_contains 'validation executes real Pi extension and settings-package discovery' 'real Pi loads global extensions and settings packages without a host PI_CODING_AGENT_DIR override'
assert_contains 'validation checks selected ~/.pi writability' 'selecting ~/.pi makes that target writable'

assert_contains 'spi uses a tmpfs HOME' '--tmpfs /home'
assert_contains 'spi uses a tmpfs /tmp' '--tmpfs /tmp'
assert_contains 'spi uses a private TMPDIR' 'SPI_TMPDIR="/tmp/spi-$$"'
assert_contains 'spi limits devices by default' '--dev-bind /dev/null /dev/null'
assert_contains 'spi clears the inherited environment first' '--clearenv'
assert_contains 'spi dies with its parent' '--die-with-parent'
assert_absent 'spi never binds the entire host home writable' '--bind "${HOST_HOME}" "${SANDBOX_HOME}"'
assert_absent 'spi never bind-mounts host /tmp wholesale' '--bind /tmp /tmp'

assert_contains 'Neovim remote integration is enabled by default' 'ALLOW_NVIM_REMOTE=1'
assert_contains 'Neovim remote integration can be disabled' '--no-nvim-remote'
assert_contains 'Neovim socket integration remains exact' 'bind_terminal_socket_env NVIM'
assert_contains 'Neovim editor bridge uses the scoder-compatible script' 'NVIM_EDITOR_SCRIPT="${HOST_HOME}/.config/nvim/scripts/opencode-editor"'
assert_contains 'Neovim editor bridge sets EDITOR explicitly' '--setenv EDITOR "${SANDBOX_EDITOR}"'
assert_contains 'Neovim editor bridge sets VISUAL explicitly' '--setenv VISUAL "${SANDBOX_EDITOR}"'
assert_contains 'Tmux socket integration remains exact' 'bind_tmux_socket_env'
assert_contains 'safe Pi status socket discovery remains available' 'bind_pi_socket_envs'
assert_contains 'stale OpenCode workspace state is filtered' 'is_stale_workspace_env_name'
assert_contains 'Pi session/model/provider state is preserved' 'preserve_pi_session_environment'

printf 'spi static safety and development-parity tests passed\n'
