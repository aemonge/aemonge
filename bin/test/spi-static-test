#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
readonly SPI="${SCRIPT_DIR}/../spi"

if [[ ! -x "${SPI}" ]]; then
    printf '❌ spi executable is missing: %s\n' "${SPI}" >&2
    exit 1
fi

assert_contains() {
    local description="$1"
    local pattern="$2"

    if grep -q -- "${pattern}" "${SPI}"; then
        printf '✅ %s\n' "${description}"
    else
        printf '❌ %s\n  missing pattern: %s\n' "${description}" "${pattern}" >&2
        exit 1
    fi
}

assert_absent() {
    local description="$1"
    local pattern="$2"

    if grep -q -- "${pattern}" "${SPI}"; then
        printf '❌ %s\n  unexpected pattern: %s\n' "${description}" "${pattern}" >&2
        exit 1
    fi
    printf '✅ %s\n' "${description}"
}

assert_contains 'spi identifies itself as SPI, not scoder' 'readonly PROGRAM_NAME="spi"'
assert_contains 'spi defaults to the pi executable' 'readonly PI_BIN_DEFAULT="pi"'
# shellcheck disable=SC2016 # These are literal source patterns, not expansions.
assert_contains 'spi defaults backend selection to auto' 'BACKEND="${SPI_BACKEND:-auto}"'
assert_contains 'spi keeps .git read-only by default' '^ALLOW_GIT=0$'
assert_contains 'spi exposes an explicit git opt-in' '--allow-git'
assert_contains 'spi exposes an explicit Pi config opt-in' '--allow-pi-config'
assert_contains 'spi exposes explicit verbose startup diagnostics' '--verbose'
assert_contains 'spi hides info logs unless verbose is enabled' 'QUIET.*-eq 0.*VERBOSE.*-eq 1'
assert_contains 'spi implements validation separately from doctor' '^run_validation() {'
assert_contains 'spi validate mode calls run_validation' 'run_validation'
assert_contains 'spi validation reports pass summary' 'All SPI validation tests passed'
assert_contains 'spi fails closed for Gondolin backend' 'Gondolin backend is not implemented'
assert_contains 'spi never falls through to unsandboxed pi in auto mode' 'auto backend requires Linux and bubblewrap'
assert_contains 'spi validation checks HOME path semantics' 'Test A.1 PASS: HOME mirrors host home path on tmpfs'
