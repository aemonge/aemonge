#!/usr/bin/env bash
# shellcheck disable=SC2015,SC2016 # Compact assertions; scripts expand inside the box.
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
readonly DEVBOX="${SCRIPT_DIR}/../devbox"
readonly SCODER_GIT="${SCRIPT_DIR}/../scoder-git"
TEST_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/devbox-live-extended.XXXXXX")"
readonly TEST_ROOT
readonly TEST_HOME="${TEST_ROOT}/home"
readonly TEST_PROJECT="${TEST_ROOT}/project"
readonly TARGET_FILE="${TEST_PROJECT}/src/lib/target.txt"
readonly SIBLING_FILE="${TEST_PROJECT}/src/lib/sibling.txt"
readonly CUSTOM_AWS_FILE="${TEST_ROOT}/custom-credentials"
readonly RUNTIME_DIR="${TEST_ROOT}/runtime"
readonly WAYLAND_SOCKET="${RUNTIME_DIR}/wayland-97"
X11_DISPLAY_NUMBER=$((1000 + $$ % 10000))
readonly X11_DISPLAY_NUMBER
readonly X11_DISPLAY=":${X11_DISPLAY_NUMBER}"
readonly X11_SOCKET="/tmp/.X11-unix/X${X11_DISPLAY_NUMBER}"
readonly XAUTH_FILE="${TEST_HOME}/.Xauthority"
readonly WORKSPACE="${TEST_ROOT}/workspace"
readonly WORKSPACE_MEMBER="${WORKSPACE}/crates/member"
readonly LINKED_CONFIG_TARGET="${TEST_ROOT}/linked-opencode.json"
readonly LINKED_AGENT_TARGET="${TEST_ROOT}/linked-agent.md"

cleanup() {
    rm -rf -- "${TEST_ROOT}"
    rm -f -- "${X11_SOCKET}"
}
trap cleanup EXIT

mkdir -p -- \
    "${TEST_HOME}/.pi/agent" \
    "${TEST_HOME}/.config/opencode/agents" "${TEST_HOME}/.config/openspec" \
    "${TEST_HOME}/.local/share/opencode" "${TEST_HOME}/.cache/opencode" \
    "${TEST_HOME}/.opencode" "${TEST_HOME}/.agents" "${TEST_HOME}/.bun" \
    "${TEST_HOME}/.cache/bun" "${TEST_HOME}/.opencode-browser" \
    "${TEST_HOME}/.aws/sso/cache" "${TEST_HOME}/.aws/cli/cache" \
    "${TEST_HOME}/.local/bin" "${TEST_PROJECT}/.git" "${TEST_PROJECT}/.venv/bin" \
    "${TEST_PROJECT}/src/lib" "${RUNTIME_DIR}" /tmp/.X11-unix \
    "${WORKSPACE_MEMBER}/src"
printf '{}\n' >"${TEST_HOME}/.pi/agent/settings.json"
printf '{}\n' >"${LINKED_CONFIG_TARGET}"
printf '# linked agent\n' >"${LINKED_AGENT_TARGET}"
ln -s "${LINKED_CONFIG_TARGET}" "${TEST_HOME}/.config/opencode/opencode.json"
ln -s "${LINKED_AGENT_TARGET}" "${TEST_HOME}/.config/opencode/agents/Engineer.md"
printf '[default]\nregion=us-east-1\n' >"${TEST_HOME}/.aws/config"
printf '[default]\naws_access_key_id=fixture\n' >"${TEST_HOME}/.aws/credentials"
printf '[custom]\naws_access_key_id=fixture\n' >"${CUSTOM_AWS_FILE}"
printf 'xauth\n' >"${XAUTH_FILE}"
printf 'alpha\n' >"${TARGET_FILE}"
printf 'beta\n' >"${SIBLING_FILE}"
printf '%s\n' '#!/usr/bin/env bash' 'printf host-tool-ok' >"${TEST_HOME}/.local/bin/devbox-host-tool"
chmod +x "${TEST_HOME}/.local/bin/devbox-host-tool"
printf '%s\n' '[workspace]' 'members = ["crates/member"]' >"${WORKSPACE}/Cargo.toml"
printf 'workspace-lock\n' >"${WORKSPACE}/Cargo.lock"
printf '%s\n' '[package]' 'name = "member"' 'version = "0.1.0"' >"${WORKSPACE_MEMBER}/Cargo.toml"
printf 'fn main() {}\n' >"${WORKSPACE_MEMBER}/src/main.rs"

python3 - "${WAYLAND_SOCKET}" "${X11_SOCKET}" <<'PY'
import os
import socket
import sys
for path in sys.argv[1:]:
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    sock = socket.socket(socket.AF_UNIX)
    sock.bind(path)
    sock.close()
PY

run_box() {
    env -i \
        HOME="${TEST_HOME}" USER="${USER:-developer}" LOGNAME="${LOGNAME:-${USER:-developer}}" \
        PATH="${PATH}" TERM="${TERM:-xterm-256color}" LANG="${LANG:-C.UTF-8}" \
        XDG_CONFIG_HOME="${TEST_HOME}/.config" XDG_DATA_HOME="${TEST_HOME}/.local/share" \
        XDG_STATE_HOME="${TEST_HOME}/.local/state" XDG_CACHE_HOME="${TEST_HOME}/.cache" \
        XDG_RUNTIME_DIR="${RUNTIME_DIR}" WAYLAND_DISPLAY=wayland-97 \
        DISPLAY="${X11_DISPLAY}" XAUTHORITY="${XAUTH_FILE}" \
        AWS_PROFILE=fixture AWS_SHARED_CREDENTIALS_FILE="${CUSTOM_AWS_FILE}" \
        SCODER_GIT="${SCODER_GIT}" \
        "${DEVBOX}" "$@"
}

pass() { printf '✅ %s\n' "$1"; }
fail() { printf '❌ %s\n' "$1" >&2; exit 1; }

output="$(run_box /bin/bash --noprofile --norc -lc \
    'for d in "$HOME/.config/opencode" "$HOME/.config/openspec" "$HOME/.cache/opencode" "$HOME/.local/share/opencode" "$HOME/.opencode" "$HOME/.agents" "$HOME/.bun" "$HOME/.cache/bun" "$HOME/.opencode-browser"; do test -w "$d" || { printf "not-writable:%s" "$d"; exit 1; }; done; printf OC_STATE_RW' \
    -- "${TEST_PROJECT}" -q --no-aws --no-clipboard --no-ssh-agent 2>&1 || true)"
[[ "${output}" == OC_STATE_RW ]] && pass 'Test P.1 PASS: complete OpenCode, Bun, agent, and browser state is writable' || fail "Test P.1 FAIL: ${output}"

output="$(run_box /bin/bash --noprofile --norc -lc \
    'cat "$HOME/.config/opencode/opencode.json" "$HOME/.config/opencode/agents/Engineer.md" >/dev/null && printf OPENCODE_SYMLINKS_OK' \
    -- "${TEST_PROJECT}" -q --no-aws --no-clipboard --no-ssh-agent 2>&1 || true)"
[[ "${output}" == OPENCODE_SYMLINKS_OK ]] && pass 'Test P.2 PASS: symlinked OpenCode config and agent targets remain visible' || fail "Test P.2 FAIL: ${output}"

output="$(run_box /bin/bash --noprofile --norc -lc \
    'case ":$PATH:" in *":$PWD/.venv/bin:"*) ;; *) exit 1 ;; esac; command -v devbox-host-tool >/dev/null && test "$(devbox-host-tool)" = host-tool-ok && printf TOOL_PATH_OK' \
    -- "${TEST_PROJECT}" -q --no-aws --no-clipboard --no-ssh-agent 2>&1 || true)"
[[ "${output}" == TOOL_PATH_OK ]] && pass 'Test P.3 PASS: project virtualenv and host tools are available on PATH' || fail "Test P.3 FAIL: ${output}"

output="$(run_box /bin/bash --noprofile --norc -lc \
    'test -r "$HOME/.aws/config" || exit 1; if { printf bad > "$HOME/.aws/config"; } 2>/dev/null; then exit 1; fi; printf sso > "$HOME/.aws/sso/cache/live"; printf cli > "$HOME/.aws/cli/cache/live"; test -r "$AWS_SHARED_CREDENTIALS_FILE" || exit 1; if { printf bad > "$AWS_SHARED_CREDENTIALS_FILE"; } 2>/dev/null; then exit 1; fi; printf AWS_POLICY_OK' \
    -- "${TEST_PROJECT}" -q --no-clipboard --no-ssh-agent 2>&1 || true)"
if [[ "${output}" == *AWS_POLICY_OK* && "$(<"${TEST_HOME}/.aws/sso/cache/live")" == sso && "$(<"${TEST_HOME}/.aws/cli/cache/live")" == cli && "$(<"${CUSTOM_AWS_FILE}")" == *fixture* ]]; then
    pass 'Test P.4 PASS: AWS config/custom credentials are read-only and SSO/CLI caches persist'
else
    fail "Test P.4 FAIL: ${output}"
fi

output="$(run_box /bin/bash --noprofile --norc -lc \
    'test ! -e "$HOME/.aws" && test -z "${AWS_PROFILE:-}" && test -z "${AWS_SHARED_CREDENTIALS_FILE:-}" && printf AWS_HIDDEN' \
    -- "${TEST_PROJECT}" -q --no-aws --no-clipboard --no-ssh-agent 2>&1 || true)"
[[ "${output}" == AWS_HIDDEN ]] && pass 'Test P.5 PASS: --no-aws hides standard/custom credentials and AWS environment' || fail "Test P.5 FAIL: ${output}"

output="$(run_box /bin/bash --noprofile --norc -lc \
    'test -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" && test -S "$1" && test "$DISPLAY" = "$2" && test ! -e "$XDG_RUNTIME_DIR/private-marker" && printf CLIPBOARD_SOCKETS_OK' \
    _ "${X11_SOCKET}" "${X11_DISPLAY}" -- "${TEST_PROJECT}" -q --no-aws --no-ssh-agent 2>&1 || true)"
[[ "${output}" == CLIPBOARD_SOCKETS_OK ]] && pass 'Test P.6 PASS: exact Wayland/X11 clipboard sockets work without broad runtime exposure' || fail "Test P.6 FAIL: ${output}"

output="$(run_box /bin/bash --noprofile --norc -lc \
    'test -z "${WAYLAND_DISPLAY:-}" && test -z "${DISPLAY:-}" && test ! -e "$1" && printf CLIPBOARD_HIDDEN' \
    _ "${X11_SOCKET}" -- "${TEST_PROJECT}" -q --no-aws --no-clipboard --no-ssh-agent 2>&1 || true)"
[[ "${output}" == CLIPBOARD_HIDDEN ]] && pass 'Test P.7 PASS: --no-clipboard hides clipboard sockets and display environment' || fail "Test P.7 FAIL: ${output}"

printf 'private\n' >"${RUNTIME_DIR}/private-marker"
output="$(run_box /bin/bash --noprofile --norc -lc \
    'test ! -e "$XDG_RUNTIME_DIR/private-marker" && printf RUNTIME_PRIVATE' \
    -- "${TEST_PROJECT}" -q --no-aws --no-ssh-agent 2>&1 || true)"
[[ "${output}" == RUNTIME_PRIVATE ]] && pass 'Test P.8 PASS: clipboard mode never exposes the complete runtime directory' || fail "Test P.8 FAIL: ${output}"

output="$(run_box /bin/bash --noprofile --norc -lc \
    'if tail -n +2 /proc/net/route | grep -Eq "^[^[:space:]]+[[:space:]]+00000000"; then exit 1; fi; printf NETWORK_ISOLATED' \
    -- "${TEST_PROJECT}" -q --no-network --no-aws --no-clipboard --no-ssh-agent 2>&1 || true)"
[[ "${output}" == NETWORK_ISOLATED ]] && pass 'Test P.9 PASS: --no-network removes the default network route' || fail "Test P.9 FAIL: ${output}"

missing_socket_output="$(env -i HOME="${TEST_HOME}" USER="${USER:-developer}" LOGNAME="${LOGNAME:-${USER:-developer}}" PATH="${PATH}" TERM=xterm-256color LANG=C.UTF-8 SCODER_GIT="${SCODER_GIT}" SSH_AUTH_SOCK="${TEST_ROOT}/missing.sock" "${DEVBOX}" /bin/true -- "${TEST_PROJECT}" -q --no-aws --no-clipboard 2>&1 || true)"
[[ "${missing_socket_output}" == *'SSH_AUTH_SOCK is not a socket'* ]] && pass 'Test P.10 PASS: missing SSH agent sockets fail closed with a clear diagnostic' || fail "Test P.10 FAIL: ${missing_socket_output}"

output="$(run_box /bin/bash --noprofile --norc -lc \
    "printf swapped > '${TEST_PROJECT}/src/lib/.target.tmp' && mv '${TEST_PROJECT}/src/lib/.target.tmp' '${TARGET_FILE}' && cat '${TARGET_FILE}'" \
    -- "${TARGET_FILE}" -q --no-aws --no-clipboard --no-ssh-agent 2>&1 || true)"
[[ "${output}" == swapped && "$(<"${TARGET_FILE}")" == swapped ]] && pass 'Test P.11 PASS: single-file mode supports rename-over-target saves and copyback' || fail "Test P.11 FAIL: ${output}"

output="$(run_box /bin/bash --noprofile --norc -lc \
    "mkdir -p '${TEST_PROJECT}/src/other' && printf bad > '${TEST_PROJECT}/src/other/new.txt'" \
    -- "${TARGET_FILE}" -q --no-aws --no-clipboard --no-ssh-agent 2>&1 || true)"
[[ "${output}" =~ Read-only|Permission\ denied|cannot\ create|Operation\ not\ permitted ]] && [[ ! -e "${TEST_PROJECT}/src/other/new.txt" ]] && pass 'Test P.12 PASS: single-file mode blocks unrelated nested writes' || fail "Test P.12 FAIL: ${output}"

output="$(run_box /bin/bash --noprofile --norc -lc \
    "printf bad > '${TARGET_FILE}'" \
    -- "${TARGET_FILE}" -q --ro --no-aws --no-clipboard --no-ssh-agent 2>&1 || true)"
[[ "${output}" =~ Read-only|Permission\ denied|cannot\ create|Operation\ not\ permitted ]] && [[ "$(<"${TARGET_FILE}")" == swapped ]] && pass 'Test P.13 PASS: --ro blocks writes in single-file mode' || fail "Test P.13 FAIL: ${output}"

output="$(run_box /bin/bash --noprofile --norc -lc \
    'test "$PWD" = "$1" && printf member > ../../workspace-visible && if { printf bad > ../../Cargo.lock; } 2>/dev/null; then exit 1; fi; printf CARGO_WORKSPACE_OK' \
    _ "${WORKSPACE_MEMBER}" -- "${WORKSPACE_MEMBER}" -q --no-aws --no-clipboard --no-ssh-agent 2>&1 || true)"
[[ "${output}" == *CARGO_WORKSPACE_OK* && "$(<"${WORKSPACE}/workspace-visible")" == member && "$(<"${WORKSPACE}/Cargo.lock")" == workspace-lock ]] && pass 'Test P.14 PASS: Cargo member expands to writable workspace while protecting Cargo.lock' || fail "Test P.14 FAIL: ${output}"

output="$(run_box /bin/bash --noprofile --norc -lc \
    'test ! -e "$HOME/.local/bin/devbox-host-tool" && ! command -v devbox-host-tool >/dev/null && printf HOST_TOOLS_HIDDEN' \
    -- "${TEST_PROJECT}" -q --no-host-tools --no-aws --no-clipboard --no-ssh-agent 2>&1 || true)"
[[ "${output}" == HOST_TOOLS_HIDDEN ]] && pass 'Test P.15 PASS: --no-host-tools removes host binaries from the box' || fail "Test P.15 FAIL: ${output}"

set +e
run_box /bin/bash --noprofile --norc -lc \
    "printf discarded > '${TARGET_FILE}'; exit 7" \
    -- "${TARGET_FILE}" -q --no-aws --no-clipboard --no-ssh-agent >/dev/null 2>&1
failed_file_status=$?
set -e
[[ "${failed_file_status}" -eq 7 && "$(<"${TARGET_FILE}")" == swapped ]] && pass 'Test P.16 PASS: failed single-file commands discard staged changes' || fail "Test P.16 FAIL: status=${failed_file_status} content=$(<"${TARGET_FILE}")"

output="$(run_box /bin/bash --noprofile --norc -lc \
    'printf pi-temp > "$PI_CODING_AGENT_DIR/tasks/locked" && printf oc-temp > "$HOME/.cache/opencode/locked" && if { printf bad > "$HOME/.config/opencode/opencode.json"; } 2>/dev/null; then exit 1; fi; printf LOCKED_EPHEMERAL_OK' \
    -- "${TEST_PROJECT}" -q --locked 2>&1 || true)"
if [[ "${output}" == *LOCKED_EPHEMERAL_OK* && ! -e "${TEST_HOME}/.pi/agent/tasks/locked" && ! -e "${TEST_HOME}/.cache/opencode/locked" && "$(<"${LINKED_CONFIG_TARGET}")" == '{}' ]]; then
    pass 'Test P.17 PASS: --locked allows ephemeral runtime writes without persisting Pi/OpenCode state'
else
    fail "Test P.17 FAIL: ${output}"
fi

printf 'devbox extended live integration tests passed\n'
