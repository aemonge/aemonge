#!/usr/bin/env bash

# devbox - Mount-isolated developer box using Bubblewrap.
# One development environment for interactive shells, Pi, OpenCode, and tools.

set -euo pipefail

readonly PROGRAM_NAME="devbox"
readonly PROGRAM_VERSION="0.2.0"

readonly RED='\033[0;31m'
readonly YELLOW='\033[1;33m'
readonly GREEN='\033[0;32m'
readonly NC='\033[0m'

usage() {
    cat <<'USAGE_EOF'
devbox 0.1.0
Mount-isolated developer box using Bubblewrap.

Usage:
  devbox [COMMAND [ARG...]] [-- [TARGET] [DEVBOX_OPTIONS...]]

Arguments before the first "--" are executed inside the box. Use "---" before
the delimiter to pass a literal "--" to the child command. With no command,
devbox starts an interactive Zsh login shell. Arguments after "--" select the
target and configure the box.

Options after "--":
  -h, --help                 Show this help and exit
  -V, --version              Show version and exit
  -a, --add PATH             Add an extra path read-only
  -A, --add-rw PATH          Add an extra path read-write
  -q, --quiet                Suppress non-essential output
  -v, --verbose              Show startup diagnostics
      --doctor               Run comprehensive diagnostics and exit
      --validate             Run comprehensive validation tests and exit
      --ro                   Mount target read-only
      --rw                   Mount target read-write (default)
      --allow-infra          Allow writes to protected target infrastructure
      --allow-pi-config      Write-bind all ~/.pi explicitly
      --allow-host-tools     Bind host development tools (default)
      --no-host-tools        Disable host development tool binds
      --locked               Read-only, offline, credential-free hardened preset
      --aws                  Expose AWS credentials/configuration (default)
      --no-aws               Hide AWS files and AWS_* environment variables
      --clipboard            Expose detected Wayland/X11 clipboard (default)
      --no-clipboard         Disable clipboard socket forwarding
      --no-network           Unshare the network namespace
      --no-nvim-remote       Disable the active Neovim socket/editor bridge
      --no-terminal-sockets  Disable Neovim and tmux socket forwarding
      --no-ssh-agent         Do not forward SSH_AUTH_SOCK
  -g, --allow-gui            Allow broader GUI/session access
  -w, --web-developer        Enable GUI mode and Chromium DevTools
      --full-dev             Allow full /dev access inside the box

Examples:
  devbox                              # zsh in $PWD
  devbox -- ~/src/project             # zsh in the selected target
  devbox pi "fix this" -- ~/src/app   # Pi in the shared developer box
  devbox opencode -- ~/src/app -w     # OpenCode with browser developer mode
  devbox aws sts get-caller-identity  # AWS CLI with default AWS integration
  devbox pi -- --no-aws --no-ssh-agent

Filesystem boundary:
  The target is writable by default. .git remains writable while .github,
  .turbo, .cargo, and common lockfiles are read-only unless --allow-infra is
  used. System paths and host paths outside explicit mounts remain read-only or
  absent. Pi and OpenCode development state, host-tool caches, AWS, clipboard,
  SSH, terminal, and optional GUI integrations share one developer box.

Security scope:
  Defaults favor development convenience. Network, AWS credentials, SSH agent,
  and clipboard access are available when detected. Any process in the box can
  use those capabilities. Use --no-network, --no-aws, --no-ssh-agent,
  --no-clipboard, --no-host-tools, and --ro to harden a run, or use --locked
  for the strict read-only/offline/credential-free preset.

Environment:
  DEVBOX_FS_MODE            "ro" or "rw" (default)
  DEVBOX_SHELL              Shell used when COMMAND is omitted (default: zsh)
  DEVBOX_AWS                1/0 default for AWS integration
  DEVBOX_CLIPBOARD          1/0 default for clipboard integration
  DEVBOX_NETWORK            1/0 default for shared networking
  DEVBOX_SSH_AGENT          1/0 default for SSH-agent forwarding
  DEVBOX_TERMINAL_SOCKETS    1/0 default for Neovim/tmux socket forwarding
  DEVBOX_HOST_TOOLS         1/0 default for host development tools
  PI_CODING_AGENT_DIR       Optional Pi state root override
  TMPDIR                    Private /tmp/devbox-<pid> path inside the box
USAGE_EOF
}

version() {
    printf '%s %s\n' "${PROGRAM_NAME}" "${PROGRAM_VERSION}"
    printf 'Sandbox: Bubblewrap\n'
}

error() {
    printf '%b%s: %s%b\n' "${RED}" "${PROGRAM_NAME}" "$*" "${NC}" >&2
}

warning() {
    printf '%b%s: %s%b\n' "${YELLOW}" "${PROGRAM_NAME}" "$*" "${NC}" >&2
}

info() {
    if [[ "${QUIET}" -eq 0 && "${VERBOSE}" -eq 1 ]]; then
        printf '%b%s: %s%b\n' "${GREEN}" "${PROGRAM_NAME}" "$*" "${NC}" >&2
    fi
}

startup_trace_ms() {
    date +%s%3N 2>/dev/null || printf '%s000' "$(date +%s)"
}

trace_startup() {
    [[ "${DEVBOX_TRACE_STARTUP:-0}" == "1" ]] || return 0

    local label="$1"
    local now
    local delta
    local total

    now="$(startup_trace_ms)"
    if [[ "${DEVBOX_TRACE_STARTUP_STARTED:-0}" -eq 0 ]]; then
        DEVBOX_TRACE_STARTUP_STARTED="${now}"
        DEVBOX_TRACE_STARTUP_LAST="${now}"
    fi
    delta=$((now - DEVBOX_TRACE_STARTUP_LAST))
    total=$((now - DEVBOX_TRACE_STARTUP_STARTED))
    DEVBOX_TRACE_STARTUP_LAST="${now}"
    printf 'devbox startup: +%sms total=%sms %s\n' "${delta}" "${total}" "${label}" >&2
}

file_mtime() {
    stat -c %Y "$1" 2>/dev/null || printf '0'
}

read_discovery_cache() {
    local cache_key
    local encoded_value
    local decoded_value
    local valid=1
    local count=0
    local -A seen_keys=()

    while IFS='=' read -r cache_key encoded_value; do
        case "${cache_key}" in
        DEVBOX_CACHE_SCRIPT_MTIME | DEVBOX_CACHE_BWRAP_PATH | DEVBOX_CACHE_BWRAP_VERSION | \
            DEVBOX_CACHE_BWRAP_DISABLE_USERNS_SUPPORTED | DEVBOX_CACHE_BWRAP_NAMESPACE_SUPPORT | \
            DEVBOX_CACHE_REAL_GIT_HOST | DEVBOX_CACHE_REAL_GIT_REALPATH | \
            DEVBOX_CACHE_SCODER_GIT_HOST | DEVBOX_CACHE_SCODER_GIT_REALPATH) ;;
        *) valid=0; continue ;;
        esac
        if [[ -n "${seen_keys[${cache_key}]:-}" ]]; then
            valid=0
            continue
        fi
        seen_keys["${cache_key}"]=1
        if ! decoded_value="$(printf '%s' "${encoded_value}" | base64 --decode 2>/dev/null)"; then
            valid=0
            continue
        fi
        printf -v "${cache_key}" '%s' "${decoded_value}"
        count=$((count + 1))
    done <"${DEVBOX_DISCOVERY_CACHE}"

    [[ "${valid}" -eq 1 && "${count}" -eq 9 ]]
}

write_discovery_cache_value() {
    local cache_key="$1"
    local cache_value="$2"

    printf '%s=' "${cache_key}"
    printf '%s' "${cache_value}" | base64 --wrap=0
    printf '\n'
}

init_discovery_cache() {
    DEVBOX_CACHE_DIR="${HOST_HOME}/.cache/devbox"
    DEVBOX_DISCOVERY_CACHE="${DEVBOX_CACHE_DIR}/discovery-v2.cache"
    DEVBOX_DISCOVERY_CACHE_VALID=0

    [[ "${EPHEMERAL_STATE:-0}" -eq 0 ]] || return 0
    mkdir -p -- "${DEVBOX_CACHE_DIR}"
    chmod 700 "${DEVBOX_CACHE_DIR}"
    command -v base64 >/dev/null 2>&1 || return 0
    if [[ "${DEVBOX_FORCE_PROBE:-0}" == "1" || "${DEVBOX_FORCE_DISCOVERY:-0}" == "1" ]]; then
        return 0
    fi
    if [[ -f "${DEVBOX_DISCOVERY_CACHE}" && ! -L "${DEVBOX_DISCOVERY_CACHE}" ]] &&
        [[ "$(stat -c %u -- "${DEVBOX_DISCOVERY_CACHE}" 2>/dev/null || true)" == "$(id -u)" ]] &&
        [[ "$(stat -c %a -- "${DEVBOX_DISCOVERY_CACHE}" 2>/dev/null || true)" == 600 ]] &&
        read_discovery_cache; then
        DEVBOX_DISCOVERY_CACHE_VALID=1
    fi
}

is_discovery_cache_current() {
    local expected_bwrap_path="$1"
    local expected_bwrap_version="$2"

    [[ "${DEVBOX_DISCOVERY_CACHE_VALID:-0}" -eq 1 ]] || return 1
    [[ "${DEVBOX_CACHE_SCRIPT_MTIME:-}" == "$(file_mtime "$0")" ]] || return 1
    [[ "${DEVBOX_CACHE_BWRAP_PATH:-}" == "${expected_bwrap_path}" ]] || return 1
    [[ "${DEVBOX_CACHE_BWRAP_VERSION:-}" == "${expected_bwrap_version}" ]] || return 1
}

write_discovery_cache() {
    local temporary_cache

    [[ -n "${DEVBOX_DISCOVERY_CACHE:-}" ]] || return 0
    [[ "${EPHEMERAL_STATE:-0}" -eq 0 ]] || return 0
    command -v base64 >/dev/null 2>&1 || return 0
    umask 077
    temporary_cache="$(mktemp "${DEVBOX_DISCOVERY_CACHE}.tmp.XXXXXX")"
    if ! {
        write_discovery_cache_value DEVBOX_CACHE_SCRIPT_MTIME "$(file_mtime "$0")"
        write_discovery_cache_value DEVBOX_CACHE_BWRAP_PATH "${DEVBOX_CACHE_BWRAP_PATH:-}"
        write_discovery_cache_value DEVBOX_CACHE_BWRAP_VERSION "${DEVBOX_CACHE_BWRAP_VERSION:-}"
        write_discovery_cache_value DEVBOX_CACHE_BWRAP_DISABLE_USERNS_SUPPORTED "${DEVBOX_CACHE_BWRAP_DISABLE_USERNS_SUPPORTED:-}"
        write_discovery_cache_value DEVBOX_CACHE_BWRAP_NAMESPACE_SUPPORT "${DEVBOX_CACHE_BWRAP_NAMESPACE_SUPPORT:-}"
        write_discovery_cache_value DEVBOX_CACHE_REAL_GIT_HOST "${DEVBOX_CACHE_REAL_GIT_HOST:-}"
        write_discovery_cache_value DEVBOX_CACHE_REAL_GIT_REALPATH "${DEVBOX_CACHE_REAL_GIT_REALPATH:-}"
        write_discovery_cache_value DEVBOX_CACHE_SCODER_GIT_HOST "${DEVBOX_CACHE_SCODER_GIT_HOST:-}"
        write_discovery_cache_value DEVBOX_CACHE_SCODER_GIT_REALPATH "${DEVBOX_CACHE_SCODER_GIT_REALPATH:-}"
    } >"${temporary_cache}"; then
        rm -f -- "${temporary_cache}"
        return 1
    fi
    chmod 600 "${temporary_cache}"
    mv -f -- "${temporary_cache}" "${DEVBOX_DISCOVERY_CACHE}"
}

resolve_bind_source_path() {
    local source_path="$1"
    if [[ -L "${source_path}" ]]; then
        REPLY="$(realpath "${source_path}")"
        return
    fi
    REPLY="${source_path}"
}

is_path_within() {
    local parent_path="$1"
    local child_path="$2"
    [[ "${child_path}" == "${parent_path}" || "${child_path}" == "${parent_path}"/* ]]
}

add_extra_dir_once() {
    local dir_path="$1"
    [[ -n "${EXTRA_DIR_SET[${dir_path}]:-}" ]] && return 0
    EXTRA_DIR_SET["${dir_path}"]=1
    EXTRA_DIRS+=(--dir "${dir_path}")
}

add_parent_dirs_once() {
    local dir_path="$1"
    local parent=""
    local segment

    [[ -n "${PARENT_DIR_EXPANSION_SET[${dir_path}]:-}" ]] && return 0
    PARENT_DIR_EXPANSION_SET["${dir_path}"]=1

    IFS='/' read -r -a segments <<<"${dir_path}"
    for segment in "${segments[@]}"; do
        [[ -z "${segment}" ]] && continue
        parent="${parent}/${segment}"
        add_extra_dir_once "${parent}"
    done
}

register_bind_destination() {
    local bind_flag="$1"
    local host_p="$2"
    local sand_p="$3"
    local policy="${bind_flag}|${host_p}"
    local existing="${EXTRA_BIND_DEST_SET[${sand_p}]:-}"

    if [[ -z "${existing}" ]]; then
        EXTRA_BIND_DEST_SET["${sand_p}"]="${policy}"
        return 0
    fi
    if [[ "${existing}" == "${policy}" ]]; then
        return 1
    fi
    error "conflicting mount policy for ${sand_p}: ${existing} versus ${policy}"
    exit 1
}

add_extra_bind_once() {
    local bind_flag="$1"
    local host_p="$2"
    local sand_p="$3"

    register_bind_destination "${bind_flag}" "${host_p}" "${sand_p}" || return 0
    EXTRA_BINDS+=("${bind_flag}" "${host_p}" "${sand_p}")
}

add_prepared_bind_once() {
    local bind_flag="$1"
    local host_p="$2"
    local sand_p="$3"
    local resolved_host_p

    resolve_bind_source_path "${host_p}"
    resolved_host_p="${REPLY}"
    register_bind_destination "${bind_flag}" "${resolved_host_p}" "${sand_p}" || return 0
    add_parent_dirs_once "$(dirname "${sand_p}")"
    if [[ -d "${resolved_host_p}" ]]; then
        EXTRA_BINDS+=(--dir "${sand_p}")
    fi
    EXTRA_BINDS+=("${bind_flag}" "${resolved_host_p}" "${sand_p}")
}

add_sandbox_env_once() {
    local env_name="$1"
    local env_value="$2"

    [[ -n "${SANDBOX_ENV_SET[${env_name}]:-}" ]] && return 0
    SANDBOX_ENV_SET["${env_name}"]=1
    SANDBOX_ENVS+=(--setenv "${env_name}" "${env_value}")
}

map_host_path_to_sandbox() {
    local host_path="$1"
    if is_path_within "${HOST_HOME}" "${host_path}"; then
        REPLY="${SANDBOX_HOME}${host_path#"${HOST_HOME}"}"
        return
    fi
    REPLY="${host_path}"
}

bind_runtime_dir_precreated() {
    local host_p="$1"
    local sand_p="$2"
    local resolved_host_p

    resolve_bind_source_path "${host_p}"
    resolved_host_p="${REPLY}"
    add_parent_dirs_once "$(dirname "${sand_p}")"
    add_extra_bind_once --bind "${resolved_host_p}" "${sand_p}"
}

bind_runtime_dir() {
    local host_p="$1"
    local sand_p="$2"

    mkdir -p -- "${host_p}"
    bind_runtime_dir_precreated "${host_p}" "${sand_p}"
}

bind_prepared_runtime_dir() {
    local host_p="$1"
    local sand_p="$2"

    mkdir -p -- "${host_p}"
    add_prepared_bind_once --bind "${host_p}" "${sand_p}"
}

bind_runtime_path_precreated() {
    local host_p="$1"
    local sand_p="$2"
    local resolved_host_p

    [[ -e "${host_p}" ]] || return 0
    resolve_bind_source_path "${host_p}"
    resolved_host_p="${REPLY}"
    add_parent_dirs_once "$(dirname "${sand_p}")"
    add_extra_bind_once --bind "${resolved_host_p}" "${sand_p}"
}

opt_ro_bind_path() {
    local host_p="$1"
    local sand_p="$2"
    local resolved_host_p

    [[ -e "${host_p}" ]] || return 0
    resolve_bind_source_path "${host_p}"
    resolved_host_p="${REPLY}"
    add_parent_dirs_once "$(dirname "${sand_p}")"
    add_extra_bind_once --ro-bind "${resolved_host_p}" "${sand_p}"
}

opt_ro_bind_dir() {
    local host_p="$1"
    local sand_p="$2"

    [[ -d "${host_p}" ]] || return 0
    opt_ro_bind_path "${host_p}" "${sand_p}"
}

bind_pi_xdg_resources() {
    local host_config_pi="${XDG_CONFIG_HOME:-${HOST_HOME}/.config}/pi"
    local host_data_pi="${XDG_DATA_HOME:-${HOST_HOME}/.local/share}/pi"
    local host_state_pi="${XDG_STATE_HOME:-${HOST_HOME}/.local/state}/pi"
    local host_cache_pi="${XDG_CACHE_HOME:-${HOST_HOME}/.cache}/pi"
    local sand_config_pi="${SANDBOX_CONFIG_DIR}/pi"
    local sand_data_pi="${SANDBOX_LOCAL_SHARE_DIR}/pi"
    local sand_state_pi="${SANDBOX_LOCAL_STATE_DIR}/pi"
    local sand_cache_pi="${SANDBOX_CACHE_DIR}/pi"

    add_sandbox_env_once XDG_CONFIG_HOME "${SANDBOX_CONFIG_DIR}"
    add_sandbox_env_once XDG_DATA_HOME "${SANDBOX_LOCAL_SHARE_DIR}"
    add_sandbox_env_once XDG_STATE_HOME "${SANDBOX_LOCAL_STATE_DIR}"
    add_sandbox_env_once XDG_CACHE_HOME "${SANDBOX_CACHE_DIR}"

    if [[ "${ALLOW_PI_CONFIG}" -eq 1 ]]; then
        [[ -d "${host_config_pi}" ]] && bind_runtime_dir "${host_config_pi}" "${sand_config_pi}"
        [[ -d "${host_data_pi}" ]] && bind_runtime_dir "${host_data_pi}" "${sand_data_pi}"
    else
        opt_ro_bind_dir "${host_config_pi}" "${sand_config_pi}"
        opt_ro_bind_dir "${host_data_pi}" "${sand_data_pi}"
    fi

    if [[ "${EPHEMERAL_STATE}" -eq 1 ]]; then
        add_extra_dir_once "${sand_state_pi}"
        add_extra_dir_once "${sand_cache_pi}"
    else
        bind_runtime_dir "${host_state_pi}" "${sand_state_pi}"
        bind_runtime_dir "${host_cache_pi}" "${sand_cache_pi}"
    fi
}

bind_pi_agent_resource_paths() {
    local resource_path
    local host_p
    local sand_p

    for resource_path in "${PI_AGENT_RO_PATHS[@]}"; do
        host_p="${PI_AGENT_DIR}/${resource_path}"
        sand_p="${SANDBOX_PI_AGENT_DIR}/${resource_path}"
        [[ -e "${host_p}" ]] || continue
        add_prepared_bind_once --ro-bind "${host_p}" "${sand_p}"
    done

    for resource_path in "${PI_AGENT_ROOT_CONFIG_FILES[@]}"; do
        host_p="${PI_AGENT_DIR}/${resource_path}"
        sand_p="${SANDBOX_PI_AGENT_DIR}/${resource_path}"
        [[ -e "${host_p}" ]] || continue
        add_prepared_bind_once --ro-bind "${host_p}" "${sand_p}"
    done
}

bind_pi_agent_tmpfs_root() {
    add_parent_dirs_once "$(dirname "${SANDBOX_PI_AGENT_DIR}")"
    EXTRA_BINDS+=(--tmpfs "${SANDBOX_PI_AGENT_DIR}")
}

bind_nearest_project_openspec() {
    local logical_search_dir
    local resolved_logical_search_dir
    local resolved_source_search_dir
    local openspec_dir
    local logical_openspec_dir
    local source_openspec_dir

    if [[ "${TARGET_KIND}" == "dir" ]]; then
        logical_search_dir="${TARGET_PATH}"
    else
        logical_search_dir="${TARGET_PARENT_DIR}"
    fi

    while [[ -n "${logical_search_dir}" && "${logical_search_dir}" != "/" ]]; do
        openspec_dir="${logical_search_dir}/openspec"
        if is_project_openspec_dir "${openspec_dir}"; then
            resolve_project_openspec_source "${openspec_dir}"
            source_openspec_dir="${REPLY}"
            # If OpenSpec is inside the primary project bind, normal protected
            # control-dir overlays handle it. Nested targets need the nearest
            # sibling/ancestor OpenSpec tree exposed explicitly for Pi footer
            # parity, without exposing the rest of that parent directory.
            if [[ "${logical_search_dir}" != "${PROJECT_DIR}" ]]; then
                add_prepared_bind_once --ro-bind "${source_openspec_dir}" "${openspec_dir}"
                info "OpenSpec footer: mounted nearest project-local openspec/ read-only"
            fi
            if [[ "${source_openspec_dir}" != "${openspec_dir}" ]]; then
                add_prepared_bind_once --ro-bind "${source_openspec_dir}" "${source_openspec_dir}"
                info "OpenSpec footer: mounted resolved project-local openspec/ read-only"
            fi
            return 0
        fi
        logical_search_dir="$(dirname "${logical_search_dir}")"
    done

    if [[ "${TARGET_SOURCE_PATH}" == "${TARGET_PATH}" ]]; then
        return 0
    fi

    if [[ "${TARGET_KIND}" == "dir" ]]; then
        resolved_logical_search_dir="${TARGET_PATH}"
        resolved_source_search_dir="${TARGET_SOURCE_PATH}"
    else
        resolved_logical_search_dir="${TARGET_PARENT_DIR}"
        resolved_source_search_dir="${TARGET_SOURCE_PARENT_DIR}"
    fi

    while [[ -n "${resolved_source_search_dir}" && "${resolved_source_search_dir}" != "/" && \
        -n "${resolved_logical_search_dir}" && "${resolved_logical_search_dir}" != "/" ]]; do
        source_openspec_dir="${resolved_source_search_dir}/openspec"
        logical_openspec_dir="${resolved_logical_search_dir}/openspec"
        if is_project_openspec_dir "${source_openspec_dir}"; then
            add_prepared_bind_once --ro-bind "${source_openspec_dir}" "${logical_openspec_dir}"
            if [[ "${source_openspec_dir}" != "${logical_openspec_dir}" ]]; then
                add_prepared_bind_once --ro-bind "${source_openspec_dir}" "${source_openspec_dir}"
            fi
            info "OpenSpec footer: mounted resolved nearest project-local openspec/ read-only"
            return 0
        fi
        resolved_source_search_dir="$(dirname "${resolved_source_search_dir}")"
        resolved_logical_search_dir="$(dirname "${resolved_logical_search_dir}")"
    done
}

is_project_openspec_dir() {
    local openspec_dir="$1"

    [[ -d "${openspec_dir}" ]] || return 1
    [[ -d "${openspec_dir}/changes" || -d "${openspec_dir}/specs" ]]
}

resolve_project_openspec_source() {
    local openspec_dir="$1"
    local child
    local resolved_child
    local candidate

    for child in changes specs; do
        if [[ -L "${openspec_dir}/${child}" ]]; then
            resolved_child="$(realpath "${openspec_dir}/${child}" 2>/dev/null || true)"
            [[ -n "${resolved_child}" ]] || continue
            candidate="$(dirname "${resolved_child}")"
            if is_project_openspec_dir "${candidate}"; then
                REPLY="${candidate}"
                return 0
            fi
        fi
    done

    REPLY="${openspec_dir}"
}

is_safe_pi_socket_env_name() {
    local env_name="$1"

    case "${env_name}" in
    PI_*SOCKET*) ;;
    *) return 1 ;;
    esac
    case "${env_name}" in
    *AUTH* | *TOKEN* | *SECRET* | *CREDENTIAL* | *PASSWORD* | *KEY* | *SSH* | *GPG*) return 1 ;;
    esac
    case "${env_name}" in
    *STATUS* | *TASK* | *TODO* | *PLAN* | *JOB* | *RUN* | *UI* | *FOOTER*) return 0 ;;
    *) return 1 ;;
    esac
}

is_safe_pi_socket_path() {
    local host_p="$1"
    local runtime_root="${XDG_RUNTIME_DIR:-}"

    [[ "${host_p}" == /* ]] || return 1
    [[ -S "${host_p}" ]] || return 1
    if [[ -n "${runtime_root}" && "${runtime_root}" == /* ]] && is_path_within "${runtime_root}" "${host_p}"; then
        return 0
    fi
    is_path_within /tmp "${host_p}"
}

bind_pi_socket_envs() {
    local env_name
    local env_output
    local host_p
    local sand_p

    env_output="$(compgen -e || true)"
    while IFS= read -r env_name; do
        [[ -n "${env_name}" ]] || continue
        is_safe_pi_socket_env_name "${env_name}" || continue
        host_p="${!env_name:-}"
        is_safe_pi_socket_path "${host_p}" || continue
        map_host_path_to_sandbox "${host_p}"
        sand_p="${REPLY}"
        bind_runtime_dir_precreated "${host_p}" "${sand_p}"
        add_sandbox_env_once "${env_name}" "${sand_p}"
        info "Pi integration: mounted exact ${env_name} socket"
    done <<<"${env_output}"
}

bind_pi_binary_package_tree() {
    local pi_bin_real="$1"
    local candidate
    local resolved_candidate
    local sand_candidate
    local -a pnpm_home_candidates=()

    if [[ -n "${PNPM_HOME:-}" && "${PNPM_HOME}" == /* ]]; then
        pnpm_home_candidates+=("${PNPM_HOME}")
    fi
    if [[ -n "${XDG_DATA_HOME:-}" && "${XDG_DATA_HOME}" == /* ]]; then
        pnpm_home_candidates+=("${XDG_DATA_HOME}/pnpm")
    fi
    pnpm_home_candidates+=("${HOST_HOME}/.local/share/pnpm")

    for candidate in "${pnpm_home_candidates[@]}"; do
        [[ -d "${candidate}" ]] || continue
        resolved_candidate="$(realpath "${candidate}" 2>/dev/null || true)"
        [[ -n "${resolved_candidate}" ]] || continue
        is_path_within "${resolved_candidate}" "${pi_bin_real}" || continue

        sand_candidate="${candidate}"
        if [[ "${ALLOW_HOST_TOOLS}" -eq 1 ]]; then
            info "Pi integration: pnpm package tree will use the shared writable development store"
            return 0
        fi
        opt_ro_bind_dir "${candidate}" "${sand_candidate}"
        info "Pi integration: mounted pnpm package tree read-only because host tools are disabled"
        return 0
    done

    return 1
}

add_custom_bind() {
    local bind_flag="$1"
    local requested_path="$2"
    local resolved_path

    if [[ ! -e "${requested_path}" ]]; then
        error "added path does not exist: ${requested_path}"
        exit 1
    fi
    resolved_path="$(realpath "${requested_path}")"
    add_prepared_bind_once "${bind_flag}" "${resolved_path}" "${resolved_path}"
}

cleanup_file_mode_tmp_dir() {
    if [[ -n "${FILE_MODE_TMP_DIR:-}" && -d "${FILE_MODE_TMP_DIR}" ]]; then
        rm -rf -- "${FILE_MODE_TMP_DIR}"
    fi
}

prepare_single_file_overlay() {
    local entry
    local target_name
    local target_parent_container
    local had_dotglob=0
    local had_nullglob=0

    target_name="$(basename "${TARGET_SOURCE_PATH}")"
    FILE_MODE_TMP_DIR="$(mktemp -d /tmp/devbox-filemode-XXXXXX)"
    FILE_MODE_PARENT_DIR="${FILE_MODE_TMP_DIR}/parent"
    FILE_MODE_TARGET_PATH="${FILE_MODE_PARENT_DIR}/${target_name}"
    FILE_MODE_RO_SOURCE_SANDBOX_PATH="/tmp/.devbox-ro-parent-$$"

    mkdir -p -- "${FILE_MODE_PARENT_DIR}"
    cp -p -- "${TARGET_SOURCE_PATH}" "${FILE_MODE_TARGET_PATH}"

    shopt -q dotglob && had_dotglob=1
    shopt -q nullglob && had_nullglob=1
    shopt -s dotglob nullglob
    for entry in "${PROJECT_SOURCE_DIR}"/*; do
        [[ "$(basename "${entry}")" == "${target_name}" ]] && continue
        ln -s "${FILE_MODE_RO_SOURCE_SANDBOX_PATH}/$(basename "${entry}")" \
            "${FILE_MODE_PARENT_DIR}/$(basename "${entry}")"
    done
    ((had_dotglob)) || shopt -u dotglob
    ((had_nullglob)) || shopt -u nullglob

    FILE_MODE_BINDS=(--ro-bind "${PROJECT_SOURCE_DIR}" "${FILE_MODE_RO_SOURCE_SANDBOX_PATH}")
    target_parent_container="$(dirname "${SANDBOX_PROJECT_ROOT}")"
    if [[ "${target_parent_container}" != "/" ]]; then
        FILE_MODE_BINDS+=(--ro-bind "${target_parent_container}" "${target_parent_container}")
    fi
    FILE_MODE_BINDS+=(--bind "${FILE_MODE_PARENT_DIR}" "${SANDBOX_PROJECT_ROOT}")
}

sync_single_file_target_back() {
    local temporary_target="${TARGET_SOURCE_PATH}.devbox-tmp.$$"

    if [[ ! -f "${FILE_MODE_TARGET_PATH}" ]]; then
        error "single-file target disappeared during sandbox session: ${TARGET_SOURCE_PATH}"
        return 1
    fi
    if ! cp -p -- "${FILE_MODE_TARGET_PATH}" "${temporary_target}"; then
        rm -f -- "${temporary_target}"
        return 1
    fi
    if ! mv -f -- "${temporary_target}" "${TARGET_SOURCE_PATH}"; then
        rm -f -- "${temporary_target}"
        return 1
    fi
}

resolve_target_mode() {
    local requested_target="$1"
    local logical_target
    local resolved_target

    if [[ ! -e "${requested_target}" ]]; then
        error "target path does not exist: ${requested_target}"
        exit 1
    fi

    if [[ "${requested_target}" == /* ]]; then
        logical_target="${requested_target}"
    else
        logical_target="${PWD}/${requested_target}"
    fi
    resolved_target="$(realpath "${requested_target}")"
    if [[ -d "${resolved_target}" ]]; then
        TARGET_KIND="dir"
        TARGET_PATH="${logical_target}"
        TARGET_SOURCE_PATH="${resolved_target}"
        TARGET_PARENT_DIR="$(dirname "${logical_target}")"
        TARGET_SOURCE_PARENT_DIR="$(dirname "${resolved_target}")"
        return
    fi
    if [[ -f "${resolved_target}" ]]; then
        TARGET_KIND="file"
        TARGET_PATH="${logical_target}"
        TARGET_SOURCE_PATH="${resolved_target}"
        TARGET_PARENT_DIR="$(dirname "${logical_target}")"
        TARGET_SOURCE_PARENT_DIR="$(dirname "${resolved_target}")"
        return
    fi

    error "target must be a directory or regular file: ${requested_target}"
    exit 1
}

find_cargo_workspace_root() {
    local start_dir="$1"
    local manifest_path="${start_dir}/Cargo.toml"
    local workspace_manifest=""
    local current_dir

    [[ -f "${manifest_path}" ]] || return 1
    if command -v cargo >/dev/null 2>&1; then
        workspace_manifest="$(cargo locate-project --workspace --manifest-path "${manifest_path}" --message-format plain 2>/dev/null || true)"
        if [[ -n "${workspace_manifest}" && -f "${workspace_manifest}" ]]; then
            dirname "$(realpath "${workspace_manifest}")"
            return 0
        fi
    fi

    current_dir="${start_dir}"
    while [[ "${current_dir}" != "/" ]]; do
        if [[ -f "${current_dir}/Cargo.toml" ]] && grep -Eq '^[[:space:]]*\[workspace\]' "${current_dir}/Cargo.toml"; then
            realpath "${current_dir}"
            return 0
        fi
        current_dir="$(dirname "${current_dir}")"
    done
    return 1
}

find_repository_root() {
    local current_dir="$1"

    while [[ "${current_dir}" != / ]]; do
        if [[ -d "${current_dir}/.git" || -f "${current_dir}/.git" ]]; then
            printf '%s\n' "$(realpath "${current_dir}")"
            return 0
        fi
        current_dir="$(dirname "${current_dir}")"
    done
    return 1
}

is_explicit_rw_path_covering() {
    local candidate="$1"
    local configured_path
    local resolved_path

    for configured_path in "${ADD_RW_PATHS[@]}"; do
        resolved_path="$(realpath -m "${configured_path}")"
        if is_path_within "${resolved_path}" "${candidate}"; then
            return 0
        fi
    done
    return 1
}

bind_cargo_path_dependencies() {
    local start_dir="$1"
    local repository_root
    local current_dir
    local manifest_path
    local line
    local dependency_path
    local dependency_dir
    local processed=0
    local -a pending_dirs=("${start_dir}")
    local -A visited_dirs=()

    repository_root="$(find_repository_root "${start_dir}" || true)"
    while [[ ${#pending_dirs[@]} -gt 0 ]]; do
        current_dir="${pending_dirs[0]}"
        pending_dirs=("${pending_dirs[@]:1}")
        [[ -z "${visited_dirs[${current_dir}]:-}" ]] || continue
        visited_dirs["${current_dir}"]=1
        processed=$((processed + 1))
        if ((processed > 128)); then
            error "Cargo path dependency graph exceeds the 128-directory safety limit"
            exit 1
        fi
        manifest_path="${current_dir}/Cargo.toml"
        [[ -f "${manifest_path}" ]] || continue

        while IFS= read -r line; do
            if [[ "${line}" =~ path[[:space:]]*=[[:space:]]*\"([^\"]+)\" ]]; then
                dependency_path="${BASH_REMATCH[1]}"
            elif [[ "${line}" =~ path[[:space:]]*=[[:space:]]*\'([^\']+)\' ]]; then
                dependency_path="${BASH_REMATCH[1]}"
            else
                continue
            fi
            if [[ "${dependency_path}" == /* ]]; then
                dependency_dir="$(realpath -m "${dependency_path}")"
            else
                dependency_dir="$(realpath -m "${current_dir}/${dependency_path}")"
            fi
            [[ -d "${dependency_dir}" && -f "${dependency_dir}/Cargo.toml" ]] || continue
            if [[ -z "${repository_root}" ]] || ! is_path_within "${repository_root}" "${dependency_dir}"; then
                error "Cargo path dependency escapes the selected repository: ${dependency_dir}"
                error "select the repository root or authorize it explicitly with --add/--add-rw"
                exit 1
            fi
            pending_dirs+=("${dependency_dir}")
            if is_path_within "${TARGET_SOURCE_PATH}" "${dependency_dir}" ||
                is_explicit_rw_path_covering "${dependency_dir}"; then
                continue
            fi
            if [[ -z "${CARGO_PATH_DEPENDENCY_SET[${dependency_dir}]:-}" ]]; then
                CARGO_PATH_DEPENDENCY_SET["${dependency_dir}"]=1
                CARGO_PATH_DEPENDENCY_DIRS+=("${dependency_dir}")
                add_prepared_bind_once --ro-bind "${dependency_dir}" "${dependency_dir}"
                info "Cargo path dependency: mounted read-only (${dependency_dir})"
            fi
        done <"${manifest_path}"
    done
}

cargo_workspace_expand_target() {
    local workspace_root=""

    [[ "${TARGET_KIND}" == "dir" ]] || return 0
    [[ "${TARGET_PATH}" == "${TARGET_SOURCE_PATH}" ]] || return 0
    [[ -f "${TARGET_SOURCE_PATH}/Cargo.toml" ]] || return 0

    workspace_root="$(find_cargo_workspace_root "${TARGET_SOURCE_PATH}" || true)"
    [[ "${workspace_root}" != "${TARGET_SOURCE_PATH}" ]] || workspace_root=""
    if [[ -z "${workspace_root}" ]]; then
        bind_cargo_path_dependencies "${TARGET_SOURCE_PATH}"
    fi
    if [[ -z "${workspace_root}" ]] && grep -Eq 'workspace[[:space:]]*=[[:space:]]*true' "${TARGET_SOURCE_PATH}/Cargo.toml"; then
        workspace_root="${TARGET_SOURCE_PARENT_DIR}"
    fi
    if [[ -z "${workspace_root}" || "${workspace_root}" == "${TARGET_SOURCE_PATH}" ]]; then
        return 0
    fi
    is_path_within "${workspace_root}" "${TARGET_SOURCE_PATH}" || return 0

    PROJECT_DIR="${workspace_root}"
    PROJECT_SOURCE_DIR="${workspace_root}"
    SANDBOX_PROJECT_ROOT="${workspace_root}"
    SANDBOX_WORKDIR="${TARGET_SOURCE_PATH}"
    info "Detected Cargo workspace root: ${workspace_root}"
}

check_bwrap_namespace_support() {
    local probe_output
    local -a probe_cmd

    if [[ "${DEVBOX_FORCE_PROBE:-0}" == "1" ]]; then
        return 0
    fi

    probe_cmd=(
        bwrap
        --unshare-user-try
        --ro-bind /usr /usr
        --ro-bind /bin /bin
        --ro-bind /lib /lib
        --proc /proc
        --dev /dev
    )
    [[ -d /lib64 ]] && probe_cmd+=(--ro-bind /lib64 /lib64)
    probe_cmd+=(-- /bin/sh -c 'exit 0')

    if probe_output="$("${probe_cmd[@]}" 2>&1)"; then
        return 0
    fi

    case "${probe_output}" in
    *"Creating new namespace failed"* | *"max_"*"_namespaces exceeded"* | *"(ENOSPC)"*)
        error "bubblewrap cannot create the namespaces devbox needs in this environment"
        error "run devbox from a normal host shell or enable unprivileged user namespaces"
        return 1
        ;;
    esac

    error "bubblewrap namespace probe failed: ${probe_output}"
    return 1
}

prepare_command_binary() {
    local command_token="${RAW_COMMAND[0]}"
    local command_host=""
    local command_real=""

    if [[ "${command_token}" == */* ]]; then
        if [[ "${command_token}" == /* ]]; then
            command_host="${command_token}"
        else
            command_host="${PWD}/${command_token}"
        fi
    else
        command_host="$(command -v "${command_token}" 2>/dev/null || true)"
    fi
    if [[ "${command_host}" != /* || ! -x "${command_host}" ]]; then
        error "command not found or not executable: ${command_token}"
        exit 1
    fi
    command_real="$(realpath "${command_host}")"
    RAW_COMMAND[0]="${command_real}"

    case "${command_real}" in
    /usr/* | /bin/* | /sbin/*) return 0 ;;
    esac
    add_parent_dirs_once "$(dirname "${command_real}")"
    add_extra_bind_once --ro-bind "${command_real}" "${command_real}"
}

discover_pi_binary() {
    PI_BIN_HOST="$(command -v "${PI_BIN}" 2>/dev/null || true)"
    if [[ -z "${PI_BIN_HOST}" ]]; then
        error "pi binary not found: ${PI_BIN}"
        exit 1
    fi
    if [[ ! -x "${PI_BIN_HOST}" ]]; then
        error "pi binary is not executable: ${PI_BIN_HOST}"
        exit 1
    fi

    PI_BIN_REAL="$(realpath "${PI_BIN_HOST}")"
    PI_BIN_SANDBOX="${PI_BIN_REAL}"

    add_parent_dirs_once "$(dirname "${PI_BIN_REAL}")"
    case "${PI_BIN_REAL}" in
    /usr/* | /bin/* | /sbin/*) ;;
    *)
        if ! bind_pi_binary_package_tree "${PI_BIN_REAL}"; then
            add_extra_bind_once --ro-bind "${PI_BIN_REAL}" "${PI_BIN_REAL}"
        fi
        ;;
    esac
}

has_explicit_opencode_port() {
    local argument
    local index

    for ((index = 1; index < ${#RAW_COMMAND[@]}; index++)); do
        argument="${RAW_COMMAND[index]}"
        case "${argument}" in
        --port | --port=*) return 0 ;;
        esac
    done
    return 1
}

is_opencode_port_live() {
    local port="$1"
    local timeout_seconds="${DEVBOX_PORT_PROBE_TIMEOUT:-0.3}"
    local bash_bin="${BASH:-bash}"

    case "${port}" in
    '' | *[!0-9]*) return 1 ;;
    esac
    ((port >= 1 && port <= 65535)) || return 1
    command -v timeout >/dev/null 2>&1 || return 1
    # shellcheck disable=SC2016 # $1 expands inside the probe shell.
    timeout "${timeout_seconds}" "${bash_bin}" -c ':</dev/tcp/127.0.0.1/$1' _ "${port}" >/dev/null 2>&1
}

apply_nvim_opencode_port_default() {
    local command_name

    command_name="$(basename -- "${RAW_COMMAND[0]}")"
    [[ "${command_name}" == "opencode" ]] || return 0
    [[ -n "${NVIM_OPENCODE_PORT:-}" ]] || return 0
    has_explicit_opencode_port && return 0
    is_opencode_port_live "${NVIM_OPENCODE_PORT}" || return 0
    RAW_COMMAND=("${RAW_COMMAND[0]}" --port "${NVIM_OPENCODE_PORT}" "${RAW_COMMAND[@]:1}")
}

run_opencode_plugin_preflight() {
    local command_name
    local script_dir
    local integrity_helper
    local config_path="${XDG_CONFIG_HOME:-${HOST_HOME}/.config}/opencode/opencode.json"
    local package_cache="${XDG_CACHE_HOME:-${HOST_HOME}/.cache}/opencode/packages"
    local integrity_cache="${XDG_CACHE_HOME:-${HOST_HOME}/.cache}/devbox/opencode/plugin-integrity-v1.bin"

    command_name="$(basename -- "${RAW_COMMAND[0]}")"
    [[ "${command_name}" == "opencode" ]] || return 0
    case "${RAW_COMMAND[1]:-}" in
    plugin | plug) return 0 ;;
    esac

    script_dir="$(cd -- "$(dirname -- "$(realpath "${BASH_SOURCE[0]}")")" && pwd -P)"
    integrity_helper="${script_dir}/devbox-opencode-integrity"
    if [[ ! -x "${integrity_helper}" ]]; then
        error "OpenCode plugin integrity helper is missing: ${integrity_helper}"
        return 1
    fi
    if [[ "${EPHEMERAL_STATE}" -eq 1 ]]; then
        DEVBOX_OPENCODE_INTEGRITY_NO_CACHE=1 \
            "${integrity_helper}" "${config_path}" "${package_cache}" "${integrity_cache}" || {
                error "OpenCode plugin preflight failed; repair the listed plugins before launch"
                return 1
            }
        return 0
    fi
    if ! "${integrity_helper}" "${config_path}" "${package_cache}" "${integrity_cache}"; then
        error "OpenCode plugin preflight failed; repair the listed plugins before launch"
        return 1
    fi
}

prepare_opencode_command_guard() {
    local script_dir
    local guard_host
    local helper_host
    local opencode_host
    local opencode_real
    local guard_sandbox="/devbox/bin/opencode"
    local helper_sandbox="/devbox/lib/devbox-opencode-integrity"

    opencode_host="$(command -v opencode 2>/dev/null || true)"
    [[ "${opencode_host}" == /* && -x "${opencode_host}" ]] || return 0
    opencode_real="$(realpath "${opencode_host}")"
    script_dir="$(cd -- "$(dirname -- "$(realpath "${BASH_SOURCE[0]}")")" && pwd -P)"
    guard_host="${script_dir}/devbox-opencode-guard"
    helper_host="${script_dir}/devbox-opencode-integrity"
    if [[ ! -x "${guard_host}" || ! -x "${helper_host}" ]]; then
        error "OpenCode command guard or integrity helper is missing from ${script_dir}"
        exit 1
    fi

    case "${opencode_real}" in
    /usr/* | /bin/* | /sbin/*) ;;
    *) add_prepared_bind_once --ro-bind "${opencode_real}" "${opencode_real}" ;;
    esac
    add_prepared_bind_once --ro-bind "${guard_host}" "${guard_sandbox}"
    add_prepared_bind_once --ro-bind "${helper_host}" "${helper_sandbox}"
    add_sandbox_env_once DEVBOX_REAL_OPENCODE "${opencode_real}"
    add_sandbox_env_once DEVBOX_OPENCODE_INTEGRITY_HELPER "${helper_sandbox}"
    SANDBOX_PATH="/devbox/bin:${SANDBOX_PATH}"
}

discover_git_wrapper() {
    local script_dir
    local requested_scoder_git
    local requested_real_git
    local requested_scoder_git_real
    local requested_real_git_real

    script_dir="$(cd -- "$(dirname -- "$(realpath "${BASH_SOURCE[0]}")")" && pwd -P)"
    requested_scoder_git="${SCODER_GIT:-${script_dir}/scoder-git}"
    requested_real_git="$(command -v git 2>/dev/null || true)"

    if [[ ! -x "${requested_scoder_git}" ]]; then
        error "scoder-git wrapper not found or not executable: ${requested_scoder_git}"
        exit 1
    fi
    if [[ -z "${requested_real_git}" || ! -x "${requested_real_git}" ]]; then
        error "real git binary not found in host PATH"
        exit 1
    fi
    requested_scoder_git_real="$(realpath "${requested_scoder_git}")"
    requested_real_git_real="$(realpath "${requested_real_git}")"

    if is_discovery_cache_current "${DEVBOX_CACHE_BWRAP_PATH}" "${DEVBOX_CACHE_BWRAP_VERSION}" &&
        [[ "${DEVBOX_CACHE_SCODER_GIT_HOST:-}" == "${requested_scoder_git}" ]] &&
        [[ "${DEVBOX_CACHE_SCODER_GIT_REALPATH:-}" == "${requested_scoder_git_real}" && -x "${requested_scoder_git_real}" ]]; then
        SCODER_GIT_HOST="${requested_scoder_git_real}"
    else
        SCODER_GIT_HOST="${requested_scoder_git_real}"
        DEVBOX_CACHE_SCODER_GIT_HOST="${requested_scoder_git}"
        DEVBOX_CACHE_SCODER_GIT_REALPATH="${SCODER_GIT_HOST}"
    fi

    if is_discovery_cache_current "${DEVBOX_CACHE_BWRAP_PATH}" "${DEVBOX_CACHE_BWRAP_VERSION}" &&
        [[ "${DEVBOX_CACHE_REAL_GIT_HOST:-}" == "${requested_real_git}" ]] &&
        [[ "${DEVBOX_CACHE_REAL_GIT_REALPATH:-}" == "${requested_real_git_real}" && -x "${requested_real_git_real}" ]]; then
        REAL_GIT_HOST="${requested_real_git_real}"
    else
        REAL_GIT_HOST="${requested_real_git_real}"
        DEVBOX_CACHE_REAL_GIT_HOST="${requested_real_git}"
        DEVBOX_CACHE_REAL_GIT_REALPATH="${REAL_GIT_HOST}"
    fi
    write_discovery_cache
}

opt_ro_bind_terminal_file() {
    local host_p="$1"
    local sand_p="$2"
    local label="$3"

    [[ -e "${host_p}" ]] || return 0
    opt_ro_bind_path "${host_p}" "${sand_p}"
    info "Terminal integration: mounted ${label} read-only"
}

bind_zsh_startup_files() {
    local host_dir="$1"
    local sand_dir="$2"
    local zsh_file
    local -a zsh_startup_files=(.zshenv .zshrc .zprofile .zlogin)

    for zsh_file in "${zsh_startup_files[@]}"; do
        opt_ro_bind_terminal_file "${host_dir}/${zsh_file}" "${sand_dir}/${zsh_file}" "${zsh_file}"
    done
}

bind_terminal_socket_path() {
    local env_name="$1"
    local host_p="$2"
    local sand_p

    if [[ -z "${host_p}" ]]; then
        return 1
    fi
    case "${host_p}" in
    /*) ;;
    *)
        warning "not forwarding ${env_name}; socket path is not absolute: ${host_p}"
        return 1
        ;;
    esac
    if [[ ! -S "${host_p}" ]]; then
        warning "not forwarding ${env_name}; not an existing Unix socket: ${host_p}"
        return 1
    fi

    map_host_path_to_sandbox "${host_p}"
    sand_p="${REPLY}"
    bind_runtime_dir_precreated "${host_p}" "${sand_p}"
    info "Terminal integration: mounted ${env_name} socket ${host_p}"
    REPLY="${sand_p}"
}

bind_terminal_socket_env() {
    local env_name="$1"
    local host_p="${!env_name:-}"
    local sand_p

    bind_terminal_socket_path "${env_name}" "${host_p}" || return 0
    sand_p="${REPLY}"
    add_sandbox_env_once "${env_name}" "${sand_p}"
}

bind_tmux_socket_env() {
    local tmux_value="${TMUX:-}"
    local tmux_socket
    local tmux_suffix
    local sand_socket

    [[ -n "${tmux_value}" ]] || return 0
    tmux_socket="${tmux_value%%,*}"
    tmux_suffix="${tmux_value#"${tmux_socket}"}"

    bind_terminal_socket_path TMUX "${tmux_socket}" || return 0
    sand_socket="${REPLY}"
    add_sandbox_env_once TMUX "${sand_socket}${tmux_suffix}"
    if [[ -n "${TMUX_PANE:-}" ]]; then
        add_sandbox_env_once TMUX_PANE "${TMUX_PANE}"
    fi
}

bind_terminal_integration() {
    local xdg_starship=""
    local sand_xdg_starship=""
    local zdotdir_sandbox=""

    opt_ro_bind_terminal_file "${HOST_HOME}/.config/starship.toml" "${SANDBOX_HOME}/.config/starship.toml" starship.toml

    if [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
        xdg_starship="${XDG_CONFIG_HOME}/starship.toml"
        map_host_path_to_sandbox "${xdg_starship}"
        sand_xdg_starship="${REPLY}"
        opt_ro_bind_terminal_file "${xdg_starship}" "${sand_xdg_starship}" XDG_CONFIG_HOME/starship.toml
    fi

    bind_zsh_startup_files "${HOST_HOME}" "${SANDBOX_HOME}"
    if [[ -n "${ZDOTDIR:-}" ]]; then
        if [[ "${ZDOTDIR}" == /* ]] && is_path_within "${HOST_HOME}" "${ZDOTDIR}"; then
            map_host_path_to_sandbox "${ZDOTDIR}"
            zdotdir_sandbox="${REPLY}"
            bind_zsh_startup_files "${ZDOTDIR}" "${zdotdir_sandbox}"
        else
            warning "not mounting ZDOTDIR; it is outside HOME or not absolute: ${ZDOTDIR}"
        fi
    fi

    if [[ "${ALLOW_TERMINAL_SOCKETS}" -eq 1 ]]; then
        if [[ "${ALLOW_NVIM_REMOTE}" -eq 1 ]]; then
            bind_terminal_socket_env NVIM
            bind_terminal_socket_env NVIM_LISTEN_ADDRESS
        fi
        bind_tmux_socket_env
    fi
}

bind_aws_integration() {
    local host_aws_dir="${HOST_HOME}/.aws"
    local sandbox_aws_dir="${SANDBOX_HOME}/.aws"
    local env_name
    local host_path
    local sandbox_path

    [[ "${ALLOW_AWS}" -eq 1 ]] || return 0

    if [[ -d "${host_aws_dir}" ]]; then
        opt_ro_bind_dir "${host_aws_dir}" "${sandbox_aws_dir}"
        bind_runtime_dir "${host_aws_dir}/sso/cache" "${sandbox_aws_dir}/sso/cache"
        bind_runtime_dir "${host_aws_dir}/cli/cache" "${sandbox_aws_dir}/cli/cache"
        info "AWS integration: configuration is read-only; SSO/CLI caches are writable"
    fi

    for env_name in AWS_CONFIG_FILE AWS_SHARED_CREDENTIALS_FILE AWS_WEB_IDENTITY_TOKEN_FILE AWS_CA_BUNDLE; do
        host_path="${!env_name:-}"
        [[ -n "${host_path}" ]] || continue
        if [[ "${host_path}" != /* ]]; then
            host_path="$(realpath -m "${PWD}/${host_path}")"
        fi
        if [[ ! -f "${host_path}" || ! -r "${host_path}" ]]; then
            error "${env_name} does not name a readable file: ${host_path}"
            exit 1
        fi
        map_host_path_to_sandbox "${host_path}"
        sandbox_path="${REPLY}"
        opt_ro_bind_path "${host_path}" "${sandbox_path}"
        add_sandbox_env_once "${env_name}" "${sandbox_path}"
    done
}

bind_symlink_targets_in_dir() {
    local bind_flag="$1"
    local host_dir="$2"
    local host_path
    local resolved_target
    local target_sandbox_path
    local had_nullglob=0
    local had_dotglob=0
    local -a symlink_candidates=()

    [[ -d "${host_dir}" ]] || return 0
    shopt -q nullglob && had_nullglob=1
    shopt -q dotglob && had_dotglob=1
    shopt -s nullglob dotglob
    symlink_candidates=("${host_dir}"/*)
    ((had_nullglob)) || shopt -u nullglob
    ((had_dotglob)) || shopt -u dotglob

    for host_path in "${symlink_candidates[@]}"; do
        [[ -L "${host_path}" ]] || continue
        resolved_target="$(realpath "${host_path}")"
        map_host_path_to_sandbox "${resolved_target}"
        target_sandbox_path="${REPLY}"
        add_prepared_bind_once "${bind_flag}" "${resolved_target}" "${target_sandbox_path}"
    done
}

bind_opencode_state() {
    local relative_path
    local host_config_root="${XDG_CONFIG_HOME:-${HOST_HOME}/.config}"
    local host_data_root="${XDG_DATA_HOME:-${HOST_HOME}/.local/share}"
    local host_cache_root="${XDG_CACHE_HOME:-${HOST_HOME}/.cache}"
    local host_opencode_config="${host_config_root}/opencode"
    local host_openspec_config="${host_config_root}/openspec"
    local host_opencode_data="${host_data_root}/opencode"
    local host_opencode_cache="${host_cache_root}/opencode"
    local sandbox_openspec_config="${SANDBOX_HOME}/.config/openspec"
    local openspec_destination_reserved=0
    local -a ephemeral_paths=(
        ".local/share/opencode"
        ".cache/opencode"
        ".cache/devbox/opencode"
        ".opencode"
        ".bun"
        ".cache/bun"
        ".cache/ms-playwright"
        ".opencode-browser"
    )

    [[ -n "${EXTRA_BIND_DEST_SET[${sandbox_openspec_config}]:-}" ]] && openspec_destination_reserved=1

    if [[ "${EPHEMERAL_STATE}" -eq 1 ]]; then
        opt_ro_bind_dir "${host_opencode_config}" "${SANDBOX_HOME}/.config/opencode"
        if [[ "${openspec_destination_reserved}" -eq 0 ]]; then
            opt_ro_bind_dir "${host_openspec_config}" "${sandbox_openspec_config}"
        else
            info "OpenSpec state: preserving the project-specific read-only mount"
        fi
        opt_ro_bind_dir "${HOST_HOME}/.agents" "${SANDBOX_HOME}/.agents"
        opt_ro_bind_dir "${HOST_HOME}/.claude" "${SANDBOX_HOME}/.claude"
        for relative_path in "${ephemeral_paths[@]}"; do
            add_extra_dir_once "${SANDBOX_HOME}/${relative_path}"
        done
        opt_ro_bind_dir "${host_opencode_cache}/packages" "${SANDBOX_HOME}/.cache/opencode/packages"
        bind_symlink_targets_in_dir --ro-bind "${host_opencode_config}"
        bind_symlink_targets_in_dir --ro-bind "${host_opencode_config}/agent"
        bind_symlink_targets_in_dir --ro-bind "${host_opencode_config}/agents"
        if [[ "${openspec_destination_reserved}" -eq 0 ]]; then
            bind_symlink_targets_in_dir --ro-bind "${host_openspec_config}"
        fi
        return 0
    fi

    bind_runtime_dir "${host_opencode_config}" "${SANDBOX_HOME}/.config/opencode"
    if [[ "${openspec_destination_reserved}" -eq 0 ]]; then
        bind_runtime_dir "${host_openspec_config}" "${sandbox_openspec_config}"
    else
        info "OpenSpec state: preserving the project-specific read-only mount"
    fi
    bind_runtime_dir "${host_opencode_data}" "${SANDBOX_HOME}/.local/share/opencode"
    bind_runtime_dir "${host_opencode_cache}" "${SANDBOX_HOME}/.cache/opencode"
    bind_runtime_dir "${host_cache_root}/devbox/opencode" "${SANDBOX_HOME}/.cache/devbox/opencode"
    bind_runtime_dir "${HOST_HOME}/.opencode" "${SANDBOX_HOME}/.opencode"
    bind_runtime_dir "${HOST_HOME}/.agents" "${SANDBOX_HOME}/.agents"
    bind_runtime_dir "${HOST_HOME}/.bun" "${SANDBOX_HOME}/.bun"
    bind_runtime_dir "${host_cache_root}/bun" "${SANDBOX_HOME}/.cache/bun"
    bind_runtime_dir "${host_cache_root}/ms-playwright" "${SANDBOX_HOME}/.cache/ms-playwright"
    if [[ -d "${HOST_HOME}/.claude" ]]; then
        bind_runtime_dir "${HOST_HOME}/.claude" "${SANDBOX_HOME}/.claude"
    fi
    if [[ -d "${HOST_HOME}/.opencode-browser" ]]; then
        bind_runtime_dir "${HOST_HOME}/.opencode-browser" "${SANDBOX_HOME}/.opencode-browser"
    fi

    bind_symlink_targets_in_dir --bind "${host_opencode_config}"
    bind_symlink_targets_in_dir --bind "${host_opencode_config}/agent"
    bind_symlink_targets_in_dir --bind "${host_opencode_config}/agents"
    if [[ "${openspec_destination_reserved}" -eq 0 ]]; then
        bind_symlink_targets_in_dir --bind "${host_openspec_config}"
    fi
}

bind_clipboard_integration() {
    local runtime_dir="${XDG_RUNTIME_DIR:-}"
    local wayland_display="${WAYLAND_DISPLAY:-}"
    local wayland_socket=""
    local display_value="${DISPLAY:-}"
    local display_number=""
    local x11_socket=""
    local xauthority_path=""
    local sandbox_xauthority=""

    [[ "${ALLOW_CLIPBOARD}" -eq 1 ]] || return 0

    if [[ -n "${runtime_dir}" && "${runtime_dir}" == /* && -n "${wayland_display}" ]]; then
        if [[ "${wayland_display}" == /* ]]; then
            wayland_socket="${wayland_display}"
        else
            wayland_socket="${runtime_dir}/${wayland_display}"
        fi
        if [[ -S "${wayland_socket}" ]]; then
            bind_runtime_path_precreated "${wayland_socket}" "${wayland_socket}"
            add_sandbox_env_once XDG_RUNTIME_DIR "${runtime_dir}"
            add_sandbox_env_once WAYLAND_DISPLAY "${wayland_display}"
            info "Clipboard integration: exact Wayland socket forwarded"
        fi
    fi

    case "${display_value}" in
    :[0-9]* | unix:[0-9]*)
        display_number="${display_value#*:}"
        display_number="${display_number%%.*}"
        x11_socket="/tmp/.X11-unix/X${display_number}"
        if [[ -S "${x11_socket}" ]]; then
            bind_runtime_path_precreated "${x11_socket}" "${x11_socket}"
            add_sandbox_env_once DISPLAY "${display_value}"
            xauthority_path="${XAUTHORITY:-${HOST_HOME}/.Xauthority}"
            if [[ -e "${xauthority_path}" ]]; then
                map_host_path_to_sandbox "${xauthority_path}"
                sandbox_xauthority="${REPLY}"
                opt_ro_bind_path "${xauthority_path}" "${sandbox_xauthority}"
                add_sandbox_env_once XAUTHORITY "${sandbox_xauthority}"
            fi
            info "Clipboard integration: exact X11 socket forwarded"
        fi
        ;;
    esac
}

select_host_tool_home() {
    local env_value="$1"
    local preferred_path="$2"
    local legacy_path="$3"

    if [[ -n "${env_value}" ]]; then
        REPLY="${env_value}"
    elif [[ -d "${preferred_path}" || ! -d "${legacy_path}" ]]; then
        REPLY="${preferred_path}"
    else
        REPLY="${legacy_path}"
    fi
}

find_chromium_binary() {
    local candidate
    local -a candidates=()

    [[ -n "${DEVBOX_CHROMIUM_BIN:-}" ]] && candidates+=("${DEVBOX_CHROMIUM_BIN}")
    candidates+=(chromium google-chrome-stable google-chrome chrome)
    for candidate in "${candidates[@]}"; do
        if command -v "${candidate}" >/dev/null 2>&1; then
            command -v "${candidate}"
            return 0
        fi
    done
    return 1
}

is_devtools_endpoint_ready() {
    if command -v curl >/dev/null 2>&1; then
        curl --silent --show-error --fail "http://127.0.0.1:9222/json/version" >/dev/null 2>&1
        return $?
    fi
    if command -v python3 >/dev/null 2>&1; then
        python3 - <<'PY' >/dev/null 2>&1
import sys
import urllib.request
try:
    with urllib.request.urlopen("http://127.0.0.1:9222/json/version", timeout=1):
        pass
except Exception:
    sys.exit(1)
PY
        return $?
    fi
    return 1
}

ensure_chromium_devtools() {
    local chromium_bin
    local chromium_profile="${DEVBOX_CHROMIUM_PROFILE:-/tmp/devbox-chrome}"
    local chromium_log="${DEVBOX_CHROMIUM_LOG:-/tmp/devbox-chromium.log}"
    local attempt

    if is_devtools_endpoint_ready; then
        info "Chromium DevTools already available on 127.0.0.1:9222"
        return 0
    fi
    chromium_bin="$(find_chromium_binary || true)"
    if [[ -z "${chromium_bin}" ]]; then
        error "web-developer mode could not find a Chromium-compatible browser"
        error "set DEVBOX_CHROMIUM_BIN or install chromium/google-chrome"
        return 1
    fi

    mkdir -p -- "${chromium_profile}"
    info "Starting Chromium DevTools via ${chromium_bin}"
    nohup "${chromium_bin}" \
        --remote-debugging-port=9222 \
        --user-data-dir="${chromium_profile}" \
        --no-first-run \
        --no-default-browser-check \
        about:blank >"${chromium_log}" 2>&1 </dev/null &

    for ((attempt = 1; attempt <= 20; attempt++)); do
        is_devtools_endpoint_ready && return 0
        sleep 0.5
    done
    error "Chromium launched but DevTools endpoint did not become ready"
    error "check log: ${chromium_log}"
    return 1
}

is_stale_workspace_env_name() {
    local env_name="$1"

    case "${env_name}" in
    OPENCODE_API_KEY)
        return 1
        ;;
    OPENCODE*)
        return 0
        ;;
    NVIM_OPENCODE_PORT | NVIM_LOG_FILE | NVIM_THEME_COLOR | \
        USER_PREFIX | TMUX_WORKSPACE_ROOT | GALACTICA_HOME | MYVIMRC)
        return 0
        ;;
    *)
        return 1
        ;;
    esac
}

should_inherit_env() {
    local env_name="$1"

    is_stale_workspace_env_name "${env_name}" && return 1
    if [[ "${ALLOW_AWS:-1}" -eq 0 && "${env_name}" == AWS_* ]]; then
        return 1
    fi
    if [[ "${ALLOW_GUI:-0}" -eq 1 ]]; then
        case "${env_name}" in
        DISPLAY | WAYLAND_DISPLAY | XAUTHORITY | DBUS_SESSION_BUS_ADDRESS | SESSION_MANAGER)
            return 0
            ;;
        esac
    fi

    case "${env_name}" in
    HOME | PATH | PWD | OLDPWD | SHELL | SHLVL | _ | USER | LOGNAME | TERM | COLORTERM | LANG | LC_ALL | \
        XDG_CONFIG_HOME | XDG_DATA_HOME | XDG_STATE_HOME | XDG_CACHE_HOME | \
        EDITOR | VISUAL | PI_BIN | PI_CODING_AGENT_DIR | PI_SESSION_* | PI_PROVIDER | PI_MODEL | PI_REASONING_LEVEL | \
        PI_*SOCKET* | DEVBOX_* | TMPDIR | GIT_OPTIONAL_LOCKS | SSH_AUTH_SOCK | \
        GPG_AGENT_INFO | DBUS_SESSION_BUS_ADDRESS | SESSION_MANAGER | XAUTHORITY | DISPLAY | WAYLAND_DISPLAY | \
        NVIM | NVIM_LISTEN_ADDRESS | TMUX | TMUX_PANE | \
        PLAYWRIGHT_BROWSERS_PATH | MISE_SKIP_ACTIVATE | UV_LINK_MODE | PNPM_HOME | \
        PYENV_ROOT | RUSTUP_HOME | CARGO_HOME | GOPATH | GOBIN | PYO3_PYTHON)
        return 1
        ;;
    esac
    return 0
}

inherit_safe_environment() {
    local env_name
    local env_output

    env_output="$(compgen -e || true)"
    while IFS= read -r env_name; do
        if should_inherit_env "${env_name}" && [[ -n "${!env_name:-}" ]]; then
            BWRAP_CMD+=(--setenv "${env_name}" "${!env_name}")
        fi
    done <<<"${env_output}"
}

preserve_pi_session_environment() {
    local env_name
    local env_output

    env_output="$(compgen -e || true)"
    while IFS= read -r env_name; do
        case "${env_name}" in
        PI_SESSION_* | PI_PROVIDER | PI_MODEL | PI_REASONING_LEVEL)
            if [[ -n "${!env_name:-}" ]]; then
                add_sandbox_env_once "${env_name}" "${!env_name}"
            fi
            ;;
        esac
    done <<<"${env_output}"
}

run_doctor() {
    local status=0
    local script_dir
    local integrity_helper
    local opencode_config="${XDG_CONFIG_HOME:-${HOST_HOME}/.config}/opencode/opencode.json"
    local opencode_packages="${XDG_CACHE_HOME:-${HOST_HOME}/.cache}/opencode/packages"
    local opencode_cache="${XDG_CACHE_HOME:-${HOST_HOME}/.cache}/devbox/opencode/plugin-integrity-v1.bin"

    printf 'devbox doctor: running comprehensive validation\n'
    if run_devbox_validation; then
        :
    else
        status=$?
    fi

    script_dir="$(cd -- "$(dirname -- "$(realpath "${BASH_SOURCE[0]}")")" && pwd -P)"
    integrity_helper="${script_dir}/devbox-opencode-integrity"
    printf '\ndevbox doctor: checking current OpenCode configuration\n'
    if [[ ! -x "${integrity_helper}" ]]; then
        validation_fail "Doctor FAIL: missing OpenCode integrity helper (${integrity_helper})"
        status=1
    elif [[ "${EPHEMERAL_STATE}" -eq 1 ]] && \
        DEVBOX_OPENCODE_INTEGRITY_NO_CACHE=1 "${integrity_helper}" "${opencode_config}" "${opencode_packages}" "${opencode_cache}"; then
        validation_pass 'Doctor PASS: current OpenCode plugins are structurally loadable (uncached)'
    elif [[ "${EPHEMERAL_STATE}" -eq 0 ]] && \
        "${integrity_helper}" "${opencode_config}" "${opencode_packages}" "${opencode_cache}"; then
        validation_pass 'Doctor PASS: current OpenCode plugins are structurally loadable'
    else
        validation_fail 'Doctor FAIL: current OpenCode plugin integrity check failed'
        status=1
    fi

    printf '\ndevbox configuration summary\n'
    printf '  sandbox: Bubblewrap only\n'
    printf '  Pi state root: %s%s\n' "${PI_AGENT_DIR}" "$([[ "${PI_AGENT_DIR_FROM_ENV}" -eq 1 ]] && printf ' (from PI_CODING_AGENT_DIR)' || printf ' (Pi default)')"
    printf '  target policy: writable by default with critical infrastructure read-only\n'
    printf '  host tools: %s\n' "$([[ "${ALLOW_HOST_TOOLS}" -eq 1 ]] && printf enabled || printf disabled)"
    printf '  AWS: %s\n' "$([[ "${ALLOW_AWS}" -eq 1 ]] && printf enabled || printf disabled)"
    printf '  clipboard: %s\n' "$([[ "${ALLOW_CLIPBOARD}" -eq 1 ]] && printf enabled || printf disabled)"
    printf '  network: %s\n' "$([[ "${SHARE_NETWORK}" -eq 1 ]] && printf shared || printf isolated)"
    printf '  SSH agent forwarding: %s\n' "$([[ "${FORWARD_SSH_AGENT}" -eq 1 ]] && printf enabled || printf disabled)"
    printf '  terminal sockets: %s\n' "$([[ "${ALLOW_TERMINAL_SOCKETS}" -eq 1 ]] && printf enabled || printf disabled)"
    printf '  persistent development state: %s\n' "$([[ "${EPHEMERAL_STATE}" -eq 1 ]] && printf disabled || printf enabled)"
    printf '  GUI access: %s\n' "$([[ "${ALLOW_GUI}" -eq 1 ]] && printf enabled || printf disabled)"
    printf '  Pi resource assurance: read-only mounts plus real-loader validation\n'
    printf '  OpenCode plugin assurance: structural preflight for direct and shell launches\n'

    return "${status}"
}

validation_pass() {
    printf '✅ %s\n' "$1"
}

validation_fail() {
    printf '❌ %s\n' "$1"
}

validation_warn() {
    printf '⚠️  %s\n' "$1"
}

run_devbox_validation() {
    local script_path="$0"
    local script_dir
    local validation_root
    local test_home
    local test_project
    local failed=0
    local output
    local expected_output
    local command_status
    local test_script

    script_dir="$(cd -- "$(dirname -- "$(realpath "${BASH_SOURCE[0]}")")" && pwd -P)"
    validation_root="$(mktemp -d "${TMPDIR:-/tmp}/devbox-validation.XXXXXX")"
    test_home="${validation_root}/home"
    test_project="${validation_root}/project"
    mkdir -p -- \
        "${test_home}/.pi/agent/extensions" \
        "${test_home}/.pi/agent/packages/devbox-validation-package" \
        "${test_home}/.config/opencode" \
        "${test_home}/.aws/sso/cache" \
        "${test_home}/.aws/cli/cache" \
        "${test_project}/.git" \
        "${test_project}/.github"
    printf '%s\n' '{"packages":["./packages/devbox-validation-package"]}' >"${test_home}/.pi/agent/settings.json"
    cat >"${test_home}/.pi/agent/extensions/devbox-validation.ts" <<'DEVBOX_EXTENSION'
export default function (pi: any) {
  pi.registerFlag("devbox-auto-extension-loaded", {
    description: "devbox auto extension loaded",
    type: "boolean",
    default: false,
  });
}
DEVBOX_EXTENSION
    printf '%s\n' '{"name":"devbox-validation-package","pi":{"extensions":["./index.ts"]}}' \
        >"${test_home}/.pi/agent/packages/devbox-validation-package/package.json"
    cat >"${test_home}/.pi/agent/packages/devbox-validation-package/index.ts" <<'DEVBOX_PACKAGE'
export default function (pi: any) {
  pi.registerFlag("devbox-package-extension-loaded", {
    description: "devbox package extension loaded",
    type: "boolean",
    default: false,
  });
}
DEVBOX_PACKAGE
    printf '[default]\nregion=us-east-1\n' >"${test_home}/.aws/config"
    printf '[default]\naws_access_key_id=fixture\n' >"${test_home}/.aws/credentials"

    printf 'devbox validation\n'
    if command -v bwrap >/dev/null 2>&1; then
        validation_pass "Test 0.1 PASS: bwrap found at $(command -v bwrap)"
    else
        validation_fail 'Test 0.1 FAIL: bwrap unavailable'
        failed=$((failed + 1))
    fi

    if check_bwrap_namespace_support; then
        validation_pass 'Test 0.2 PASS: bwrap namespace probe succeeded'

        # shellcheck disable=SC2016 # HOME expands inside the sandboxed shell.
        output="$(env -u SSH_AUTH_SOCK \
            HOME="${test_home}" USER="${USER:-developer}" LOGNAME="${LOGNAME:-${USER:-developer}}" \
            XDG_CONFIG_HOME="${test_home}/.config" XDG_DATA_HOME="${test_home}/.local/share" \
            XDG_STATE_HOME="${test_home}/.local/state" XDG_CACHE_HOME="${test_home}/.cache" \
            PATH="${PATH}" TERM="${TERM:-xterm-256color}" LANG="${LANG:-C.UTF-8}" \
            SCODER_GIT="${SCODER_GIT:-${script_dir}/scoder-git}" \
            DEVBOX_FORCE_PROBE=1 \
            "${script_path}" /bin/bash --noprofile --norc -lc \
            'printf workspace-ok > workspace.txt; cat "$HOME/.aws/config" >/dev/null; printf cache-ok > "$HOME/.aws/cli/cache/devbox"; printf opencode-ok > "$HOME/.config/opencode/devbox"; printf DEVBOX_LIVE_OK' \
            -- "${test_project}" -q --no-host-tools --no-clipboard --no-ssh-agent 2>&1 || true)"
        if [[ "${output}" == 'DEVBOX_LIVE_OK' ]] &&
            [[ "$(<"${test_project}/workspace.txt")" == 'workspace-ok' ]] &&
            [[ "$(<"${test_home}/.aws/cli/cache/devbox")" == 'cache-ok' ]] &&
            [[ "$(<"${test_home}/.config/opencode/devbox")" == 'opencode-ok' ]]; then
            validation_pass 'Test A.1 PASS: command-first execution, target writes, AWS, and OpenCode state work live'
        else
            validation_fail "Test A.1 FAIL: live unified-box behavior failed (${output})"
            failed=$((failed + 1))
        fi

        # shellcheck disable=SC2016 # HOME/AWS_PROFILE expand inside the sandboxed shell.
        output="$(env -u SSH_AUTH_SOCK AWS_PROFILE=fixture \
            HOME="${test_home}" USER="${USER:-developer}" LOGNAME="${LOGNAME:-${USER:-developer}}" \
            XDG_CONFIG_HOME="${test_home}/.config" XDG_DATA_HOME="${test_home}/.local/share" \
            XDG_STATE_HOME="${test_home}/.local/state" XDG_CACHE_HOME="${test_home}/.cache" \
            PATH="${PATH}" TERM="${TERM:-xterm-256color}" LANG="${LANG:-C.UTF-8}" \
            SCODER_GIT="${SCODER_GIT:-${script_dir}/scoder-git}" \
            DEVBOX_FORCE_PROBE=1 \
            "${script_path}" /bin/bash --noprofile --norc -lc \
            'test ! -e "$HOME/.aws" && test -z "${AWS_PROFILE:-}" && printf HARDENED_OK' \
            -- "${test_project}" -q --no-host-tools --no-aws --no-clipboard --no-ssh-agent 2>&1 || true)"
        if [[ "${output}" == 'HARDENED_OK' ]]; then
            validation_pass 'Test A.2 PASS: --no-aws hides AWS files and environment'
        else
            validation_fail "Test A.2 FAIL: --no-aws hardening failed (${output})"
            failed=$((failed + 1))
        fi

        if command -v pi >/dev/null 2>&1; then
            if output="$(env -u PI_CODING_AGENT_DIR -u SSH_AUTH_SOCK \
                HOME="${test_home}" USER="${USER:-developer}" LOGNAME="${LOGNAME:-${USER:-developer}}" \
                XDG_CONFIG_HOME="${test_home}/.config" XDG_DATA_HOME="${test_home}/.local/share" \
                XDG_STATE_HOME="${test_home}/.local/state" XDG_CACHE_HOME="${test_home}/.cache" \
                PATH="${PATH}" TERM="${TERM:-xterm-256color}" LANG="${LANG:-C.UTF-8}" \
                SCODER_GIT="${SCODER_GIT:-${script_dir}/scoder-git}" \
                DEVBOX_FORCE_PROBE=1 \
                "${script_path}" pi --help -- "${test_project}" -q --no-host-tools --no-aws --no-clipboard --no-ssh-agent 2>&1)"; then
                command_status=0
            else
                command_status=$?
            fi
            if [[ "${command_status}" -eq 0 && "${output}" == *--devbox-auto-extension-loaded* && "${output}" == *--devbox-package-extension-loaded* ]]; then
                validation_pass 'Test A.3 PASS: real Pi loads global extensions and settings packages'
            else
                validation_fail "Test A.3 FAIL: real Pi resource loading failed (status=${command_status}; ${output})"
                failed=$((failed + 1))
            fi
        else
            validation_warn 'Test A.3 SKIP: Pi unavailable'
        fi

        if command -v opencode >/dev/null 2>&1; then
            expected_output="$(opencode --version 2>&1)"
            if output="$(env -u SSH_AUTH_SOCK \
                HOME="${test_home}" USER="${USER:-developer}" LOGNAME="${LOGNAME:-${USER:-developer}}" \
                XDG_CONFIG_HOME="${test_home}/.config" XDG_DATA_HOME="${test_home}/.local/share" \
                XDG_STATE_HOME="${test_home}/.local/state" XDG_CACHE_HOME="${test_home}/.cache" \
                PATH="${PATH}" TERM="${TERM:-xterm-256color}" LANG="${LANG:-C.UTF-8}" \
                SCODER_GIT="${SCODER_GIT:-${script_dir}/scoder-git}" \
                DEVBOX_FORCE_PROBE=1 \
                "${script_path}" opencode --version -- "${test_project}" -q --no-aws --no-clipboard --no-ssh-agent 2>&1)"; then
                command_status=0
            else
                command_status=$?
            fi
            if [[ "${command_status}" -eq 0 && -n "${expected_output}" && "${output}" == "${expected_output}" ]]; then
                validation_pass 'Test A.4 PASS: real OpenCode launches and returns its exact host version'
            else
                validation_fail "Test A.4 FAIL: real OpenCode launch failed (status=${command_status}; expected=${expected_output}; actual=${output})"
                failed=$((failed + 1))
            fi
        else
            validation_warn 'Test A.4 SKIP: OpenCode unavailable'
        fi
    else
        validation_fail 'Test 0.2 FAIL: bwrap namespace probe failed'
        failed=$((failed + 1))
    fi

    for test_script in \
        "${script_dir}/test/devbox-live-test" \
        "${script_dir}/test/devbox-live-extended-test" \
        "${script_dir}/test/devbox-static-test" \
        "${script_dir}/test/devbox-cache-test" \
        "${script_dir}/test/devbox-parser-test" \
        "${script_dir}/test/devbox-opencode-integrity-test" \
        "${script_dir}/test/devbox-opencode-preflight-test"; do
        printf '\n--- %s ---\n' "$(basename "${test_script}")"
        if [[ ! -x "${test_script}" ]]; then
            validation_fail "Test X.$(basename "${test_script}") FAIL: test is missing or not executable"
            failed=$((failed + 1))
        elif "${test_script}"; then
            validation_pass "Test X.$(basename "${test_script}") PASS"
        else
            command_status=$?
            validation_fail "Test X.$(basename "${test_script}") FAIL: exited with status ${command_status}"
            failed=$((failed + 1))
        fi
    done

    rm -rf -- "${validation_root}"
    if [[ "${failed}" -eq 0 ]]; then
        printf '🎉 All devbox validation tests passed!\n'
        return 0
    fi
    printf '⚠️  %s devbox validation test(s) failed\n' "${failed}"
    return 1
}

if [[ $# -eq 1 ]]; then
    case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    -V | --version)
        version
        exit 0
        ;;
    esac
fi

